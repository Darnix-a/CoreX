def cmd_fkill(filter_term: Optional[str] = None, dry_run: bool = False):
    """Interactive process manager via fzf showing PID, User, CPU%, MEM%, and Command."""
    ret, out, _ = run_cmd(
        ["ps", "-eo", "pid,user,%cpu,%mem,stat,comm", "--sort=-%cpu"],
        capture_output=True,
    )
    if ret != 0:
        log_error("Failed to query running processes.")
        return

    raw_lines = out.strip().splitlines()
    if len(raw_lines) <= 1:
        return

    body_lines = raw_lines[1:]

    items = []
    for line in body_lines:
        parts = line.split(None, 5)
        if len(parts) >= 6:
            pid, user, cpu, mem, stat, comm = parts
            if filter_term and filter_term.lower() not in comm.lower():
                continue
            items.append(f"{pid:<8}\t{user:<10}\t{cpu:<6}%\t{mem:<6}%\t{stat:<5}\t{comm}")

    if not sys.stdin.isatty() or dry_run:
        print(f"{Style.BOLD}{'PID':<8} {'USER':<10} {'CPU':<7} {'MEM':<7} {'STAT':<5} {'COMMAND'}{Style.RESET}")
        print("─" * 65)
        for it in items[:25]:
            p = it.split("\t")
            print(f"{p[0]} {p[1]} {p[2]} {p[3]} {p[4]} {p[5]}")
        return

    preview = "cat /proc/{1}/status 2>/dev/null | grep -E 'Name|State|VmSize|VmRSS|Threads' || echo 'Process terminated'"
    extra = [
        "--delimiter=\t",
        "--header=ENTER: SIGTERM (-15) | CTRL-X: SIGKILL (-9) | CTRL-H: SIGHUP (-1) | TAB: Multi-select",
        "--bind=ctrl-x:execute(kill -9 {+1} 2>/dev/null)+reload(ps -eo pid,user,%cpu,%mem,stat,comm --sort=-%cpu | tail -n +2 | awk '{printf \"%-8s\\t%-10s\\t%-6s%%\\t%-6s%%\\t%-5s\\t%s\\n\", $1,$2,$3,$4,$5,$6}')",
        "--bind=ctrl-h:execute(kill -1 {+1} 2>/dev/null)",
    ]
    if filter_term:
        extra.extend(["--query", filter_term])

    selected = run_fzf(
        items,
        prompt="cx kill > ",
        preview_cmd=preview,
        multi=True,
        extra_args=extra,
    )
    if not selected:
        return

    pids_to_kill = [s.split("\t")[0].strip() for s in selected]
    log_warn(f"Sending SIGTERM to PIDs: {', '.join(pids_to_kill)}")
    for pid in pids_to_kill:
        run_cmd(["kill", "-15", pid], dry_run=dry_run)
    log_success("SIGTERM signals dispatched.")


def cmd_vram(dry_run: bool = False):
    """Real-time visual breakdown of Nvidia VRAM usage, identifying rogue zombie processes."""
    if not check_tool("nvidia-smi"):
        log_error("'nvidia-smi' is not installed or no NVIDIA GPU detected.")
        return

    # Query general GPU status
    ret, out, _ = run_cmd(
        ["nvidia-smi", "--query-gpu=gpu_name,driver_version,temperature.gpu,memory.total,memory.used,memory.free,power.draw", "--format=csv,noheader,nounits"],
        capture_output=True,
    )
    if ret != 0 or not out.strip():
        log_error("Could not query GPU metrics from nvidia-smi.")
        return

    gpu_line = out.strip().splitlines()[0]
    g_name, driver, temp, total, used, free, power = [x.strip() for x in gpu_line.split(",")]
    total_mb = int(total)
    used_mb = int(used)
    free_mb = int(free)
    pct = (used_mb / total_mb) * 100 if total_mb > 0 else 0

    print_banner(dry_run)
    print(box_header("NVIDIA GPU & VRAM METRICS"))
    print(f" {Style.BOLD}Device:{Style.RESET}       {g_name} (Driver {driver})")
    print(f" {Style.BOLD}Temp/Power:{Style.RESET}   {temp}°C | {power} W")
    
    bar_width = 32
    filled = int((pct / 100) * bar_width)
    bar_color = Style.GREEN if pct < 60 else (Style.YELLOW if pct < 85 else Style.RED)
    bar = f"{bar_color}{'█' * filled}{Style.DARK_GRAY}{'░' * (bar_width - filled)}{Style.RESET}"
    print(f" {Style.BOLD}VRAM Usage:{Style.RESET}   [{bar}] {pct:.1f}% ({used_mb} MiB / {total_mb} MiB)")
    print(box_footer())

    # Query Compute / Graphics processes occupying VRAM
    ret2, out2, _ = run_cmd(
        ["nvidia-smi", "--query-compute-apps=pid,process_name,used_memory", "--format=csv,noheader,nounits"],
        capture_output=True,
    )
    
    proc_lines = [l.strip() for l in out2.strip().splitlines() if l.strip()] if ret2 == 0 else []

    if not proc_lines:
        log_success("No active compute processes occupying GPU memory buffers.")
        return

    parsed_procs = []
    fzf_items = []
    for line in proc_lines:
        parts = [p.strip() for p in line.split(",")]
        pid = parts[0]
        raw_pname = parts[1] if len(parts) > 1 else "unknown"
        clean_pname = Path(raw_pname.split()[0]).name if raw_pname else "unknown"
        vram_used = parts[2] if len(parts) > 2 else "0"

        is_zombie = False
        proc_status_path = Path(f"/proc/{pid}/status")
        cmdline = ""
        if not proc_status_path.exists():
            is_zombie = True
        else:
            try:
                status_txt = proc_status_path.read_text()
                if "State:\tZ" in status_txt:
                    is_zombie = True
                cmdline = Path(f"/proc/{pid}/cmdline").read_text().replace("\0", " ").strip()
            except Exception:
                is_zombie = True

        status_tag = f"{Style.RED}{Style.BOLD}[ZOMBIE/ORPHAN]{Style.RESET}" if is_zombie else f"{Style.GREEN}[ACTIVE]{Style.RESET}"
        parsed_procs.append({
            "pid": pid,
            "status_badge": status_tag,
            "vram": vram_used,
            "name": clean_pname,
            "cmdline": cmdline,
            "is_zombie": is_zombie,
        })
        fzf_items.append(f"{pid:<8}\t{status_tag}\t{vram_used:>6} MiB\t{clean_pname}")

    # Print clean table
    print(f"\n {Style.BOLD}{'PID':<8} {'STATUS':<20} {'VRAM':<12} {'PROCESS':<20} {'COMMAND'}{Style.RESET}")
    print(f" {Style.DARK_GRAY}{'─' * 75}{Style.RESET}")
    for p in parsed_procs:
        cmd_snippet = p["cmdline"][:30] + ("..." if len(p["cmdline"]) > 30 else "")
        print(f" {p['pid']:<8} {p['status_badge']:<29} {p['vram']:>6} MiB   {p['name']:<20} {Style.GRAY}{cmd_snippet}{Style.RESET}")
    print()

    # If non-interactive or dry-run, stop here cleanly
    if not sys.stdin.isatty() or dry_run:
        return

    preview = "cat /proc/{1}/cmdline 2>/dev/null | tr '\\0' ' ' || echo 'Process unreachable in /proc'"
    extra = [
        "--delimiter=\t",
        "--header=SELECT TO KILL | ENTER / CTRL-X: Force Kill (-9) | TAB: Multi-select | ESC: Exit",
    ]

    selected = run_fzf(
        fzf_items,
        prompt="cx vram-kill > ",
        preview_cmd=preview,
        multi=True,
        extra_args=extra,
    )
    if not selected:
        return

    pids_to_kill = [s.split("\t")[0].strip() for s in selected]
    log_warn(f"Force-killing GPU memory hog process(es): {', '.join(pids_to_kill)}")
    for pid in pids_to_kill:
        run_cmd(["kill", "-9", pid], dry_run=dry_run)
    log_success("Kill signals sent.")


def cmd_snapshot(cfg: CoreXConfig, label: Optional[str] = None, dry_run: bool = False):
    """One-command BTRFS / Snapper system snapshot helper with customizable label tags."""
    has_snapper = check_tool("snapper")
    has_btrfs = check_tool("btrfs")

    if not has_snapper and not has_btrfs:
        log_error("Neither 'snapper' nor 'btrfs-progs' found on this system.")
        return

    timestamp = datetime.datetime.now().strftime("%Y-%m-%d_%H%M%S")
    snap_label = label or f"corex_{timestamp}"

    # Determine backend
    backend = cfg.snapshot_backend
    if backend == "auto":
        backend = "snapper" if has_snapper else "btrfs"

    if backend == "snapper":
        log_info(f"Creating Snapper snapshot (config: '{cfg.snapper_config}', description: '{snap_label}')...")
        snap_cmd = ["sudo", "snapper", "-c", cfg.snapper_config, "create", "-d", snap_label, "-t", "single"]
        ret, _, err = run_cmd(snap_cmd, dry_run=dry_run)
        if ret == 0:
            log_success(f"Snapper snapshot created: {snap_label}")
            if not dry_run and sys.stdin.isatty():
                run_cmd(["snapper", "-c", cfg.snapper_config, "list"])
        else:
            log_error(f"Snapper snapshot failed: {err}")
    else:
        dest_dir = Path(cfg.btrfs_mount) / ".snapshots"
        dest_path = dest_dir / f"{timestamp}_{snap_label}"
        log_info(f"Creating read-only BTRFS snapshot of {cfg.btrfs_mount} at {dest_path}...")
        snap_cmd = ["sudo", "btrfs", "subvolume", "snapshot", "-r", cfg.btrfs_mount, str(dest_path)]
        ret, _, err = run_cmd(snap_cmd, dry_run=dry_run)
        if ret == 0:
            log_success(f"BTRFS snapshot created: {dest_path}")
        else:
            log_error(f"BTRFS snapshot failed: {err}")


