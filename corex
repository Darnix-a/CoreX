def _resolve_bg_unit_name(target: str) -> str:
    """Normalize input into a full corex-*.service unit name."""
    t = target.strip()
    if not t.endswith(".service"):
        t = f"{t}.service"
    if not t.startswith("corex-"):
        t = f"corex-{t}"
    return t


def _get_corex_bg_units() -> List[Dict[str, Any]]:
    """Scan and retrieve all transient and persistent CoreX background units."""
    if not shutil.which("systemctl"):
        return []
    res = subprocess.run(
        ["systemctl", "--user", "list-units", "corex-*", "--all", "--no-legend", "--plain", "-l"],
        capture_output=True, text=True
    )
    units = []
    seen = set()
    for line in res.stdout.splitlines():
        if not line.strip():
            continue
        parts = line.split(None, 4)
        if len(parts) >= 4:
            uname = parts[0]
            if uname in seen:
                continue
            seen.add(uname)
            load_st = parts[1]
            act_st = parts[2]
            sub_st = parts[3]
            desc = parts[4] if len(parts) > 4 else ""
            units.append({
                "unit": uname,
                "load": load_st,
                "active": act_st,
                "sub": sub_st,
                "description": desc,
            })
    return units


def render_bg_preview(unit_name: str):
    """Render comprehensive live preview card for a background service in fzf."""
    uname = _resolve_bg_unit_name(unit_name)
    show_res = subprocess.run(
        ["systemctl", "--user", "show", uname, "--property=Id,ActiveState,SubState,MainPID,MemoryCurrent,CPUUsageNSec,ActiveEnterTimestamp,Description"],
        capture_output=True, text=True
    )
    props = dict(l.split("=", 1) for l in show_res.stdout.splitlines() if "=" in l)
    if not props.get("Id") or (props.get("ActiveState") == "inactive" and not props.get("SubState")):
        print(box_header("BACKGROUND UNIT PREVIEW"))
        print(f"  {Style.YELLOW}Unit '{uname}' not found or no telemetry available.{Style.RESET}")
        print(box_footer())
        return

    active_st = props.get("ActiveState", "unknown")
    sub_st = props.get("SubState", "unknown")
    pid = props.get("MainPID", "0")
    if active_st == "active":
        badge = f"{Style.GREEN}{Style.BOLD}● ACTIVE ({sub_st}){Style.RESET}"
    elif active_st == "failed":
        badge = f"{Style.RED}{Style.BOLD}× FAILED ({sub_st}){Style.RESET}"
    else:
        badge = f"{Style.YELLOW}○ {active_st.upper()} ({sub_st}){Style.RESET}"

    mem_raw = props.get("MemoryCurrent", "")
    mem_disp = "N/A"
    if mem_raw.isdigit() and int(mem_raw) < 18446744073709551615:
        b = int(mem_raw)
        if b >= 1024**3:
            mem_disp = f"{b / (1024**3):.2f} GB"
        elif b >= 1024**2:
            mem_disp = f"{b / (1024**2):.1f} MB"
        elif b >= 1024:
            mem_disp = f"{b / 1024:.0f} KB"
        else:
            mem_disp = f"{b} B"

    cpu_raw = props.get("CPUUsageNSec", "")
    cpu_disp = "N/A"
    if cpu_raw.isdigit():
        sec = int(cpu_raw) / 1e9
        if sec >= 60:
            cpu_disp = f"{int(sec // 60)}m {sec % 60:.1f}s"
        elif sec >= 1:
            cpu_disp = f"{sec:.2f}s"
        else:
            cpu_disp = f"{sec * 1000:.1f}ms"

    started = props.get("ActiveEnterTimestamp", "N/A")
    desc = props.get("Description", "")
    if desc.startswith("[systemd-run] "):
        desc = desc[14:]

    print(box_header(f"BACKGROUND UNIT: {uname}"))
    print(f"  • {Style.BOLD}Service Unit:{Style.RESET}    {Style.WHITE}{Style.BOLD}{uname}{Style.RESET}")
    print(f"  • {Style.BOLD}Unit Status:{Style.RESET}     {badge}")
    print(f"  • {Style.BOLD}Process ID:{Style.RESET}      {Style.CYAN}{pid}{Style.RESET}")
    print(f"  • {Style.BOLD}Memory Footprint:{Style.RESET} {Style.GREEN}{mem_disp}{Style.RESET}")
    print(f"  • {Style.BOLD}CPU Consumed:{Style.RESET}     {Style.YELLOW}{cpu_disp}{Style.RESET}")
    print(f"  • {Style.BOLD}Active Since:{Style.RESET}     {started}")
    if desc:
        print(f"  • {Style.BOLD}Command Exec:{Style.RESET}     {Style.GRAY}{desc[:120]}{Style.RESET}")

    # Tail recent journal lines
    log_res = subprocess.run(
        ["journalctl", "--user", "-u", uname, "-n", "8", "--no-pager"],
        capture_output=True, text=True
    )
    lines = [l for l in log_res.stdout.splitlines() if l.strip()]
    if lines:
        print(f"\n  {Style.BOLD}RECENT JOURNAL LOGS:{Style.RESET}")
        for l in lines[-8:]:
            disp_l = l if len(l) < 140 else l[:137] + "..."
            print(f"   {Style.DARK_GRAY}│{Style.RESET} {disp_l}")

    print(f"\n  {Style.DARK_GRAY}Hotkeys: [^L] Tail Logs  [^S] Status  [^R] Restart  [^X] Stop{Style.RESET}")
    print(box_footer())


def builtin_bg(extra_args: Optional[List[str]] = None):
    """First-class interactive background service manager and CLI controller."""
    args = extra_args or []

    if not shutil.which("systemctl"):
        log_error("systemctl is required for managing background units.")
        return

    # Help flag
    if args and args[0] in ("-h", "--help", "help"):
        print(box_header("COREX BACKGROUND DAEMON & UNIT MANAGER"))
        print(f"""
 {Style.BOLD}USAGE:{Style.RESET}
   cx bg                           Launch interactive background unit cockpit
   cx bg run <file.kr> [args...]   Run an embedded Kiro script in the background
   cx bg list, ls                  List active background services in clean table
   cx bg logs, log <unit>          Tail live journalctl logs for background unit
   cx bg status, info <unit>       Inspect detailed systemd status & resource usage
   cx bg restart <unit>            Restart background unit
   cx bg stop, kill <unit>         Stop background unit
   cx --bg <command> [args...]     Run any command detached in background
""")
        print(box_footer())
        return

    # CLI subcommands: logs
    if args and args[0] in ("logs", "log", "-f"):
        if len(args) < 2:
            units = _get_corex_bg_units()
            if not units:
                log_warn("No active background units to view logs for.")
                return
            target_unit = units[0]["unit"]
        else:
            target_unit = _resolve_bg_unit_name(args[1])
        log_info(f"Tailing live journal logs for {target_unit} (Press Ctrl+C to exit)...")
        try:
            subprocess.run(["journalctl", "--user", "-u", target_unit, "-f"])
        except KeyboardInterrupt:
            pass
        return

    # CLI subcommands: status / info
    if args and args[0] in ("status", "info"):
        if len(args) < 2:
            units = _get_corex_bg_units()
            if not units:
                log_warn("No active background units found.")
                return
            target_unit = units[0]["unit"]
        else:
            target_unit = _resolve_bg_unit_name(args[1])
        subprocess.run(["systemctl", "--user", "status", target_unit])
        return

    # CLI subcommands: restart
    if args and args[0] in ("restart", "reboot"):
        if len(args) < 2:
            log_error("Usage: cx bg restart <unit>")
            return
        target_unit = _resolve_bg_unit_name(args[1])
        res = subprocess.run(["systemctl", "--user", "restart", target_unit])
        if res.returncode == 0:
            log_success(f"Restarted background unit: {target_unit}")
        else:
            log_error(f"Failed to restart unit: {target_unit}")
        return

    # CLI subcommands: stop / kill
    if args and args[0] in ("stop", "kill", "down"):
        if len(args) < 2:
            log_error("Usage: cx bg stop <unit>")
            return
        target_unit = _resolve_bg_unit_name(args[1])
        res = subprocess.run(["systemctl", "--user", "stop", target_unit])
        if res.returncode == 0:
            subprocess.run(["systemctl", "--user", "reset-failed", target_unit], capture_output=True)
            log_success(f"Stopped background unit: {target_unit}")
        else:
            log_error(f"Failed to stop unit: {target_unit}")
        return

    # CLI subcommands: list / ls
    if args and args[0] in ("list", "ls"):
        units = _get_corex_bg_units()
        print(box_header("ACTIVE BACKGROUND SERVICES"))
        if not units:
            print(f"  {Style.GRAY}No active background units found (corex-*.service).{Style.RESET}")
            print(f"  {Style.DARK_GRAY}Tip: Run any command with '--bg' to detach it (e.g. 'cx --bg serve-dir'){Style.RESET}")
            print(box_footer())
            return

        print(f" {'UNIT':<34} {'STATUS':<12} {'PID':<8} {'MEMORY':<10} {'CPU':<10} {'ACTIVE SINCE'}")
        print(f" {Style.DARK_GRAY}{'─' * 88}{Style.RESET}")
        for u in units:
            uname = u["unit"]
            show_res = subprocess.run(
                ["systemctl", "--user", "show", uname, "--property=ActiveState,SubState,MainPID,MemoryCurrent,CPUUsageNSec,ActiveEnterTimestamp"],
                capture_output=True, text=True
            )
            props = dict(l.split("=", 1) for l in show_res.stdout.splitlines() if "=" in l)
            pid = props.get("MainPID", "-")
            mem_raw = props.get("MemoryCurrent", "")
            mem_disp = "-"
            if mem_raw.isdigit() and int(mem_raw) < 18446744073709551615:
                b = int(mem_raw)
                mem_disp = f"{b / (1024**2):.1f} MB" if b >= 1024**2 else f"{b / 1024:.0f} KB"
            cpu_raw = props.get("CPUUsageNSec", "")
            cpu_disp = "-"
            if cpu_raw.isdigit():
                sec = int(cpu_raw) / 1e9
                cpu_disp = f"{sec:.1f}s" if sec >= 1 else f"{sec * 1000:.0f}ms"
            started = props.get("ActiveEnterTimestamp", "")
            time_part = started.split()[1] if len(started.split()) > 1 else started
            st_col = Style.GREEN if u["active"] == "active" else (Style.RED if u["active"] == "failed" else Style.YELLOW)
            status_str = f"{st_col}{u['sub']}{Style.RESET}"
            print(f" {uname[:33]:<34} {status_str:<21} {pid:<8} {mem_disp:<10} {cpu_disp:<10} {time_part}")
        print(box_footer())
        return

    # Interactive Cockpit
    units = _get_corex_bg_units()
    if not units:
        print(box_header("COREX BACKGROUND DAEMON & UNIT MANAGER"))
        print(f"  {Style.GRAY}No active background units found (corex-*.service).{Style.RESET}\n")
        print(f"  {Style.DARK_GRAY}To detach any command into background execution:{Style.RESET}")
        print(f"    ❯ {Style.WHITE}cx --bg <command> [args...]{Style.RESET}")
        print(f"    Example: {Style.CYAN}cx --bg serve-dir{Style.RESET} or {Style.CYAN}cx --bg comfy-boot{Style.RESET}\n")
        print(box_footer())
        return

    # Check for fzf
    if not shutil.which("fzf") or not sys.stdin.isatty():
        builtin_bg(["list"])
        return

    self_exe = os.path.abspath(sys.argv[0])
    fzf_lines = []
    for u in units:
        uname = u["unit"]
        show_res = subprocess.run(
            ["systemctl", "--user", "show", uname, "--property=ActiveState,SubState,MainPID,MemoryCurrent,CPUUsageNSec,ActiveEnterTimestamp,Description"],
            capture_output=True, text=True
        )
        props = dict(l.split("=", 1) for l in show_res.stdout.splitlines() if "=" in l)
        pid = props.get("MainPID", "-")
        mem_raw = props.get("MemoryCurrent", "")
        mem_disp = "-"
        if mem_raw.isdigit() and int(mem_raw) < 18446744073709551615:
            b = int(mem_raw)
            mem_disp = f"{b / (1024**2):.1f} MB" if b >= 1024**2 else f"{b / 1024:.0f} KB"
        cpu_raw = props.get("CPUUsageNSec", "")
        cpu_disp = "-"
        if cpu_raw.isdigit():
            sec = int(cpu_raw) / 1e9
            cpu_disp = f"{sec:.1f}s" if sec >= 1 else f"{sec * 1000:.0f}ms"
        started = props.get("ActiveEnterTimestamp", "")
        time_part = started.split()[1] if len(started.split()) > 1 else started
        desc = props.get("Description", "")
        if desc.startswith("[systemd-run] "):
            desc = desc[14:]
        fzf_lines.append(f"{uname}\t{u['sub']}\t{pid}\t{mem_disp}\t{cpu_disp}\t{time_part}\t{desc}")

    fzf_input = "\n".join(fzf_lines)
    preview_cmd = f"python3 '{self_exe}' __preview_bg {{1}}"
    fzf_cmd = [
        "fzf",
        "--delimiter=\t",
        "--with-nth=1,2,3,4,5,6",
        "--prompt=  ◈ Select Background Unit ❯ ",
        "--header= [Enter] Actions  │  [^L] Logs  │  [^S] Status  │  [^R] Restart  │  [^X] Stop  │  [ESC] Exit ",
        "--header-label= COREX BACKGROUND SERVICES ",
        "--header-label-pos=3",
        "--border=rounded",
        "--border-label= CoreX Daemon Studio ",
        "--border-label-pos=3",
        "--preview", preview_cmd,
        "--preview-window=right:50%:border-rounded:wrap",
        f"--bind=ctrl-l:execute(journalctl --user -u {{1}} -n 100 -f)",
        f"--bind=ctrl-s:execute(systemctl --user status {{1}})",
        f"--bind=ctrl-r:execute-silent(systemctl --user restart {{1}})",
        f"--bind=ctrl-x:execute-silent(systemctl --user stop {{1}})",
        "--height=85%",
    ]
    try:
        proc = subprocess.Popen(fzf_cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
        out, _ = proc.communicate(input=fzf_input)
        if proc.returncode != 0 or not out.strip():
            return
        selected_parts = out.strip().split("\t")
        selected_unit = selected_parts[0]

        print(f"\n {Style.BOLD}Background Unit Selected:{Style.RESET} {Style.CYAN}{selected_unit}{Style.RESET}")
        print(f"  [1] Tail Live Logs (journalctl --user -u {selected_unit} -f)")
        print(f"  [2] Inspect Full Systemd Status & Resource Usage")
        print(f"  [3] Restart Unit")
        print(f"  [4] Stop Unit")
        print(f"  [Q] Exit")
        ans = input(f" Select action [1-4, Q]: ").strip().lower()
        if ans == "1":
            builtin_bg(["logs", selected_unit])
        elif ans == "2":
            builtin_bg(["status", selected_unit])
        elif ans == "3":
            builtin_bg(["restart", selected_unit])
        elif ans == "4":
            builtin_bg(["stop", selected_unit])
    except KeyboardInterrupt:
        pass


