@dataclasses.dataclass
class CommandSpec:
    id: str
    category: str
    description: str
    command: str
    preview_cmd: str = ""
    requires_sudo: bool = False
    confirm: bool = False
    deps: List[str] = dataclasses.field(default_factory=list)


@dataclasses.dataclass
class CoreXConfig:
    editor: str = ""
    notes_dir: Path = NOTES_DIR
    todo_file: Path = TODO_FILE
    color: bool = True
    comfyui_path: Path = Path.home() / "ComfyUI"
    comfyui_venv: str = "venv"
    comfyui_port: int = 8188
    comfyui_host: str = "127.0.0.1"
    vram_high_threshold_mb: int = 8192
    vram_low_threshold_mb: int = 4096
    comfyui_extra_flags: List[str] = dataclasses.field(default_factory=lambda: ["--preview-method", "auto"])
    comfyui_auto_browser: bool = True
    comfyui_notify: bool = True
    ollama_url: str = "http://127.0.0.1:11434"
    commands: Dict[str, CommandSpec] = dataclasses.field(default_factory=dict)


def load_config(custom_path: Optional[Path] = None) -> CoreXConfig:
    path = custom_path or CONFIG_FILE
    if not path.exists():
        if DEFAULT_CONFIG_TEMPLATE.exists():
            path.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy(DEFAULT_CONFIG_TEMPLATE, path)
        else:
            return CoreXConfig()

    cfg = CoreXConfig()
    try:
        with open(path, "rb") as f:
            data = tomllib.load(f)

        gen = data.get("general", {})
        cfg.editor = gen.get("editor", "")
        cfg.notes_dir = Path(os.path.expanduser(gen.get("notes_dir", str(NOTES_DIR))))
        cfg.todo_file = Path(os.path.expanduser(gen.get("todo_file", str(TODO_FILE))))
        cfg.color = gen.get("color", True)

        ai = data.get("ai", {})
        cfg.comfyui_path = Path(os.path.expanduser(ai.get("comfyui_path", "~/ComfyUI")))
        cfg.comfyui_venv = ai.get("comfyui_venv", "venv")
        cfg.comfyui_port = int(ai.get("comfyui_port", 8188))
        cfg.comfyui_host = str(ai.get("comfyui_host", "127.0.0.1"))
        cfg.vram_high_threshold_mb = int(ai.get("vram_high_threshold_mb", 8192))
        cfg.vram_low_threshold_mb = int(ai.get("vram_low_threshold_mb", 4096))
        cfg.comfyui_extra_flags = ai.get("comfyui_extra_flags", ["--preview-method", "auto"])
        cfg.comfyui_auto_browser = ai.get("comfyui_auto_browser", True)
        cfg.comfyui_notify = ai.get("comfyui_notify", True)
        cfg.ollama_url = ai.get("ollama_url", "http://127.0.0.1:11434")

        raw_cmds = data.get("commands", {})
        if not raw_cmds and DEFAULT_CONFIG_TEMPLATE.exists() and path != DEFAULT_CONFIG_TEMPLATE:
            try:
                with open(DEFAULT_CONFIG_TEMPLATE, "rb") as df:
                    default_data = tomllib.load(df)
                    raw_cmds = default_data.get("commands", {})
            except Exception:
                pass

        for cid, cdef in raw_cmds.items():
            cfg.commands[cid] = CommandSpec(
                id=cid,
                category=cdef.get("category", "General"),
                description=cdef.get("description", ""),
                command=cdef.get("command", ""),
                preview_cmd=cdef.get("preview_cmd", ""),
                requires_sudo=bool(cdef.get("requires_sudo", False)),
                confirm=bool(cdef.get("confirm", False)),
                deps=list(cdef.get("deps", [])),
            )
    except Exception as e:
        log_warn(f"Config parse warning ({path}): {e}")

    return cfg


def get_default_editor(cfg: CoreXConfig) -> str:
    if cfg.editor and shutil.which(cfg.editor):
        return cfg.editor
    env_ed = os.environ.get("EDITOR") or os.environ.get("VISUAL")
    if env_ed and shutil.which(env_ed):
        return env_ed
    for c in ["nvim", "micro", "helix", "nano", "vi"]:
        if shutil.which(c):
            return c
    return "nano"


# ---------------------------------------------------------------------------
# FZF Helper
# ---------------------------------------------------------------------------
def run_fzf(
    items: List[str],
    prompt: str = "cx > ",
    preview_cmd: Optional[str] = None,
    multi: bool = False,
    header: Optional[str] = None,
    preview_window: str = "right:55%:border-left:wrap",
    extra_args: Optional[List[str]] = None,
) -> List[str]:
    if not shutil.which("fzf"):
        log_error("'fzf' is required for interactive navigation. Run: sudo pacman -S fzf")
        return []

    if not sys.stdin.isatty() or not sys.stdout.isatty():
        return [items[0]] if items else []

    fzf_args = [
        "fzf",
        "--ansi",
        f"--prompt={prompt}",
        "--height=85%",
        "--layout=reverse",
        "--border=rounded",
        "--color=bg+:#1e1e2e,bg:#181825,spinner:#f5e0dc,hl:#f38ba8",
        "--color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc",
        "--color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8",
    ]

    if multi:
        fzf_args.append("--multi")
    if header:
        fzf_args.extend(["--header", header])
    if preview_cmd:
        fzf_args.extend(["--preview", preview_cmd, f"--preview-window={preview_window}"])
    if extra_args:
        fzf_args.extend(extra_args)

    try:
        proc = subprocess.Popen(
            fzf_args,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
        stdout, _ = proc.communicate(input="\n".join(items))
        if proc.returncode != 0:
            return []
        return [line.strip() for line in stdout.strip().split("\n") if line.strip()]
    except KeyboardInterrupt:
        return []


