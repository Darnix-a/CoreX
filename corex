class Style:
    RESET = "\033[0m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    ITALIC = "\033[3m"
    UNDERLINE = "\033[4m"

    RED = "\033[38;5;196m"
    GREEN = "\033[38;5;46m"
    YELLOW = "\033[38;5;220m"
    BLUE = "\033[38;5;39m"
    MAGENTA = "\033[38;5;201m"
    CYAN = "\033[38;5;51m"
    WHITE = "\033[38;5;231m"
    GRAY = "\033[38;5;244m"
    DARK_GRAY = "\033[38;5;238m"
    ORANGE = "\033[38;5;208m"
    PURPLE = "\033[38;5;141m"
    TEAL = "\033[38;5;44m"

    BG_DARK = "\033[48;5;235m"
    BG_BLUE = "\033[48;5;24m"
    BG_RED = "\033[48;5;52m"
    BG_GREEN = "\033[48;5;22m"

    @classmethod
    def strip(cls, text: str) -> str:
        return re.sub(r"\033\[[0-9;]*m", "", text)


