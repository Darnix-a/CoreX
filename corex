def load_custom_radio_stations() -> List[Dict[str, str]]:
    """Loads optional user-defined radio stations from ~/.config/corex/config.toml under [radio.stations]."""
    if not CONFIG_FILE.exists():
        return []
    try:
        import tomllib
        with open(CONFIG_FILE, "rb") as f:
            data = tomllib.load(f)
        custom = data.get("radio", {}).get("stations", [])
        res = []
        for s in custom:
            if isinstance(s, dict) and "name" in s and "url" in s:
                res.append({
                    "name": str(s.get("name", "Custom Station")),
                    "category": str(s.get("category", "Custom")),
                    "genre": str(s.get("genre", "Custom Stream")),
                    "url": str(s["url"]),
                    "desc": str(s.get("desc", "User-configured radio stream")),
                })
        return res
    except Exception:
        return []


RADIO_SOCK = "/tmp/corex-radio.sock"
RADIO_CACHE_FILE = "/tmp/corex_radio_cache.json"


def get_station_stream_title(url: str, timeout: float = 0.9) -> str:
    """Probes the live ICY metadata stream title for an Icecast/Shoutcast radio station with caching."""
    # 1. If currently playing locally via mpv IPC socket, query it instantly (0ms)
    if os.path.exists(RADIO_SOCK):
        try:
            info = get_now_playing()
            if info and info.get("source") == "CoreX Radio Stream":
                cur_raw = info.get("raw", "")
                if cur_raw:
                    return cur_raw
        except Exception:
            pass

    # 2. Check disk cache (valid for 60 seconds)
    cache: Dict[str, Any] = {}
    if os.path.exists(RADIO_CACHE_FILE):
        try:
            with open(RADIO_CACHE_FILE, "r", encoding="utf-8") as f:
                cache = json.load(f)
        except Exception:
            cache = {}
    now = time.time()
    if url in cache and (now - cache[url].get("ts", 0)) < 60:
        return cache[url].get("title", "")

    # 3. Fast probe ICY metadata via HTTP headers
    title = None
    try:
        req = urllib.request.Request(
            url,
            headers={
                "Icy-MetaData": "1",
                "User-Agent": "CoreX/3.0 (Linux; +https://github.com/Darnix-a/CoreX)",
            },
        )
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            metaint = int(resp.headers.get("icy-metaint", 0))
            if metaint > 0:
                resp.read(metaint)
                b = resp.read(1)
                if b:
                    meta_len = ord(b) * 16
                    if meta_len > 0:
                        raw = resp.read(meta_len).decode("utf-8", errors="replace")
                        m = re.search(r"StreamTitle='([^']*)'", raw)
                        if m and m.group(1).strip():
                            title = m.group(1).strip()
    except Exception:
        pass

    if not title:
        title = "Live Broadcast Stream"

    cache[url] = {"title": title, "ts": now}
    try:
        with open(RADIO_CACHE_FILE, "w", encoding="utf-8") as f:
            json.dump(cache, f)
    except Exception:
        pass

    return title


