def builtin_now_playing(extra_args: Optional[List[str]] = None):
    """Inspects currently playing song from CoreX Radio stream, Spotify, browser or playerctl."""
    args = extra_args or []
    short_mode = "--short" in args or "-s" in args
    notify_mode = "--notify" in args or "-n" in args
    follow_mode = "--follow" in args or "-f" in args
    no_copy = "--no-copy" in args

    if follow_mode:
        print(f"{Style.CYAN}📡 Monitoring track changes live (Press Ctrl+C to quit)...{Style.RESET}\n")
        last_track = None
        try:
            while True:
                info = get_now_playing()
                if info:
                    cur = info["raw"]
                    if cur != last_track:
                        last_track = cur
                        status_sym = f"{Style.GREEN}▶{Style.RESET}" if info["status"] == "Playing" else f"{Style.YELLOW}⏸{Style.RESET}"
                        print(f" {status_sym} {Style.BOLD}{cur}{Style.RESET} {Style.DARK_GRAY}[{info['source']}]{Style.RESET}")
                        if notify_mode and shutil.which("notify-send"):
                            subprocess.run(["notify-send", "-a", "CoreX", "-i", "audio-headphones", "Now Playing", cur])
                time.sleep(2.0)
        except KeyboardInterrupt:
            print("\nExited track monitor.")
            return

    info = get_now_playing()
    if not info:
        if short_mode:
            print("No media playing")
        else:
            log_warn("No active media streams detected (checked CoreX Radio, Spotify, Firefox, MPV, playerctl).")
            print(f"  {Style.GRAY}Tip: Run {Style.BOLD}cx stream-radio{Style.RESET}{Style.GRAY} to tune into 48+ commercial-free streams!{Style.RESET}\n")
        return

    track_str = info["raw"]

    if short_mode:
        print(f"🎵 {track_str}")
        return

    status_color = Style.GREEN if info["status"] == "Playing" else Style.YELLOW
    status_sym = "● Playing" if info["status"] == "Playing" else "⏸ Paused"

    print(f"\n{box_header('CURRENTLY PLAYING SONG', color=Style.CYAN)}")
    if info["title"]:
        print(f"  • {Style.BOLD}Track Title:{Style.RESET}    {Style.BOLD}{info['title']}{Style.RESET}")
    if info["artist"]:
        print(f"  • {Style.BOLD}Artist:{Style.RESET}         {info['artist']}")
    if info["album"]:
        label = "Station:" if "Radio" in info["source"] else "Album:"
        print(f"  • {Style.BOLD}{label:<14}{Style.RESET} {info['album']}")
    if info["genre"]:
        print(f"  • {Style.BOLD}Genre:{Style.RESET}          {info['genre']}")
    if info["bitrate"]:
        print(f"  • {Style.BOLD}Bitrate:{Style.RESET}        {info['bitrate']}")
    print(f"  • {Style.BOLD}Playback:{Style.RESET}       {status_color}{status_sym}{Style.RESET} via {info['source']}")
    print(box_footer(color=Style.CYAN))

    if not no_copy:
        copied = copy_to_clipboard(track_str)
        if copied:
            log_success(f"Track copied to clipboard: '{track_str}'")

    if notify_mode and shutil.which("notify-send"):
        subprocess.run(["notify-send", "-a", "CoreX", "-i", "audio-headphones", "Now Playing", track_str])


def builtin_rip_audio(fmt: str = "flac", dry_run: bool = False):
    vids = list(Path.cwd().glob("*.mp4")) + list(Path.cwd().glob("*.mkv")) + list(Path.cwd().glob("*.webm"))
    if not vids:
        log_warn("No video files (.mp4, .mkv, .webm) found in current directory.")
        return

    selected = run_fzf([v.name for v in vids], prompt=f"Select video(s) for {fmt.upper()} rip [TAB multi] > ", multi=True)
    if not selected:
        return

    for fname in selected:
        src = Path(fname)
        out = src.with_suffix(f".{fmt}")
        if fmt == "flac":
            cmd = ["ffmpeg", "-y", "-i", str(src), "-vn", "-c:a", "flac", "-sample_fmt", "s32", "-threads", "0", str(out)]
        else:
            cmd = ["ffmpeg", "-y", "-i", str(src), "-vn", "-c:a", "libopus", "-b:a", "160k", "-threads", "0", str(out)]

        log_step("Extracting", f"{src.name} -> {out.name}")
        if dry_run:
            print(f"{Style.YELLOW}[DRY-RUN]{Style.RESET} {' '.join(cmd)}")
        else:
            subprocess.run(cmd, check=False)
            log_success(f"Exported: {out.name}")


