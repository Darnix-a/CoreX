def builtin_model_symlink(cfg: CoreXConfig):
    models_dir = cfg.comfyui_path / "models"
    if not models_dir.exists():
        log_error(f"ComfyUI models folder not found at {models_dir}")
        return

    safetensors = list(Path.cwd().glob("*.safetensors")) + list((Path.home() / "Downloads").glob("*.safetensors"))
    if not safetensors:
        log_warn("No .safetensors files found in cwd or ~/Downloads.")
        return

    chosen_file = run_fzf([str(f) for f in safetensors], prompt="Select .safetensors model > ")
    if not chosen_file:
        return
    src = Path(chosen_file[0])

    subfolders = [p for p in models_dir.iterdir() if p.is_dir()]
    chosen_dest = run_fzf([str(d.relative_to(models_dir)) for d in subfolders], prompt="Select ComfyUI model category > ")
    if not chosen_dest:
        return

    dest_dir = models_dir / chosen_dest[0]
    link_target = dest_dir / src.name
    try:
        link_target.symlink_to(src.resolve())
        log_success(f"Symlinked: {src.name} -> {chosen_dest[0]}/{src.name}")
    except FileExistsError:
        log_warn(f"Symlink already exists in {chosen_dest[0]}")
    except Exception as e:
        log_error(f"Symlink failed: {e}")


def builtin_stream_yt(video: bool = False, query: Optional[str] = None, dry_run: bool = False):
    if not shutil.which("yt-dlp") or not shutil.which("mpv"):
        log_error("yt-dlp and mpv are required for stream-yt.")
        return

    q = query
    if not q:
        if not sys.stdin.isatty():
            return
        print(f"{Style.CYAN}{Style.BOLD}Search YouTube:{Style.RESET} ", end="", flush=True)
        try:
            q = input().strip()
        except (KeyboardInterrupt, EOFError):
            return
    if not q:
        return

    if q.startswith("http://") or q.startswith("https://"):
        cmd = ["mpv"] + (["--hwdec=auto"] if video else ["--no-video", "--ytdl-format=bestaudio/best"]) + [q]
        if dry_run:
            print(f"{Style.YELLOW}[DRY-RUN]{Style.RESET} {' '.join(cmd)}")
        else:
            subprocess.run(cmd)
        return

    log_info(f"Searching YouTube for '{q}'...")
    res = subprocess.run(
        ["yt-dlp", "--flat-playlist", "--default-search", "ytsearch25", "--print", "%(id)s\t%(duration_string)s\t%(uploader)s\t%(title)s", q],
        capture_output=True,
        text=True,
    )
    lines = [l.strip() for l in res.stdout.strip().splitlines() if l.strip()]
    if not lines:
        log_warn("No results found.")
        return

    fzf_items = []
    for l in lines:
        parts = l.split("\t")
        vid_id = parts[0]
        dur = parts[1] if len(parts) > 1 and parts[1] != "NA" else "--:--"
        up = parts[2] if len(parts) > 2 else "Unknown"
        title = parts[3] if len(parts) > 3 else "Untitled"
        fzf_items.append(f"https://www.youtube.com/watch?v={vid_id}\t{dur:<8}\t{up:<22}\t{title}")

    extra = [
        "--delimiter=\t",
        "--with-nth=2,3,4",
        "--header=ENTER: Play Stream | CTRL-Y: Copy URL",
        "--bind=ctrl-y:execute-silent(echo -n {1} | wl-copy || echo -n {1} | xclip -selection clipboard)",
    ]

    selected = run_fzf(fzf_items, prompt="stream > ", extra_args=extra)
    if not selected:
        return

    url = selected[0].split("\t")[0]
    title = selected[0].split("\t")[-1]
    log_success(f"Streaming: {title}")
    cmd = ["mpv"] + (["--hwdec=auto"] if video else ["--no-video", "--ytdl-format=bestaudio/best"]) + [url]
    if dry_run:
        print(f"{Style.YELLOW}[DRY-RUN]{Style.RESET} {' '.join(cmd)}")
    else:
        subprocess.run(cmd)


