                return
            path_str = f_out.strip()
        except KeyboardInterrupt:
            return

    target_path = Path(path_str).resolve()
    if not target_path.exists():
        log_error(f"File not found: '{target_path}'")
        return

    probe_cmd = [
        "ffprobe",
        "-v", "quiet",
        "-print_format", "json",
        "-show_format",
        "-show_streams",
        "-show_chapters",
        str(target_path)
    ]
    try:
        res = subprocess.run(probe_cmd, capture_output=True, text=True)
        if res.returncode != 0:
            log_error(f"ffprobe failed to inspect '{target_path.name}': {res.stderr}")
            return
        probe = json.loads(res.stdout)
    except Exception as e:
        log_error(f"Failed to parse media metadata: {e}")
        return

    if "--json" in args:
        print(json.dumps(probe, indent=2))
        return

    fmt = probe.get("format", {})
    streams = probe.get("streams", [])
    chapters = probe.get("chapters", [])

