# UNIFIED COCKPIT NAVIGATION & ITEM FORMATTING
# ---------------------------------------------------------------------------
def format_cockpit_items(cfg: CoreXConfig) -> List[str]:
    """Formats 150+ catalog items with clean columns, colors, and minimal badges."""
    state = load_user_state()
    pinned_set = set(state.get("pinned", []))
    freq_map = state.get("frequency", {})

    def sort_key(c: CommandSpec):
        is_pin = c.id in pinned_set
        usage = freq_map.get(c.id, 0)
        return (not is_pin, -usage, c.category, c.id)

    sorted_cmds = sorted(cfg.commands.values(), key=sort_key)
    items = []
    for c in sorted_cmds:
        tag = CATEGORY_TAGS.get(c.category, "@misc")
        t_color = get_tag_color(tag)
        has_missing = any(not shutil.which(d) for d in c.deps)
        is_pinned = c.id in pinned_set

        if has_missing:
            badge = f"{Style.RED}▲{Style.RESET} "
        elif is_pinned:
            badge = f"{Style.YELLOW}★{Style.RESET} "
        elif c.requires_sudo:
            badge = f"{Style.YELLOW}⚡{Style.RESET} "
        else:
            badge = f"{Style.DARK_GRAY}•{Style.RESET} "

        # Real option display: command name + alias
        aliases = REVERSE_COMMAND_ALIASES.get(c.id, [])
        primary_alias = aliases[0] if aliases else ""
        alias_disp = f" {Style.GRAY}({primary_alias}){Style.RESET}" if primary_alias else ""
        raw_name = f"{c.id} ({primary_alias})" if primary_alias else c.id
        pad_len = max(1, 23 - len(raw_name))
        cmd_col = f"{Style.BOLD}{Style.WHITE}{c.id}{Style.RESET}{alias_disp}{' ' * pad_len}"

        pin_tag = f" {Style.YELLOW}@pinned @favorites{Style.RESET}" if is_pinned else ""

        # Delimiter: tab
        # 1: id (hidden from display via --with-nth, used by {1} actions & preview)
        # 2: status badge (★, ▲, ⚡, •)
        # 3: command id with alias (real option primary match target)
        # 4: category tag (e.g. @audio, @sys)
        # 5: subtle vertical separator
        # 6: description (+ @pinned @favorites virtual tag if pinned)
        items.append(
            f"{c.id}\t{badge}\t{cmd_col}\t{t_color}{tag:<8}{Style.RESET}\t{Style.DARK_GRAY}│{Style.RESET}\t{Style.GRAY}{c.description}{Style.RESET}{pin_tag}"
        )
    return items


def run_interactive_cockpit(cfg: CoreXConfig, dry_run: bool = False):
    """
    Unified, lightning-fast cockpit with @category fuzzy filtering,
    in-app command builder (Ctrl+N), and favorites/pinning (Tab).
    """
    self_exe = os.path.abspath(sys.argv[0])
    items = format_cockpit_items(cfg)

    preview_call = f"python3 '{self_exe}' __preview {{1}}"

    extra = [
        "--delimiter=\t",
        "--with-nth=2,3,4,5,6",
        "--exact",
        "--no-hscroll",
        "--scheme=history",
        "--tiebreak=begin",
        "--border=rounded",
        "--border-label= CoreX ",
        "--border-label-pos=3",
        "--preview-window=right:30%:border-rounded:wrap",
        "--preview-label= ACTION DETAILS [? to close] ",
        "--preview-label-pos=3",
        "--header= Filter: @pinned  @ai  @audio  @gpu  @sys  @net  @dev  @daily  @docker  @code ",
        "--header-label= CATEGORIES ",
        "--header-label-pos=3",
        "--footer= [Enter] Run  │  [Tab] Pin  │  [?] Details  │  [^N] Builder  │  [^Y] Copy  │  [^D] Dry-Run  │  [^E] Edit  │  [ESC] Quit ",
        "--footer-label= KEYBINDINGS ",
        "--footer-label-pos=3",
        "--prompt=  ◈ cx ❯ ",
        "--pointer=▶ ",
        "--marker=◈ ",
        "--scrollbar=│",
        "--info=inline-right",
        f"--bind=tab:execute(python3 '{self_exe}' __toggle_pin {{1}})+reload(python3 '{self_exe}' __fzf_items)",
        f"--bind=ctrl-n:execute(python3 '{self_exe}' builder)+reload(python3 '{self_exe}' __fzf_items)",
        f"--bind=ctrl-r:reload(python3 '{self_exe}' __fzf_items)",
        f"--bind=ctrl-y:execute-silent(python3 '{self_exe}' __get_cmd {{1}} | wl-copy 2>/dev/null || python3 '{self_exe}' __get_cmd {{1}} | xclip -selection clipboard 2>/dev/null)",
        f"--bind=ctrl-d:execute(python3 '{self_exe}' --dry-run {{1}}; echo; read -n 1 -s -r -p 'Press any key to return...'; echo)",
        f"--bind=ctrl-e:execute(python3 '{self_exe}' __edit_run {{1}})",
        "--bind=?:toggle-preview",
    ]

    sel = run_fzf(items, prompt="  ◈ cx ❯ ", preview_cmd=preview_call, preview_window="right:30%:border-rounded:wrap", extra_args=extra)
    if not sel:
        return

    chosen_cmd_id = sel[0].split("\t")[0].strip()
    execute_command(chosen_cmd_id, cfg, dry_run=dry_run)


# ---------------------------------------------------------------------------
# COMMAND DISPATCHER & SUBSHELL EXECUTION
# ---------------------------------------------------------------------------
def execute_command(
    cmd_id: str,
    cfg: CoreXConfig,
    dry_run: bool = False,
    bg_run: bool = False,
    extra_args: Optional[List[str]] = None,
):
    actual_id = COMMAND_ALIASES.get(cmd_id, cmd_id)
    spec = cfg.commands.get(actual_id)

    if not spec:
        log_error(f"Unknown command '{cmd_id}'. Run 'cx --list' or 'cx --help' for available actions.")
        sys.exit(1)

    if not dry_run:
        record_action_usage(actual_id)

    # Dependency check
    for d in spec.deps:
        if not shutil.which(d):
            log_warn(f"Required binary '{d}' is missing! Command may fail. ({get_install_hint(d)})")

    # Confirmation check
    if spec.confirm and not dry_run:
        print(f"{Style.YELLOW}{Style.BOLD}⚠️  Action '{actual_id}' requires confirmation. Proceed? [y/N]:{Style.RESET} ", end="", flush=True)
        try:
            ans = input().strip().lower()
            if ans not in ["y", "yes"]:
                log_info("Operation canceled.")
                return
        except (KeyboardInterrupt, EOFError):
            print()
            return

    # Check built-in dispatch
    if spec.command.startswith("cx __builtin "):
        builtin_name = spec.command.replace("cx __builtin ", "").strip()
        args = extra_args or []
        if actual_id == "builder" and cmd_id in ("new", "add", "create", "edit", "modify", "delete", "remove", "rm", "test", "validate", "check"):
            args = [cmd_id] + args
        if bg_run:
            # Wrap built-in in detached subshell
            self_exe = os.path.abspath(sys.argv[0])
            quoted_args = " ".join([f"'{a}'" if " " in a else a for a in args])
            bg_cmd = f"python3 '{self_exe}' {actual_id} {quoted_args}"
            detach_background(actual_id, bg_cmd, dry_run=dry_run)
            return
        dispatch_builtin(builtin_name, cfg, dry_run=dry_run, extra_args=args)
        return

    # Shell execution
    final_cmd = spec.command
    if extra_args:
        quoted_args = " ".join([f"'{a}'" if " " in a else a for a in extra_args])
        final_cmd = f"{final_cmd} {quoted_args}"

    if spec.requires_sudo and os.geteuid() != 0 and not final_cmd.strip().startswith("sudo"):
        final_cmd = f"sudo {final_cmd}"

    if dry_run:
        prefix = "[DRY-RUN BG]" if bg_run else "[DRY-RUN]"
        print(f"{Style.YELLOW}{prefix}{Style.RESET} {Style.BOLD}{final_cmd}{Style.RESET}")
        return

    if bg_run:
        detach_background(actual_id, final_cmd)
        return

    try:
        ret = subprocess.run(final_cmd, shell=True)
        sys.exit(ret.returncode)
    except KeyboardInterrupt:
        sys.exit(130)


def detach_background(cmd_id: str, shell_cmd: str, dry_run: bool = False):
    """Detaches command into a systemd-run user service or background nohup subshell."""
    ts = int(time.time())
    unit_name = f"corex-{cmd_id}-{ts}"
    has_systemd_run = shutil.which("systemd-run") is not None

    if has_systemd_run:
        full_cmd = ["systemd-run", "--user", f"--unit={unit_name}", "sh", "-c", shell_cmd]
    else:
        full_cmd = ["nohup", "sh", "-c", shell_cmd]

    if dry_run:
        print(f"{Style.YELLOW}[DRY-RUN BG]{Style.RESET} {' '.join(full_cmd)}")
        return

    log_info(f"Detaching '{cmd_id}' into background scope ({unit_name})...")
    if has_systemd_run:
        res = subprocess.run(full_cmd, capture_output=True, text=True)
        if res.returncode == 0:
            log_success(f"Command '{cmd_id}' running as systemd user unit: {unit_name}.service")
        else:
            subprocess.Popen(["nohup", "sh", "-c", shell_cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, preexec_fn=os.setpgrp)
            log_success(f"Command '{cmd_id}' detached via background subshell.")
    else:
        subprocess.Popen(full_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, preexec_fn=os.setpgrp)
        log_success(f"Command '{cmd_id}' detached via background nohup.")


