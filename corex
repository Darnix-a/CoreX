def get_nvidia_vram() -> Tuple[Optional[int], Optional[int]]:
    """Returns (total_mib, free_mib) or (None, None)."""
    if not check_tool("nvidia-smi"):
        return None, None
    ret, out, _ = run_cmd(
        ["nvidia-smi", "--query-gpu=memory.total,memory.free", "--format=csv,noheader,nounits"],
        capture_output=True,
    )
    if ret != 0 or not out.strip():
        return None, None
    try:
        first_line = out.strip().splitlines()[0]
        total_str, free_str = [x.strip() for x in first_line.split(",")]
        return int(total_str), int(free_str)
    except Exception:
        return None, None


def cmd_comfyui(cfg: CoreXConfig, dry_run: bool = False, extra_args: Optional[List[str]] = None):
    """One-click launcher for ComfyUI with smart VRAM detection, venv boot, and collision check."""
    log_info("Inspecting ComfyUI workspace environment...")

    # Check if ComfyUI is already running on the configured port
    in_use, existing_pid = is_port_in_use(cfg.comfyui_host, cfg.comfyui_port)
    url = f"http://{cfg.comfyui_host}:{cfg.comfyui_port}"
    if in_use:
        log_success(f"ComfyUI is ALREADY RUNNING on {url} (PID: {existing_pid or 'active'})!")
        if dry_run:
            print(f"{Style.YELLOW}[DRY-RUN]{Style.RESET} ComfyUI active instance detected on port {cfg.comfyui_port}")
            return
        if cfg.comfyui_auto_browser:
            log_info(f"Opening browser at {url}...")
            subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if cfg.comfyui_notify and check_tool("notify-send"):
            run_cmd(["notify-send", "ComfyUI Active", f"ComfyUI already running at {url}"])
        return

    # Locate ComfyUI directory
    comfy_dir = cfg.comfyui_path
    if not comfy_dir.exists():
        candidates = [
            Path.home() / "ComfyUI",
            Path.home() / "comfyui",
            Path.home() / "ai" / "ComfyUI",
            Path.cwd(),
        ]
        for c in candidates:
            if (c / "main.py").exists():
                comfy_dir = c
                break

    if not (comfy_dir / "main.py").exists():
        log_error(f"Could not locate ComfyUI at '{comfy_dir}'.")
        log_info("Please verify 'comfyui_path' in ~/.config/corex/config.toml")
        return

    log_step("ComfyUI Root", str(comfy_dir))

    # Detect Virtual Environment
    python_bin = sys.executable
    venv_candidates = [
        comfy_dir / cfg.comfyui_venv / "bin" / "python",
        comfy_dir / "venv" / "bin" / "python",
        comfy_dir / ".venv" / "bin" / "python",
        comfy_dir / "env" / "bin" / "python",
    ]
    detected_venv = None
    for cand in venv_candidates:
        if cand.exists() and os.access(cand, os.X_OK):
            detected_venv = cand
            python_bin = str(cand)
            break

    if detected_venv:
        log_step("Virtualenv", f"{Style.GREEN}Active{Style.RESET} ({detected_venv})")
    else:
        log_warn("No dedicated virtualenv detected; falling back to system Python.")

    # GPU VRAM inspection and flag calculation
    total_vram, free_vram = get_nvidia_vram()
    vram_flag = "--normalvram"
    if free_vram is not None and total_vram is not None:
        log_step("GPU VRAM Free", f"{free_vram} MiB / {total_vram} MiB")
        if free_vram >= cfg.vram_high_threshold_mb:
            vram_flag = "--highvram"
            log_step("Memory Profile", f"{Style.GREEN}{Style.BOLD}HIGH VRAM{Style.RESET} (Flag: --highvram)")
        elif free_vram < cfg.vram_low_threshold_mb:
            vram_flag = "--lowvram"
            log_step("Memory Profile", f"{Style.YELLOW}{Style.BOLD}LOW VRAM{Style.RESET} (Flag: --lowvram)")
        else:
            vram_flag = "--normalvram"
            log_step("Memory Profile", f"{Style.CYAN}NORMAL VRAM{Style.RESET} (Flag: --normalvram)")
    else:
        log_warn("NVIDIA GPU / nvidia-smi not detected or querying failed. Using default VRAM handling.")

    # Build launch command
    launch_cmd = [
        python_bin,
        "main.py",
        "--listen",
        cfg.comfyui_host,
        "--port",
        str(cfg.comfyui_port),
        vram_flag,
    ]
    if cfg.comfyui_extra_flags:
        launch_cmd.extend(cfg.comfyui_extra_flags)
    if extra_args:
        launch_cmd.extend(extra_args)

    log_step("Boot Command", " ".join(launch_cmd))

    if dry_run:
        run_cmd(launch_cmd, cwd=comfy_dir, dry_run=True)
        return

    # Notification & auto-browser spawn if enabled
    if cfg.comfyui_notify and check_tool("notify-send"):
        run_cmd(["notify-send", "CoreX AI Launcher", f"Booting ComfyUI on {url} (Profile: {vram_flag})"])

    if cfg.comfyui_auto_browser:
        log_info(f"Opening browser at {url}...")
        subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    log_success(f"Spinning up ComfyUI server at {url} (Press Ctrl+C to stop)...")
    run_cmd(launch_cmd, cwd=comfy_dir)


def cmd_ai_models(cfg: CoreXConfig, dry_run: bool = False):
    """Inspect and manage loaded Ollama/vLLM models and daemon status."""
    api_url = cfg.ollama_url.rstrip("/")

    # Query running models via Ollama API
    running_models: List[Dict[str, Any]] = []
    service_alive = False
    try:
        req = urllib.request.Request(f"{api_url}/api/ps", headers={"User-Agent": "CoreX-CLI"})
        with urllib.request.urlopen(req, timeout=1.5) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            running_models = data.get("models", [])
            service_alive = True
    except Exception:
        pass

    if not sys.stdin.isatty() or dry_run:
        print_banner(dry_run)
        print(box_header("OLLAMA / vLLM INFERENCE ENGINE"))
        status_txt = f"{Style.GREEN}Active{Style.RESET}" if service_alive else f"{Style.RED}Unreachable / Inactive{Style.RESET}"
        print(f" {Style.BOLD}Endpoint:{Style.RESET}   {api_url}")
        print(f" {Style.BOLD}Status:{Style.RESET}     {status_txt}")
        if running_models:
            print(f" {Style.BOLD}Models in VRAM:{Style.RESET}")
            for m in running_models:
                name = m.get("name", "unknown")
                vram_mb = m.get("size_vram", 0) / (1024 * 1024)
                print(f"   • {Style.CYAN}{name}{Style.RESET} ({vram_mb:.0f} MiB)")
        else:
            print(f" {Style.BOLD}Models in VRAM:{Style.RESET} None")
        print(box_footer())
        return

    # Interactive Sub-menu
    options = []
    if service_alive:
        options.append(f"● [Status] Ollama Server Active at {api_url}")
        if running_models:
            for m in running_models:
                name = m.get("name", "unknown")
                size_vram = m.get("size_vram", 0) / (1024 * 1024)
                options.append(f"⚡ [Loaded Model] {name} ({size_vram:.0f} MiB in VRAM) -> Unload")
        else:
            options.append("○ [Models] No models currently loaded in VRAM")
    else:
        options.append(f"▲ [Status] Ollama Server unreachable at {api_url}")

    options.append("▶ Start Ollama Background Daemon")
    options.append("■ Stop Ollama Service")
    options.append("🔄 Restart Ollama Daemon")

    selected = run_fzf(
        options,
        prompt="cx ai > ",
        header="Ollama / vLLM Model & Daemon Controller",
    )
    if not selected:
        return

    choice = selected[0]
    if "Unload" in choice:
        match = re.search(r"\[Loaded Model\]\s+([^\s]+)", choice)
        if match:
            model_name = match.group(1)
            log_info(f"Evicting model '{model_name}' from GPU memory...")
            if dry_run:
                print(f"{Style.YELLOW}[DRY-RUN]{Style.RESET} Post keep_alive=0 to {api_url}/api/generate for model {model_name}")
                return
            try:
                payload = json.dumps({"model": model_name, "keep_alive": 0}).encode("utf-8")
                req = urllib.request.Request(
                    f"{api_url}/api/generate",
                    data=payload,
                    headers={"Content-Type": "application/json"},
                )
                with urllib.request.urlopen(req, timeout=5) as resp:
                    log_success(f"Model '{model_name}' evicted from VRAM.")
            except Exception as e:
                log_error(f"Failed to unload model: {e}")
    elif "Start Ollama" in choice:
        log_info("Starting Ollama service...")
        cmd = ["systemctl", "--user", "start", "ollama"]
        ret, _, _ = run_cmd(cmd, dry_run=dry_run)
        if ret != 0 and not dry_run:
            log_info("Trying system service start...")
            run_cmd(["sudo", "systemctl", "start", "ollama"])
    elif "Stop Ollama" in choice:
        log_info("Stopping Ollama service...")
        run_cmd(["systemctl", "--user", "stop", "ollama"], dry_run=dry_run)
    elif "Restart Ollama" in choice:
        log_info("Restarting Ollama service...")
        run_cmd(["systemctl", "--user", "restart", "ollama"], dry_run=dry_run)


def cmd_docker(dry_run: bool = False):
    """Fuzzy-select containers to restart, view live trailing logs, or kill."""
    engine = "docker" if check_tool("docker") else ("podman" if check_tool("podman") else None)
    if not engine:
        log_error("Neither 'docker' nor 'podman' found on this system.")
        return

    ret, out, _ = run_cmd(
        [engine, "ps", "-a", "--format", "{{.ID}}\t{{.Names}}\t{{.Status}}\t{{.Image}}"],
        capture_output=True,
    )
    if ret != 0:
        log_error(f"Failed to query {engine}. Ensure daemon is running.")
        return

    lines = [l.strip() for l in out.strip().splitlines() if l.strip()]
    if not lines:
        log_info(f"No {engine} containers found.")
        return

    if not sys.stdin.isatty() or dry_run:
        print(f"{Style.BOLD}{'ID':<12} {'NAME':<20} {'STATUS':<20} {'IMAGE'}{Style.RESET}")
        print("─" * 70)
        for line in lines:
            parts = line.split("\t")
            cid = parts[0]
            name = parts[1] if len(parts) > 1 else ""
            st = parts[2] if len(parts) > 2 else ""
            img = parts[3] if len(parts) > 3 else ""
            print(f"{cid:<12} {name:<20} {st:<20} {img}")
        return

    items = []
    for line in lines:
        parts = line.split("\t")
        cid, name, status, img = parts[0], parts[1], parts[2], parts[3] if len(parts) > 3 else ""
        icon = f"{Style.GREEN}●{Style.RESET}" if "Up" in status else f"{Style.RED}○{Style.RESET}"
        items.append(f"{cid}\t{icon} {name:<20}\t{status:<20}\t{img}")

    preview = f"{engine} logs --tail 40 {{1}}"
    extra = [
        "--delimiter=\t",
        "--with-nth=2,3,4",
        "--header=ENTER: Tail Logs | CTRL-R: Restart | CTRL-K: Kill/Stop | CTRL-E: Exec Shell",
        f"--bind=ctrl-r:execute({engine} restart {{1}} >/dev/null)+reload({engine} ps -a --format '{{{{.ID}}}}\t{{{{.Names}}}}\t{{{{.Status}}}}\t{{{{.Image}}}}')",
        f"--bind=ctrl-k:execute({engine} stop {{1}} >/dev/null)+reload({engine} ps -a --format '{{{{.ID}}}}\t{{{{.Names}}}}\t{{{{.Status}}}}\t{{{{.Image}}}}')",
        f"--bind=ctrl-e:execute({engine} exec -it {{1}} sh -c 'bash || sh')",
    ]

    selected = run_fzf(
        items,
        prompt=f"cx {engine} > ",
        preview_cmd=preview,
        extra_args=extra,
    )
    if not selected:
        return

    chosen_id = selected[0].split("\t")[0].strip()
    log_info(f"Connecting to container {chosen_id} live logs (Ctrl+C to exit)...")
    run_cmd([engine, "logs", "-f", "--tail", "100", chosen_id], dry_run=dry_run)


