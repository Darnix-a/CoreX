def handle_preview(action_id: str, cfg: CoreXConfig):
    """Generates dynamic live preview text when highlighted in fzf."""
    if action_id == "comfyui":
        print(f"{Style.BOLD}{Style.CYAN}=== ComfyUI Dev & AI Launcher ==={Style.RESET}")
