# USER STATE & FAVORITES MANAGEMENT
# ---------------------------------------------------------------------------
def load_user_state() -> Dict[str, Any]:
    if not STATE_FILE.exists():
        return {"pinned": [], "frequency": {}, "last_used": {}}
    try:
        with open(STATE_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
            if not isinstance(data, dict):
                return {"pinned": [], "frequency": {}, "last_used": {}}
            data.setdefault("pinned", [])
            data.setdefault("frequency", {})
            data.setdefault("last_used", {})
            return data
    except Exception:
        return {"pinned": [], "frequency": {}, "last_used": {}}


def save_user_state(state: Dict[str, Any]):
    try:
        STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
        temp_file = STATE_FILE.with_suffix(".tmp")
        with open(temp_file, "w", encoding="utf-8") as f:
            json.dump(state, f, indent=2)
        temp_file.replace(STATE_FILE)
    except Exception as e:
        log_warn(f"Failed to save state to {STATE_FILE}: {e}")


def toggle_pin_action(cmd_id: str) -> bool:
    state = load_user_state()
    pinned = list(state.get("pinned", []))
    if cmd_id in pinned:
        pinned.remove(cmd_id)
        now_pinned = False
    else:
        pinned.append(cmd_id)
        now_pinned = True
    state["pinned"] = pinned
    save_user_state(state)
    return now_pinned


def set_pin_action(cmd_id: str, pin: bool):
    state = load_user_state()
    pinned = list(state.get("pinned", []))
    if pin and cmd_id not in pinned:
        pinned.append(cmd_id)
    elif not pin and cmd_id in pinned:
        pinned.remove(cmd_id)
    state["pinned"] = pinned
    save_user_state(state)


def record_action_usage(cmd_id: str):
    state = load_user_state()
    freq = state.get("frequency", {})
    freq[cmd_id] = freq.get(cmd_id, 0) + 1
    state["frequency"] = freq
    last = state.get("last_used", {})
    last[cmd_id] = int(time.time())
    state["last_used"] = last
    save_user_state(state)


