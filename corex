def _format_media_size(bytes_val) -> str:
    try:
        b = float(bytes_val)
        for unit in ["B", "KB", "MB", "GB", "TB"]:
            if b < 1024:
                return f"{b:.2f} {unit}"
            b /= 1024
        return f"{b:.2f} PB"
    except Exception:
        return str(bytes_val)


def _format_media_duration(sec_val) -> str:
    try:
        s = float(sec_val)
        m, sec = divmod(s, 60)
        h, m = divmod(m, 60)
        if h > 0:
            return f"{int(h):02d}:{int(m):02d}:{sec:05.2f} ({s:.1f}s)"
        return f"{int(m):02d}:{sec:05.2f} ({s:.1f}s)"
    except Exception:
        return str(sec_val)


def builtin_media_info(target_file: Optional[str] = None, extra_args: Optional[List[str]] = None):
    args = extra_args or []
    if not shutil.which("ffprobe"):
        log_error("ffprobe is required for media forensics. Install: sudo pacman -S ffmpeg")
        return

    path_str = target_file
    if not path_str and args and not args[0].startswith("-"):
        path_str = args[0]

    if not path_str:
        if not shutil.which("fzf"):
            log_error("Usage: cx media-info <file>")
            return

        media_exts = ("*.mp4", "*.mkv", "*.mov", "*.avi", "*.webm", "*.flv", "*.wmv",
                      "*.mp3", "*.flac", "*.wav", "*.m4a", "*.opus", "*.ogg", "*.aac",
                      "*.png", "*.jpg", "*.jpeg", "*.webp", "*.gif", "*.bmp", "*.avif")
        find_cmd = ["find", "-L", ".", "-maxdepth", "3", "-type", "f", "("]
        for i, ext in enumerate(media_exts):
            if i > 0:
                find_cmd.append("-o")
            find_cmd.extend(["-iname", ext])
        find_cmd.append(")")

        files_res = subprocess.run(find_cmd, capture_output=True, text=True).stdout.splitlines()
        if not files_res:
            for udir in ["~/Videos", "~/Music", "~/Pictures", "~/Downloads"]:
                epath = os.path.expanduser(udir)
                if os.path.isdir(epath):
                    u_cmd = ["find", "-L", epath, "-maxdepth", "2", "-type", "f", "("]
                    for i, ext in enumerate(media_exts):
                        if i > 0:
                            u_cmd.append("-o")
                        u_cmd.extend(["-iname", ext])
                    u_cmd.append(")")
                    u_res = subprocess.run(u_cmd, capture_output=True, text=True).stdout.splitlines()
                    files_res.extend(u_res)
                    if len(files_res) > 50:
                        break

        if not files_res:
            log_warn("No video, audio, or image files found in current directory or user media folders.")
            return

        fzf_cmd = [
            "fzf",
            "--prompt=  ◈ Select Media File ❯ ",
            "--border=rounded",
            "--border-label= CoreX Media Forensics ",
            "--border-label-pos=3",
            "--height=70%",
        ]
        try:
            fproc = subprocess.Popen(fzf_cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
            f_out, _ = fproc.communicate(input="\n".join(files_res))
