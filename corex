    )

    selected = run_fzf(
        items,
        prompt="Select AI Model > ",
        preview_cmd=preview_cmd,
        header=header,
        extra_args=["--expect=ctrl-d,ctrl-t", "--delimiter= "]
    )

    if not selected:
        return

    if len(selected) >= 2:
        key = selected[0].strip()
        chosen_line = selected[1].strip()
    else:
        key = ""
        chosen_line = selected[0].strip()

    chosen_name = chosen_line.split()[0].strip()
