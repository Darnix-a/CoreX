        set_pin_action(target, True)
        log_success(f"Pinned '{target}' to favorites.")
        sys.exit(0)

    if parsed.command == "unpin":
        target = (parsed.args[0] if parsed.args else "") or (unknown[0] if unknown else "")
        if not target:
            log_error("Usage: cx unpin <action>")
            sys.exit(1)
        set_pin_action(target, False)
        log_success(f"Unpinned '{target}' from favorites.")
        sys.exit(0)

    if parsed.command in ("pinned", "favorites", "favs"):
        state = load_user_state()
