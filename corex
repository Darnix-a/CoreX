def render_preview(cmd_id: str, cfg: CoreXConfig):
    spec = cfg.commands.get(cmd_id)
    if not spec:
        # Fallback special previews
        if cmd_id == "todo":
            builtin_todo_preview(cfg)
        return

    print(box_header(f"ACTION: {spec.id}"))
    print(f" {Style.BOLD}Category:{Style.RESET}      {spec.category}")
    print(f" {Style.BOLD}Description:{Style.RESET}   {spec.description}")
    sudo_tag = f"{Style.RED}{Style.BOLD}YES{Style.RESET}" if spec.requires_sudo else f"{Style.GRAY}NO{Style.RESET}"
    confirm_tag = f"{Style.YELLOW}{Style.BOLD}YES{Style.RESET}" if spec.confirm else f"{Style.GRAY}NO{Style.RESET}"
    print(f" {Style.BOLD}Requires Sudo:{Style.RESET} {sudo_tag}  |  {Style.BOLD}Confirm Prompt:{Style.RESET} {confirm_tag}")

