def generate_fish_completions(cfg: CoreXConfig) -> str:
    lines = [
        "# Fish completions for CoreX (cx) - Auto-generated Phase 3",
        "complete -c cx -f",
        "complete -c cx -s h -l help -d 'Show CoreX help message'",
        "complete -c cx -s v -l version -d 'Show CoreX version'",
        "complete -c cx -l list -d 'Output tab-delimited command list'",
        "complete -c cx -l dry-run -d 'Preview commands without executing them'",
        "complete -c cx -l bg -d 'Detach command into background daemon scope'",
        "complete -c cx -l no-color -d 'Disable ANSI terminal styling'",
        "complete -c cx -l config -r -F -d 'Custom TOML configuration path'",
        "complete -c cx -s y -l yes -d 'Bypass confirmation prompts'",
    ]
    for cid, spec in cfg.commands.items():
        desc_escaped = spec.description.replace("'", "\\'")
        lines.append(f"complete -c cx -n '__fish_use_subcommand' -a '{cid}' -d '{desc_escaped}'")
    lines.append("complete -c corex -w cx")
    return "\n".join(lines)


def generate_bash_completions(cfg: CoreXConfig) -> str:
    cmds = " ".join(cfg.commands.keys())
    return f"""# Bash completions for CoreX (cx)
_cx_completions() {{
    local cur prev words cword
    _init_completion || return

    local commands="{cmds} --dry-run --bg --help --version --list --yes"

    if [[ $cword -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
    fi
}}
complete -F _cx_completions cx
complete -F _cx_completions corex
"""


def generate_zsh_completions(cfg: CoreXConfig) -> str:
    lines = [
        "#compdef cx corex",
        "_cx() {",
        "    local -a commands",
        "    commands=(",
    ]
    for cid, spec in cfg.commands.items():
        clean_desc = spec.description.replace("'", "").replace(":", "-")
        lines.append(f"        '{cid}:{clean_desc}'")
    lines.extend([
        "    )",
        "    _arguments -C \\",
        "        '(-h --help)'{-h,--help}'[Show help]' \\",
        "        '(-v --version)'{-v,--version}'[Show version]' \\",
        "        '--dry-run[Preview commands]' \\",
        "        '--bg[Detach command in background]' \\",
        "        '--list[List all commands]' \\",
        "        '1: :->command' \\",
        "        '*:: :->args'",
        "    case $state in",
        "        command) _describe -t commands 'cx commands' commands ;;",
        "    esac",
        "}",
        "_cx \"$@\"",
    ])
    return "\n".join(lines)


class ParsedArgs:
    __slots__ = ("command", "args", "help", "version", "dry_run", "bg", "yes", "list", "no_color", "config")

    def __init__(self):
        self.command: Optional[str] = None
        self.args: List[str] = []
        self.help: bool = False
        self.version: bool = False
        self.dry_run: bool = False
        self.bg: bool = False
        self.yes: bool = False
        self.list: bool = False
        self.no_color: bool = False
        self.config: Optional[Path] = None


def parse_cli_args(argv: List[str]) -> Tuple[ParsedArgs, List[str]]:
    parsed = ParsedArgs()
    unknown: List[str] = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in ("-h", "--help"):
            parsed.help = True
        elif arg in ("-v", "--version"):
            parsed.version = True
        elif arg == "--dry-run":
            parsed.dry_run = True
        elif arg == "--bg":
            parsed.bg = True
        elif arg in ("-y", "--yes"):
            parsed.yes = True
        elif arg == "--list":
            parsed.list = True
        elif arg == "--no-color":
            parsed.no_color = True
        elif arg == "--config":
            if i + 1 < len(argv):
                parsed.config = Path(argv[i + 1])
                i += 1
        elif not arg.startswith("-"):
            if parsed.command is None:
                parsed.command = arg
            else:
                parsed.args.append(arg)
        else:
            unknown.append(arg)
        i += 1
    return parsed, unknown


