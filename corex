def cmd_stream(cfg: CoreXConfig, query: Optional[str] = None, dry_run: bool = False, video: bool = False):
    """Fuzzy-search YouTube/SoundCloud via yt-dlp metadata cache and stream via mpv."""
    if not check_tool("yt-dlp"):
        log_error("'yt-dlp' is required for stream functionality.")
        log_info("Install yt-dlp via: sudo pacman -S yt-dlp")
        return
    if not check_tool("mpv"):
        log_error("'mpv' is required for stream playback.")
        log_info("Install mpv via: sudo pacman -S mpv")
        return

    search_query = query
    if not search_query:
        if not sys.stdin.isatty():
            log_error("No search query provided.")
            return
        print(f"{Style.CYAN}{Style.BOLD}Enter search query for YouTube / SoundCloud:{Style.RESET} ", end="", flush=True)
        try:
            search_query = input().strip()
        except (KeyboardInterrupt, EOFError):
            print()
            return
        if not search_query:
            return

    # Direct URL detection
    if search_query.startswith("http://") or search_query.startswith("https://"):
        url = search_query
        mode = "Video" if video else "Audio"
        log_info(f"Direct stream URL recognized: {url} (Mode: {mode})")
        mpv_cmd = ["mpv"]
        if not video:
            mpv_cmd.extend(["--no-video", "--ytdl-format=bestaudio/best"])
        else:
            mpv_cmd.extend([f"--hwdec={cfg.mpv_hwdec}"])
        mpv_cmd.append(url)
        run_cmd(mpv_cmd, dry_run=dry_run)
        return

    log_info(f"Querying {cfg.stream_provider} for: '{search_query}'...")
    ytdl_search_spec = f"{cfg.stream_provider}{cfg.stream_results_count}:{search_query}"

    if dry_run:
        print(f"{Style.YELLOW}[DRY-RUN]{Style.RESET} Query yt-dlp: yt-dlp --flat-playlist --print ... {ytdl_search_spec}")
        print(f"{Style.YELLOW}[DRY-RUN]{Style.RESET} Stream selection into mpv --no-video --ytdl-format=bestaudio/best")
        return

    ret, out, _ = run_cmd(
        [
            "yt-dlp",
            "--flat-playlist",
            "--default-search",
            cfg.stream_provider,
            "--print",
            "%(id)s\t%(duration_string)s\t%(uploader)s\t%(title)s",
            ytdl_search_spec,
        ],
        capture_output=True,
    )
    if ret != 0 or not out.strip():
        log_warn("No search results found or query timed out.")
        return

    raw_results = [line.strip() for line in out.strip().splitlines() if line.strip()]
    fzf_items = []
    for r in raw_results:
        parts = r.split("\t")
        vid_id = parts[0]
        duration = parts[1] if len(parts) > 1 and parts[1] != "NA" else "--:--"
        uploader = parts[2] if len(parts) > 2 else "Unknown"
        title = parts[3] if len(parts) > 3 else "Untitled"
        fzf_items.append(f"https://www.youtube.com/watch?v={vid_id}\t{duration:<8}\t{uploader:<22}\t{title}")

    extra = [
        "--delimiter=\t",
        "--with-nth=2,3,4",
        "--header=ENTER: Play Audio | CTRL-V: Play Video (HW-Acc) | CTRL-Y: Copy URL",
        "--bind=ctrl-y:execute-silent(echo -n {1} | wl-copy || echo -n {1} | xclip -selection clipboard)",
    ]

    selected = run_fzf(
        fzf_items,
        prompt="cx stream > ",
        extra_args=extra,
    )
    if not selected:
        return

    selected_line = selected[0]
    stream_url = selected_line.split("\t")[0]
    title_text = selected_line.split("\t")[-1]

    log_success(f"Streaming: {Style.BOLD}{title_text}{Style.RESET}")
    mpv_cmd = ["mpv"]
    if not video:
        mpv_cmd.extend(["--no-video", "--ytdl-format=bestaudio/best"])
    else:
        mpv_cmd.extend([f"--hwdec={cfg.mpv_hwdec}"])
    mpv_cmd.append(stream_url)

    run_cmd(mpv_cmd, dry_run=dry_run)


def cmd_rip_audio(cfg: CoreXConfig, target_dir: Optional[str] = None, dry_run: bool = False):
    """Extract audio from local video files to pristine 24-bit FLAC or Opus with multithreading."""
    if not check_tool("ffmpeg"):
        log_error("'ffmpeg' is required to rip audio.")
        log_info("Install ffmpeg via: sudo pacman -S ffmpeg")
        return

    work_dir = Path(target_dir or os.getcwd()).resolve()
    video_extensions = {".mp4", ".mkv", ".webm", ".avi", ".mov", ".flv", ".ts", ".m4v"}
    video_files = [f for f in work_dir.iterdir() if f.is_file() and f.suffix.lower() in video_extensions]

    if not video_files:
        log_warn(f"No video files ({', '.join(video_extensions)}) found in '{work_dir}'.")
        return

    if not sys.stdin.isatty() or dry_run:
        print(f"Found {len(video_files)} video file(s) in {work_dir}:")
        for vf in video_files:
            flac_cmd = f"ffmpeg -i {vf.name} -vn -c:a flac -sample_fmt s32 -threads 0 {vf.stem}.flac"
            print(f" • {vf.name} -> {flac_cmd}")
        return

    items = [f.name for f in video_files]
    selected_files = run_fzf(
        items,
        prompt="cx rip [TAB to multi-select] > ",
        multi=True,
        header=f"Select video files in {work_dir.name} to extract audio:",
    )
    if not selected_files:
        return

    format_choices = [
        f"flac  - Pristine {cfg.rip_flac_bits}-bit Lossless FLAC Master",
        f"opus  - High Efficiency Opus ({cfg.rip_opus_bitrate})",
        "opus320 - Maximum Fidelity Opus (320 kbps)",
    ]
    selected_fmt = run_fzf(format_choices, prompt="Select output codec > ")
    if not selected_fmt:
        return

    codec_choice = selected_fmt[0].split()[0]

    log_info(f"Processing {len(selected_files)} file(s) into {codec_choice.upper()}...")

    for fname in selected_files:
        src_path = work_dir / fname
        if codec_choice == "flac":
            out_path = src_path.with_suffix(".flac")
            ffmpeg_args = [
                "ffmpeg", "-y", "-i", str(src_path),
                "-vn", "-c:a", "flac",
                "-sample_fmt", "s32",
                "-threads", "0",
                str(out_path),
            ]
        elif codec_choice == "opus320":
            out_path = src_path.with_suffix(".opus")
            ffmpeg_args = [
                "ffmpeg", "-y", "-i", str(src_path),
                "-vn", "-c:a", "libopus",
                "-b:a", "320k",
                "-threads", "0",
                str(out_path),
            ]
        else:
            out_path = src_path.with_suffix(".opus")
            ffmpeg_args = [
                "ffmpeg", "-y", "-i", str(src_path),
                "-vn", "-c:a", "libopus",
                "-b:a", cfg.rip_opus_bitrate,
                "-threads", "0",
                str(out_path),
            ]

        log_step("Extracting", f"{src_path.name} -> {out_path.name}")
        ret, _, err = run_cmd(ffmpeg_args, dry_run=dry_run)
        if ret == 0 and not dry_run:
            log_success(f"Exported: {out_path.name}")
        elif ret != 0:
            log_error(f"Failed extracting {src_path.name}: {err}")


def cmd_local_player(cfg: CoreXConfig, music_path: Optional[str] = None, dry_run: bool = False):
    """Instant fuzzy-browsing of the local Music library with ffprobe live tag preview."""
    if not check_tool("mpv"):
        log_error("'mpv' is required for local playback.")
        return

    search_root = Path(music_path or cfg.music_dir).expanduser().resolve()
    if not search_root.exists():
        search_root = Path.cwd()

    log_info(f"Scanning music library at '{search_root}'...")
    audio_extensions = {".flac", ".opus", ".mp3", ".m4a", ".ogg", ".wav", ".alac", ".aac"}
    audio_files: List[Path] = []
    for root, _, files in os.walk(search_root):
        for f in files:
            p = Path(root) / f
            if p.suffix.lower() in audio_extensions:
                audio_files.append(p)

    if not audio_files:
        log_warn(f"No audio files found under '{search_root}'.")
        return

    if not sys.stdin.isatty() or dry_run:
        print(f"Found {len(audio_files)} audio tracks in {search_root}:")
        for af in audio_files[:15]:
            print(f" • {af.relative_to(search_root)}")
        if len(audio_files) > 15:
            print(f" ... and {len(audio_files) - 15} more.")
        return

    items = [str(f.relative_to(search_root)) for f in audio_files]

    preview_script = f"ffprobe -v error -show_entries format=duration,bit_rate:format_tags=artist,title,album -of default=noprint_wrappers=1 '{search_root}/'{{1}} 2>/dev/null || file '{search_root}/'{{1}}"

    selected = run_fzf(
        items,
        prompt="cx music > ",
        preview_cmd=preview_script,
        header=f"Library: {search_root} ({len(audio_files)} tracks)",
    )
    if not selected:
        return

    chosen_file = search_root / selected[0]
    log_success(f"Playing track: {chosen_file.name}")
    run_cmd(["mpv", str(chosen_file)], dry_run=dry_run)


