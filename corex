def builtin_fetch(extra_args: Optional[List[str]] = None):
    args = extra_args or []
    if ("-f" in args or "--fast" in args or "--fastfetch" in args) and shutil.which("fastfetch"):
        subprocess.run(["fastfetch"])
        return

    distro_name = "Linux"
    try:
        if Path("/etc/os-release").exists():
            for line in Path("/etc/os-release").read_text().splitlines():
                if line.startswith("PRETTY_NAME="):
                    distro_name = line.split("=", 1)[1].strip().strip('"')
                    break
    except Exception:
        pass

    uname = os.uname()
    u = os.environ.get("USER", "user")
    host_str = f"{u}@{uname.nodename}"

    uptime_sec = 0
    try:
        with open("/proc/uptime") as f:
            uptime_sec = float(f.readline().split()[0])
    except Exception:
        pass
    hrs, rem = divmod(int(uptime_sec), 3600)
    mins, _ = divmod(rem, 60)
    days, hrs = divmod(hrs, 24)
    up_str = f"{days}d {hrs}h {mins}m" if days > 0 else f"{hrs}h {mins}m"

    cpu_name = "Unknown CPU"
    try:
        if Path("/proc/cpuinfo").exists():
            for line in Path("/proc/cpuinfo").read_text().splitlines():
                if "model name" in line:
                    cpu_name = line.split(":", 1)[1].strip()
                    break
    except Exception:
        pass

    gpu_name = "Integrated / Unknown"
    vram_str = ""
    try:
        res = subprocess.run(
            ["nvidia-smi", "--query-gpu=name,memory.total,memory.free", "--format=csv,noheader"],
            capture_output=True, text=True, timeout=1.5
        )
        if res.returncode == 0 and res.stdout.strip():
            parts = [p.strip() for p in res.stdout.strip().split(",")]
            if len(parts) >= 3:
                gpu_name = parts[0]
                tot_v = int(parts[1].replace("MiB", "").strip())
                free_v = int(parts[2].replace("MiB", "").strip())
                vram_str = f" ({tot_v - free_v} / {tot_v} MiB)"
    except Exception:
        pass

    ram_str = "Unknown"
    try:
        with open("/proc/meminfo") as f:
            mem = f.read()
            m_tot = int(re.search(r"MemTotal:\s+(\d+)", mem).group(1)) // 1024
            m_avail = int(re.search(r"MemAvailable:\s+(\d+)", mem).group(1)) // 1024
            m_used = m_tot - m_avail
            pct = int((m_used / m_tot) * 100) if m_tot else 0
            ram_str = f"{m_used} MiB / {m_tot} MiB ({pct}%)"
    except Exception:
        pass

    pm_count = 0
    pm_name = "pacman"
    if shutil.which("pacman"):
        res = subprocess.run("pacman -Qq 2>/dev/null | wc -l", shell=True, capture_output=True, text=True, timeout=1.5)
        if res.stdout.strip().isdigit():
            pm_count = int(res.stdout.strip())
    elif shutil.which("dpkg"):
        pm_name = "dpkg"
        res = subprocess.run("dpkg-query -f '.\n' -W 2>/dev/null | wc -l", shell=True, capture_output=True, text=True, timeout=1.5)
        if res.stdout.strip().isdigit():
            pm_count = int(res.stdout.strip())
    elif shutil.which("rpm"):
        pm_name = "rpm"
        res = subprocess.run("rpm -qa 2>/dev/null | wc -l", shell=True, capture_output=True, text=True, timeout=1.5)
        if res.stdout.strip().isdigit():
            pm_count = int(res.stdout.strip())

    flatpak_count = 0
    if shutil.which("flatpak"):
        res = subprocess.run("flatpak list --app 2>/dev/null | wc -l", shell=True, capture_output=True, text=True, timeout=1.5)
        if res.stdout.strip().isdigit():
            flatpak_count = int(res.stdout.strip())

    pkg_parts = []
    if pm_count:
        pkg_parts.append(f"{pm_count} ({pm_name})")
    if flatpak_count:
        pkg_parts.append(f"{flatpak_count} (flatpak)")
    pkg_str = ", ".join(pkg_parts) if pkg_parts else "N/A"

    shell_str = os.environ.get("SHELL", "bash").split("/")[-1]
    desktop_str = os.environ.get("XDG_CURRENT_DESKTOP", os.environ.get("DESKTOP_SESSION", "Wayland/TTY"))

    pw_status = "Inactive"
    try:
        res = subprocess.run(["systemctl", "--user", "is-active", "pipewire"], capture_output=True, text=True, timeout=1)
        if res.stdout.strip() == "active":
            pw_status = "PipeWire (Active)"
    except Exception:
        pass

    c1 = "\033[38;2;137;180;250m"
    c2 = "\033[38;2;180;190;254m"
    c3 = "\033[38;2;203;166;247m"
    c4 = "\033[38;2;148;226;213m"
    rst = "\033[0m"
    bld = "\033[1m"
    dim = "\033[2m"

    logo = [
        f"{c1}   ______                     _  __{rst}",
        f"{c1}  / ____/____   _____ ___     | |/ /{rst}",
        f"{c2} / /    / __ \\ / ___// _ \\    |   / {rst}",
        f"{c2}/ /___ / /_/ // /   /  __/   /   |  {rst}",
        f"{c3}\\____/ \\____//_/    \\___/   /_/|_|  {c4}v3.0{rst}",
        f"{dim}──────────────────────────────────────────{rst}",
    ]

    info = [
        f"{bld}{c1}{host_str}{rst}",
        f"{dim}──────────────────────────────{rst}",
        f"{bld}{c1}OS:{rst}        {distro_name} {uname.machine}",
        f"{bld}{c1}Kernel:{rst}    {uname.release}",
        f"{bld}{c1}Uptime:{rst}    {up_str}",
        f"{bld}{c1}Packages:{rst}  {pkg_str}",
        f"{bld}{c1}Shell:{rst}     {shell_str}",
        f"{bld}{c1}DE/WM:{rst}     {desktop_str}",
        f"{bld}{c1}CPU:{rst}       {cpu_name}",
        f"{bld}{c1}GPU:{rst}       {gpu_name}{vram_str}",
        f"{bld}{c1}Memory:{rst}    {ram_str}",
        f"{bld}{c1}Audio:{rst}     {pw_status}",
    ]

    dots1 = "".join([f"\033[38;5;{c}m●   " for c in [1, 2, 3, 4, 5, 6, 7]])
    dots2 = "".join([f"\033[38;5;{c}m●   " for c in [9, 10, 11, 12, 13, 14, 15]])

    term_cols = shutil.get_terminal_size((80, 24)).columns
    if term_cols < 90:
        print()
        for line in logo:
            print(f"  {line}")
        print()
        for line in info:
            print(f"  {line}")
        print(f"\n  {dots1}{rst}")
        print(f"  {dots2}{rst}\n")
    else:
        left_col = logo + [
            "",
            f"      {dots1}{rst}",
            f"      {dots2}{rst}",
            "",
            "",
            "",
        ]
        logo_w = 46
        print()
        for i in range(len(info)):
            l = left_col[i] if i < len(left_col) else ""
            vis_l = re.sub(r"\033\[[0-9;]*m", "", l)
            pad = " " * max(0, logo_w - len(vis_l))
            r = info[i]
            print(f"  {l}{pad}{r}")
        print()


