            print(f" {Style.BOLD}Calculated:{Style.RESET}    {Style.GREEN}{flag}{Style.RESET} ({free} MiB free VRAM / {tot} MiB total)")

    cmd_preview = spec.command[:60] + ("..." if len(spec.command) > 60 else "")
    print(f" {Style.BOLD}Execution:{Style.RESET}     {Style.CYAN}{cmd_preview}{Style.RESET}")
    print(box_footer())

