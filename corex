# ---------------------------------------------------------------------------
# ANSI Terminal Styling & Rendering Engine
# ---------------------------------------------------------------------------
class Style:
    RESET = "\033[0m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    ITALIC = "\033[3m"
    UNDERLINE = "\033[4m"

    # Foreground colors (24-bit / 256 / 16 color compatible)
    RED = "\033[38;5;196m"
    GREEN = "\033[38;5;46m"
    YELLOW = "\033[38;5;220m"
    BLUE = "\033[38;5;39m"
    MAGENTA = "\033[38;5;201m"
    CYAN = "\033[38;5;51m"
    WHITE = "\033[38;5;231m"
    GRAY = "\033[38;5;244m"
    DARK_GRAY = "\033[38;5;238m"
    ORANGE = "\033[38;5;208m"
    PURPLE = "\033[38;5;141m"
    TEAL = "\033[38;5;44m"

    # Background colors
    BG_DARK = "\033[48;5;235m"
    BG_BLUE = "\033[48;5;24m"
    BG_RED = "\033[48;5;52m"
    BG_GREEN = "\033[48;5;22m"

    @classmethod
    def strip(cls, text: str) -> str:
        """Remove ANSI escape sequences."""
        return re.sub(r"\033\[[0-9;]*m", "", text)


def print_banner(dry_run: bool = False):
    dry_badge = f" {Style.YELLOW}[DRY-RUN MODE]{Style.RESET}" if dry_run else ""
    banner = f"""
{Style.CYAN}{Style.BOLD}   ______                     _  __
  / ____/____   _____ ___     | |/ /
 / /    / __ \\ / ___// _ \\    |   / 
/ /___ / /_/ // /   /  __/   /   |  
\\____/ \\____//_/    \\___/   /_/|_|  {Style.GRAY}v{VERSION}{dry_badge}
{Style.DARK_GRAY}─────────────────────────────────────────────────────{Style.RESET}"""
    print(banner)


def log_info(msg: str):
    print(f"{Style.BLUE}{Style.BOLD}◈{Style.RESET} {msg}")


def log_success(msg: str):
    print(f"{Style.GREEN}{Style.BOLD}✔{Style.RESET} {msg}")


def log_warn(msg: str):
    print(f"{Style.YELLOW}{Style.BOLD}▲{Style.RESET} {msg}")


def log_error(msg: str):
    print(f"{Style.RED}{Style.BOLD}✖{Style.RESET} {msg}", file=sys.stderr)


def log_step(step: str, detail: str):
    print(f"{Style.CYAN}{Style.BOLD}λ{Style.RESET} {Style.BOLD}{step}:{Style.RESET} {Style.GRAY}{detail}{Style.RESET}")


def box_header(title: str, width: int = 68) -> str:
    line = "═" * max(0, width - len(title) - 4)
    return f"{Style.CYAN}╔═ {Style.BOLD}{Style.WHITE}{title}{Style.RESET}{Style.CYAN} {line}╗{Style.RESET}"


def box_footer(width: int = 68) -> str:
    return f"{Style.CYAN}╚{'═' * max(0, width - 2)}╝{Style.RESET}"


