class CommandSpec:
    __slots__ = (
        "id",
        "category",
        "description",
        "command",
        "preview_cmd",
        "requires_sudo",
        "confirm",
        "deps",
    )

    def __init__(
        self,
        id: str,
        category: str,
        description: str,
        command: str,
        preview_cmd: str = "",
        requires_sudo: bool = False,
        confirm: bool = False,
        deps: Optional[List[str]] = None,
    ):
        self.id = id
        self.category = category
        self.description = description
        self.command = command
        self.preview_cmd = preview_cmd
        self.requires_sudo = requires_sudo
        self.confirm = confirm
        self.deps = deps if deps is not None else []


