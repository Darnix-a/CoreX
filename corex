def set_config_theme(theme_name: str, config_path: Optional[Path] = None) -> bool:
    path = config_path or CONFIG_FILE
    if not path.exists():
        if DEFAULT_CONFIG_TEMPLATE.exists():
            path.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy(DEFAULT_CONFIG_TEMPLATE, path)
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(f"[general]\ntheme = \"{theme_name}\"\n\n[commands]\n", encoding="utf-8")
            return True

    text = path.read_text(encoding="utf-8")
    if re.search(r'^\s*theme\s*=\s*["\'].*?["\']', text, flags=re.MULTILINE):
        new_text = re.sub(r'^\s*theme\s*=\s*["\'].*?["\']', f'theme = "{theme_name}"', text, flags=re.MULTILINE)
    elif re.search(r'^\s*\[general\]', text, flags=re.MULTILINE):
        new_text = re.sub(r'(^\s*\[general\].*?\n)', rf'\1theme = "{theme_name}"\n', text, count=1, flags=re.MULTILINE)
    else:
        new_text = f'[general]\ntheme = "{theme_name}"\n\n' + text

    path.write_text(new_text, encoding="utf-8")
    return True


