def detect_package_manager() -> Tuple[Optional[str], Optional[str], Optional[str], str]:
    """
    Detects the active package manager and returns:
    (pm_name, install_cmd_prefix, update_cmd, distro_family)
    Supports Arch, Debian/Ubuntu, Fedora/RHEL, openSUSE, Alpine, Void.
    """
    if shutil.which("paru"):
        return "paru", "paru -Sy --needed", "paru -Syu", "arch"
    if shutil.which("yay"):
        return "yay", "yay -Sy --needed", "yay -Syu", "arch"
    if shutil.which("pacman"):
        return "sudo pacman", "sudo pacman -Sy --needed", "sudo pacman -Syu", "arch"
    if shutil.which("dnf5"):
        return "sudo dnf5", "sudo dnf5 install -y", "sudo dnf5 upgrade", "fedora"
    if shutil.which("dnf"):
        return "sudo dnf", "sudo dnf install -y", "sudo dnf upgrade", "fedora"
    if shutil.which("apt-get"):
        return "sudo apt-get", "sudo apt-get install -y", "sudo apt-get update && sudo apt-get upgrade -y", "debian"
    if shutil.which("apt"):
        return "sudo apt", "sudo apt install -y", "sudo apt update && sudo apt upgrade -y", "debian"
    if shutil.which("zypper"):
        return "sudo zypper", "sudo zypper install -y", "sudo zypper update", "suse"
    if shutil.which("apk"):
        return "sudo apk", "sudo apk add", "sudo apk upgrade", "alpine"
    if shutil.which("xbps-install"):
        return "sudo xbps-install", "sudo xbps-install -S", "sudo xbps-install -Su", "void"
    return None, None, None, "unknown"


