def generate_zsh_completions(cfg: CoreXConfig) -> str:
    lines = [
        "#compdef cx corex",
        "_cx() {",
        "    local -a commands",
        "    commands=(",
    ]
    for cid, spec in cfg.commands.items():
        clean_desc = spec.description.replace("'", "").replace(":", "-")
        lines.append(f"        '{cid}:{clean_desc}'")
    lines.append("        'theme:Interactive theme switcher'")
    lines.append("        'pin:Pin an action to favorites'")
    lines.append("        'unpin:Unpin an action from favorites'")
    lines.append("        'pinned:List pinned favorites'")
    lines.extend([
        "    )",
        "    _arguments -C \\",
        "        '(-h --help)'{-h,--help}'[Show help]' \\",
        "        '(-v --version)'{-v,--version}'[Show version]' \\",
        "        '--dry-run[Preview commands]' \\",
        "        '--bg[Detach command in background]' \\",
        "        '--pinned[List pinned favorites]' \\",
        "        '--list[List all commands]' \\",
        "        '1: :->command' \\",
        "        '*:: :->args'",
        "    case $state in",
        "        command) _describe -t commands 'cx commands' commands ;;",
        "    esac",
        "}",
        "_cx \"$@\"",
    ])
    return "\n".join(lines)


class ParsedArgs:
    __slots__ = ("command", "args", "help", "version", "dry_run", "bg", "yes", "list", "no_color", "no_cache", "config", "select", "select_raw")

    def __init__(self):
        self.command: Optional[str] = None
        self.args: List[str] = []
        self.help: bool = False
        self.version: bool = False
        self.dry_run: bool = False
        self.bg: bool = False
        self.yes: bool = False
        self.list: bool = False
        self.no_color: bool = False
        self.no_cache: bool = False
        self.config: Optional[Path] = None


def parse_cli_args(argv: List[str]) -> Tuple[ParsedArgs, List[str]]:
    parsed = ParsedArgs()
    unknown: List[str] = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if parsed.command in ("kiro", "__kiro_run") or (
            parsed.command == "bg" and parsed.args and parsed.args[0] == "run"
        ):
            parsed.args.extend(argv[i:])
            break
        if arg == "--" and parsed.command is not None:
            parsed.args.extend(argv[i + 1:])
            break
        if arg in ("-h", "--help"):
            if parsed.command is not None:
                parsed.args.append(arg)
            else:
                parsed.help = True
        elif arg in ("-v", "--version"):
            parsed.version = True
        elif arg == "--dry-run":
            parsed.dry_run = True
        elif arg == "--bg":
            parsed.bg = True
        elif arg in ("-y", "--yes"):
            parsed.yes = True
        elif arg in ("--no-cache", "--reload"):
            parsed.no_cache = True
        elif arg == "--list":
            if parsed.command is not None:
                parsed.args.append("--list")
            else:
                parsed.list = True
        elif arg == "--no-color":
            parsed.no_color = True
        elif arg in ("--pinned", "--favorites", "--fav"):
            parsed.command = "pinned"
        elif arg == "--config":
            if i + 1 < len(argv):
                parsed.config = Path(argv[i + 1])
                i += 1
        elif not arg.startswith("-"):
            if parsed.command is None:
                parsed.command = arg
            else:
                parsed.args.append(arg)
        else:
            unknown.append(arg)
        i += 1
    return parsed, unknown


