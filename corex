    print(f"  • {Style.BOLD}Configuration:{Style.RESET}   {default_str}")


def builtin_model_chooser(cfg: CoreXConfig, extra_args: Optional[List[str]] = None):
    """Interactive AI Model Chooser, Hardware Telemetry Profiler, and Downloader."""
    import json
    import urllib.request

    args = extra_args or []

    ensure_ollama_ready(cfg)

    hw = get_hardware_profile()
    api_url = cfg.ollama_url.rstrip("/")

    installed_models = {}
    try:
        req = urllib.request.Request(f"{api_url}/api/tags", headers={"User-Agent": "CoreX"})
        with urllib.request.urlopen(req, timeout=2.0) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            for m in data.get("models", []):
                name = m.get("name", "")
                if name:
                    installed_models[name] = m
    except Exception:
        pass

    if "--summary" in args or "--list" in args:
        print(f"\n{box_header('AI HARDWARE TELEMETRY & MODEL COMPATIBILITY', color=Style.CYAN)}")
        print(f" {Style.BOLD}GPU Hardware:{Style.RESET}     {hw['gpu_name']} ({hw['vram_total_mb']/1024:.1f} GB VRAM, {hw['vram_free_mb']/1024:.1f} GB Free)")
        print(f" {Style.BOLD}System Memory:{Style.RESET}    {hw['ram_total_mb']/1024:.1f} GB Total ({hw['ram_avail_mb']/1024:.1f} GB Available)")
        print(f" {Style.BOLD}Active Copilot:{Style.RESET}   {Style.GREEN}{cfg.ollama_model}{Style.RESET}")
        print(f"{Style.DARK_GRAY}{'─' * 70}{Style.RESET}")
        print(f" {Style.BOLD}{'MODEL':<24} {'SIZE':<9} {'TIER':<14} {'STATUS':<12} {'EXECUTION FIT'}{Style.RESET}")
        print(f" {Style.DARK_GRAY}{'─' * 70}{Style.RESET}")
        for cat in MODEL_CATALOG:
            name = cat["name"]
            rating = rate_model_compatibility(cat["vram_mb"], hw)
            is_inst = is_model_installed(name, installed_models)
            status = "Installed" if is_inst else "Available"
            is_act = (name == cfg.ollama_model)
            act_mark = " ★" if is_act else ""
            print(f" {name:<24} {cat['disk_gb']:>4.1f} GB   {rating['badge']:<14} {status + act_mark:<12} {rating['fit']}")
        print(box_footer(color=Style.CYAN))
        return

    catalog_names = set(m["name"] for m in MODEL_CATALOG)
    all_models = list(MODEL_CATALOG)

    for name, m in installed_models.items():
        if name not in catalog_names:
            sz_gb = m.get("size", 0) / (1024**3)
            all_models.insert(0, {
                "name": name,
                "params": "Local",
                "disk_gb": round(sz_gb, 1),
                "vram_mb": int(sz_gb * 1200),
                "category": "Custom Installed",
                "desc": "Custom user-downloaded Ollama model.",
            })

    def sort_key(item):
        name = item["name"]
        is_inst = is_model_installed(name, installed_models)
        is_act = (name == cfg.ollama_model)
        if is_act:
            return (0, name)
        elif is_inst:
            return (1, name)
        else:
            return (2, name)

    all_models.sort(key=sort_key)

    items = []
    for m in all_models:
        name = m["name"]
        rating = rate_model_compatibility(m["vram_mb"], hw)
        is_inst = is_model_installed(name, installed_models)
        tag = "[INSTALLED]" if is_inst else "[AVAILABLE]"
        act_star = "★ ACTIVE" if name == cfg.ollama_model else "        "
        line = f"{name:<24} {rating['badge']:<15} {tag:<12} {act_star} {m['disk_gb']:>4.1f} GB  {m['category']:<16} {m['desc']}"
        items.append(line)

    self_exe = os.path.abspath(sys.argv[0])
    preview_cmd = f"python3 '{self_exe}' __preview_model {{1}}"

    header = (
        f"GPU: {hw['gpu_name']} ({hw['vram_total_mb']/1024:.1f} GB VRAM) | RAM: {hw['ram_total_mb']/1024:.1f} GB | Active: {cfg.ollama_model}\n"
        "ENTER: Activate / Download   |   CTRL-D: Delete Model   |   CTRL-T: Test Prompt"
    )

    selected = run_fzf(
        items,
        prompt="Select AI Model > ",
        preview_cmd=preview_cmd,
        header=header,
        extra_args=["--expect=ctrl-d,ctrl-t", "--delimiter= "]
    )

    if not selected:
        return

    if len(selected) >= 2:
        key = selected[0].strip()
        chosen_line = selected[1].strip()
    else:
        key = ""
        chosen_line = selected[0].strip()

    chosen_name = chosen_line.split()[0].strip()
    is_installed = is_model_installed(chosen_name, installed_models)

    if key == "ctrl-d":
        if not is_installed:
            log_warn(f"Model '{chosen_name}' is not downloaded, cannot delete.")
            return
        try:
            print(f"\n{Style.YELLOW}{Style.BOLD}⚠️  Delete local model '{chosen_name}' to free disk space? [y/N]: {Style.RESET}", end="", flush=True)
            ans = input().strip().lower()
            if ans in ("y", "yes"):
                log_info(f"Removing model '{chosen_name}' via Ollama...")
                subprocess.run(["ollama", "rm", chosen_name])
                log_success(f"Model '{chosen_name}' removed from local storage.")
        except (KeyboardInterrupt, EOFError):
            print()
        return

    if key == "ctrl-t":
        if not is_installed:
            log_warn(f"Model '{chosen_name}' must be downloaded before running a test.")
            return
        log_info(f"Testing model '{chosen_name}' with test prompt...")
        temp_cfg = CoreXConfig()
        temp_cfg.ollama_url = cfg.ollama_url
        temp_cfg.ollama_model = chosen_name
        builtin_ai_ask("Explain what your architecture excels at in 1 sentence.", temp_cfg)
        return

    if is_installed:
        set_config_ai_model(chosen_name)
        cfg.ollama_model = chosen_name
        print(f"\n{box_header('ACTIVE AI MODEL UPDATED', color=Style.GREEN)}")
        print(f" Model:          {Style.BOLD}{chosen_name}{Style.RESET}")
        print(f" Status:         {Style.GREEN}Ready to use{Style.RESET}")
        print(f" Configuration:  Updated ~/.config/corex/config.toml")
        print(box_footer(color=Style.GREEN))
        log_success(f"Active AI model set to '{chosen_name}' for cx ask / cx ai.")
        print(f" {Style.GRAY}Tip: Run {Style.BOLD}cx ask \"your prompt\"{Style.RESET}{Style.GRAY} or {Style.BOLD}cx ai{Style.RESET}{Style.GRAY} to chat with this model.{Style.RESET}\n")
    else:
        cat_spec = next((m for m in MODEL_CATALOG if m["name"] == chosen_name), None)
        sz_str = f"~{cat_spec['disk_gb']} GB" if cat_spec else ""
        print(f"\n{box_header('DOWNLOAD MODEL', color=Style.CYAN)}")
        print(f" Model:          {Style.BOLD}{chosen_name}{Style.RESET}")
        if sz_str:
            print(f" Download Size:  {sz_str}")
        print(f" Storage Path:   ~/.ollama/models")
        print(box_footer(color=Style.CYAN))

        try:
            print(f" {Style.BOLD}Download '{chosen_name}' and set as active default? [Y/n]: {Style.RESET}", end="", flush=True)
            ans = input().strip().lower()
            if ans in ("", "y", "yes"):
                log_info(f"Downloading '{chosen_name}' via Ollama...")
                res = subprocess.run(["ollama", "pull", chosen_name])
                if res.returncode == 0:
                    set_config_ai_model(chosen_name)
                    cfg.ollama_model = chosen_name
                    print(f"\n{box_header('ACTIVE AI MODEL UPDATED', color=Style.GREEN)}")
                    print(f" Model:          {Style.BOLD}{chosen_name}{Style.RESET}")
                    print(f" Status:         {Style.GREEN}Downloaded & Active{Style.RESET}")
                    print(f" Configuration:  Updated ~/.config/corex/config.toml")
                    print(box_footer(color=Style.GREEN))
                    log_success(f"Model '{chosen_name}' installed and activated as default!")
                    print(f" {Style.GRAY}Tip: Run {Style.BOLD}cx ask \"your prompt\"{Style.RESET}{Style.GRAY} or {Style.BOLD}cx ai{Style.RESET}{Style.GRAY} to chat with this model.{Style.RESET}\n")
                else:
                    log_error(f"Failed pulling '{chosen_name}'. Check network connection.")
        except (KeyboardInterrupt, EOFError):
            print()


def builtin_model_symlink(cfg: CoreXConfig):
    models_dir = cfg.comfyui_path / "models"
    if not models_dir.exists():
        log_error(f"ComfyUI models folder not found at {models_dir}")
        return

    safetensors = list(Path.cwd().glob("*.safetensors")) + list((Path.home() / "Downloads").glob("*.safetensors"))
    if not safetensors:
        log_warn("No .safetensors files found in cwd or ~/Downloads.")
        return

    chosen_file = run_fzf([str(f) for f in safetensors], prompt="Select .safetensors model > ")
    if not chosen_file:
        return
    src = Path(chosen_file[0])

    subfolders = [p for p in models_dir.iterdir() if p.is_dir()]
    chosen_dest = run_fzf([str(d.relative_to(models_dir)) for d in subfolders], prompt="Select ComfyUI model category > ")
    if not chosen_dest:
        return

    dest_dir = models_dir / chosen_dest[0]
    link_target = dest_dir / src.name
    try:
        link_target.symlink_to(src.resolve())
        log_success(f"Symlinked: {src.name} -> {chosen_dest[0]}/{src.name}")
    except FileExistsError:
        log_warn(f"Symlink already exists in {chosen_dest[0]}")
    except Exception as e:
        log_error(f"Symlink failed: {e}")


def builtin_stream_yt(video: bool = False, query: Optional[str] = None, dry_run: bool = False):
    if not shutil.which("yt-dlp") or not shutil.which("mpv"):
        log_error("yt-dlp and mpv are required for stream-yt.")
        return

    q = query
    if not q:
        if not sys.stdin.isatty():
            return
        print(f"{Style.CYAN}{Style.BOLD}Search YouTube:{Style.RESET} ", end="", flush=True)
        try:
            q = input().strip()
        except (KeyboardInterrupt, EOFError):
            return
    if not q:
        return

    if q.startswith("http://") or q.startswith("https://"):
        cmd = ["mpv"] + (["--hwdec=auto"] if video else ["--no-video", "--ytdl-format=bestaudio/best"]) + [q]
        if dry_run:
            print(f"{Style.YELLOW}[DRY-RUN]{Style.RESET} {' '.join(cmd)}")
        else:
            subprocess.run(cmd)
        return

    log_info(f"Searching YouTube for '{q}'...")
    res = subprocess.run(
        ["yt-dlp", "--flat-playlist", "--default-search", "ytsearch25", "--print", "%(id)s\t%(duration_string)s\t%(uploader)s\t%(title)s", q],
        capture_output=True,
        text=True,
    )
    lines = [l.strip() for l in res.stdout.strip().splitlines() if l.strip()]
    if not lines:
        log_warn("No results found.")
        return

    fzf_items = []
    for l in lines:
        parts = l.split("\t")
        vid_id = parts[0]
        dur = parts[1] if len(parts) > 1 and parts[1] != "NA" else "--:--"
        up = parts[2] if len(parts) > 2 else "Unknown"
        title = parts[3] if len(parts) > 3 else "Untitled"
        fzf_items.append(f"https://www.youtube.com/watch?v={vid_id}\t{dur:<8}\t{up:<22}\t{title}")

    extra = [
        "--delimiter=\t",
        "--with-nth=2,3,4",
        "--header=ENTER: Play Stream | CTRL-Y: Copy URL",
        "--bind=ctrl-y:execute-silent(echo -n {1} | wl-copy || echo -n {1} | xclip -selection clipboard)",
    ]

    selected = run_fzf(fzf_items, prompt="stream > ", extra_args=extra)
    if not selected:
        return

    url = selected[0].split("\t")[0]
    title = selected[0].split("\t")[-1]
    log_success(f"Streaming: {title}")
    cmd = ["mpv"] + (["--hwdec=auto"] if video else ["--no-video", "--ytdl-format=bestaudio/best"]) + [url]
    if dry_run:
        print(f"{Style.YELLOW}[DRY-RUN]{Style.RESET} {' '.join(cmd)}")
    else:
        subprocess.run(cmd)


