def rate_model_compatibility(vram_req_mb: int, hw: Dict[str, Any]) -> Dict[str, Any]:
    """Calculates hardware compatibility tier, color badge, and tok/s estimation."""
    vram = hw.get("vram_total_mb", 0)
    ram = hw.get("ram_total_mb", 0)

    if vram > 0:
        ratio = vram_req_mb / vram
        if ratio <= 0.35:
            return {
                "tier": "BLAZING",
                "badge": "🟢 BLAZING",
                "color": Style.GREEN,
                "fit": "100% GPU VRAM",
                "est_speed": "~85-130 tok/s",
                "note": f"Fits effortlessly in VRAM ({ratio*100:.0f}% used). Blazing instant generation.",
                "playable": True,
            }
        elif ratio <= 0.80:
            return {
                "tier": "OPTIMAL",
                "badge": "🟢 OPTIMAL",
                "color": Style.GREEN,
                "fit": "100% GPU VRAM",
                "est_speed": "~45-75 tok/s",
                "note": f"Runs fully accelerated inside GPU VRAM ({ratio*100:.0f}% used). Smooth & fast.",
                "playable": True,
            }
        elif ratio <= 0.98:
            return {
                "tier": "TIGHT FIT",
                "badge": "🟡 TIGHT",
                "color": Style.YELLOW,
                "fit": "100% GPU VRAM",
                "est_speed": "~25-35 tok/s",
                "note": f"Fits inside VRAM ({ratio*100:.0f}% used), but long context may cause offload.",
                "playable": True,
            }
        elif vram_req_mb <= (vram + ram * 0.70):
            spill_gb = (vram_req_mb - vram) / 1024
            return {
                "tier": "RAM OFFLOAD",
                "badge": "🟠 RAM-SPLIT",
                "color": Style.YELLOW,
                "fit": f"VRAM + {spill_gb:.1f}GB RAM",
                "est_speed": "~8-18 tok/s",
                "note": f"Exceeds VRAM by {spill_gb:.1f}GB. Offloaded layers run on CPU/RAM at reduced speed.",
                "playable": True,
            }
        else:
            return {
                "tier": "TOO HEAVY",
                "badge": "🔴 TOO HEAVY",
                "color": Style.RED,
                "fit": "Exceeds Capacity",
                "est_speed": "<3 tok/s",
                "note": f"Model requires ~{vram_req_mb/1024:.1f}GB VRAM/RAM. Will cause thrashing or crash.",
                "playable": False,
            }
    else:
        # CPU-only machine
        if vram_req_mb <= (ram * 0.45):
            return {
                "tier": "CPU OPTIMAL",
                "badge": "🟡 CPU OK",
                "color": Style.YELLOW,
                "fit": "100% System RAM",
                "est_speed": "~15-25 tok/s",
                "note": "Runs in system RAM on CPU. Solid performance for lightweight model.",
                "playable": True,
            }
        elif vram_req_mb <= (ram * 0.75):
            return {
                "tier": "CPU HEAVY",
                "badge": "🟠 CPU HEAVY",
                "color": Style.YELLOW,
                "fit": "Heavy System RAM",
                "est_speed": "~5-12 tok/s",
                "note": "High RAM utilization on CPU. Usable but slower token generation.",
                "playable": True,
            }
        else:
            return {
                "tier": "TOO HEAVY",
                "badge": "🔴 TOO HEAVY",
                "color": Style.RED,
                "fit": "Exceeds RAM",
                "est_speed": "<2 tok/s",
                "note": "Model size exceeds available physical RAM.",
                "playable": False,
            }


def is_model_installed(target_name: str, installed_models: Dict[str, Any]) -> bool:
    """Checks if a target model is present in installed Ollama models, respecting tags."""
    if not target_name or not installed_models:
        return False
    if target_name in installed_models:
        return True
    if ":" not in target_name and f"{target_name}:latest" in installed_models:
        return True
    if target_name.endswith(":latest") and target_name[:-7] in installed_models:
        return True
    return False


def set_config_ai_model(model_name: str):
    """Persists chosen model to ~/.config/corex/config.toml under [ai]."""
    cfg_file = CONFIG_FILE
    if not cfg_file.exists():
        return
    text = cfg_file.read_text(encoding="utf-8")
    import re
    if re.search(r'^\s*model\s*=\s*".*?"', text, re.MULTILINE):
        new_text = re.sub(r'^\s*model\s*=\s*".*?"', f'model = "{model_name}"', text, flags=re.MULTILINE)
    elif "[ai]" in text:
        new_text = text.replace("[ai]", f'[ai]\nmodel = "{model_name}"')
    else:
        new_text = text + f'\n[ai]\nmodel = "{model_name}"\n'
    cfg_file.write_text(new_text, encoding="utf-8")


