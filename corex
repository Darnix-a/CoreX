def _parse_wifi_scan() -> List[Dict[str, Any]]:
    """Scan and parse nearby Wi-Fi access points using nmcli."""
    res = subprocess.run(
        ["nmcli", "-t", "-f", "IN-USE,SSID,BSSID,CHAN,FREQ,RATE,SIGNAL,BARS,SECURITY", "dev", "wifi", "list", "--rescan", "auto"],
        capture_output=True, text=True
    )
    networks = []
    seen = set()
    for line in res.stdout.splitlines():
        if not line.strip():
            continue
        parts = re.split(r'(?<!\\):', line)
        parts = [p.replace('\\:', ':').strip() for p in parts]
        if len(parts) >= 9:
            in_use = (parts[0] == "*")
            ssid = parts[1] or "<Hidden Network>"
            bssid = parts[2]
            chan = parts[3]
            freq = parts[4]
            rate = parts[5]
            signal_pct = parts[6]
            bars = parts[7]
            sec = parts[8] if parts[8] else "Open (No Security)"
            key = (ssid, bssid)
            if key not in seen:
                seen.add(key)
                networks.append({
                    "in_use": in_use,
                    "ssid": ssid,
                    "bssid": bssid,
                    "chan": chan,
                    "freq": freq,
                    "rate": rate,
                    "signal": signal_pct,
                    "bars": bars,
                    "security": sec,
                })
    return networks


def render_wifi_preview(target_ssid: str, target_bssid: str):
    """Render detailed Wi-Fi access point diagnostics in fzf preview window."""
    networks = _parse_wifi_scan()
    match = None
    for n in networks:
        if (target_bssid and n["bssid"].lower() == target_bssid.lower()) or (n["ssid"] == target_ssid):
            match = n
            break

    if not match:
        print(box_header("WI-FI ACCESS POINT DETAILS"))
        print(f"  {Style.YELLOW}No live telemetry for SSID: {target_ssid}{Style.RESET}")
        print(box_footer())
        return

    sig_int = int(match["signal"]) if str(match["signal"]).isdigit() else 0
    bar_width = 15
    filled = int(bar_width * (sig_int / 100.0))
    bar_col = Style.GREEN if sig_int >= 70 else (Style.YELLOW if sig_int >= 40 else Style.RED)
    bar_str = f"{bar_col}{'█' * filled}{Style.DARK_GRAY}{'░' * (bar_width - filled)}{Style.RESET}"

    saved_cons = subprocess.run(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show"], capture_output=True, text=True).stdout
    is_saved = any(f"{match['ssid']}:802-11-wireless" in l for l in saved_cons.splitlines())

    print(box_header("WI-FI ACCESS POINT DETAILS"))
    status_tag = f"{Style.GREEN}{Style.BOLD}● CONNECTED (Active Gateway){Style.RESET}" if match["in_use"] else f"{Style.GRAY}Available for connection{Style.RESET}"
    saved_tag = f"{Style.CYAN}Yes (Auto-reconnect profile configured){Style.RESET}" if is_saved else f"{Style.DARK_GRAY}No saved credentials{Style.RESET}"

    freq_raw = str(match["freq"])
    band = "2.4 GHz" if "24" in freq_raw else ("5 GHz" if "5" in freq_raw else ("6 GHz" if "6" in freq_raw else freq_raw))

    print(f"  • {Style.BOLD}SSID Name:{Style.RESET}        {Style.WHITE}{Style.BOLD}{match['ssid']}{Style.RESET}")
    print(f"  • {Style.BOLD}BSSID (MAC):{Style.RESET}      {Style.CYAN}{match['bssid']}{Style.RESET}")
    print(f"  • {Style.BOLD}Network State:{Style.RESET}    {status_tag}")
    print(f"  • {Style.BOLD}Signal Quality:{Style.RESET}   [{bar_str}] {bar_col}{sig_int}%{Style.RESET}  {Style.GRAY}({match['bars']}){Style.RESET}")
    print(f"  • {Style.BOLD}Frequency Band:{Style.RESET}   {Style.YELLOW}{band}{Style.RESET} {Style.DARK_GRAY}(Channel {match['chan']}, {match['freq']}){Style.RESET}")
    print(f"  • {Style.BOLD}Max Link Rate:{Style.RESET}    {match['rate']}")
    print(f"  • {Style.BOLD}Security Type:{Style.RESET}    {Style.PURPLE}{match['security']}{Style.RESET}")
    print(f"  • {Style.BOLD}Saved Profile:{Style.RESET}    {saved_tag}")

    if match["in_use"]:
        dev_res = subprocess.run(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE", "dev"], capture_output=True, text=True).stdout
        wifi_dev = "wlan0"
        for l in dev_res.splitlines():
            if ":wifi:connected" in l:
                wifi_dev = l.split(":")[0]
                break
        ip_out = subprocess.run(["ip", "-4", "addr", "show", wifi_dev], capture_output=True, text=True).stdout
        ip_addr = ""
        for il in ip_out.splitlines():
            if "inet " in il:
                ip_addr = il.strip().split()[1]
                break
        rt_out = subprocess.run(["ip", "route", "show", "dev", wifi_dev], capture_output=True, text=True).stdout
        gw = ""
        for rl in rt_out.splitlines():
            if "default via" in rl:
                gw = rl.strip().split()[2]
                break
        print(f"\n  {Style.BOLD}ACTIVE INTERFACE TELEMETRY ({wifi_dev}):{Style.RESET}")
        if ip_addr:
            print(f"   {Style.DARK_GRAY}•{Style.RESET} IPv4 Address:   {Style.GREEN}{ip_addr}{Style.RESET}")
        if gw:
            print(f"   {Style.DARK_GRAY}•{Style.RESET} IPv4 Gateway:   {Style.CYAN}{gw}{Style.RESET}")

    print(box_footer())


def builtin_wifi(extra_args: Optional[List[str]] = None):
    args = extra_args or []
    if not shutil.which("nmcli"):
        log_error("NetworkManager CLI (nmcli) is required for Wi-Fi management. Install: sudo pacman -S networkmanager")
        return

    if args and args[0] in ("-h", "--help", "help"):
        print(box_header("COREX WI-FI WORKSTATION MANAGER"))
        print(f"""
 {Style.BOLD}USAGE:{Style.RESET}
   cx wifi                         Launch interactive fzf Wi-Fi network selector
   cx wifi -s, --scan              Scan and print clean table of nearby wireless networks
   cx wifi -i, --status            Display active wireless connection & interface status
   cx wifi on / off                Toggle wireless radio power
   cx wifi connect <SSID> [pwd]    Directly connect to SSID (prompts if password missing)
   cx wifi disconnect              Disconnect active wireless connection
""")
        print(box_footer())
        return

    if args and args[0] in ("on", "enable"):
        subprocess.run(["nmcli", "radio", "wifi", "on"])
        log_success("Wireless radio enabled.")
        return

    if args and args[0] in ("off", "disable"):
        subprocess.run(["nmcli", "radio", "wifi", "off"])
        log_warn("Wireless radio disabled.")
        return

    if args and args[0] in ("disconnect", "down"):
        dev_res = subprocess.run(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE", "dev"], capture_output=True, text=True).stdout
        for l in dev_res.splitlines():
            if ":wifi:connected" in l:
                dev = l.split(":")[0]
                subprocess.run(["nmcli", "dev", "disconnect", dev])
                log_success(f"Disconnected Wi-Fi interface {dev}.")
                return
        log_warn("No active Wi-Fi connection found to disconnect.")
        return

    if args and args[0] in ("connect", "join"):
        if len(args) < 2:
            log_error("Usage: cx wifi connect <SSID> [password]")
            return
        target_ssid = args[1]
        pwd = args[2] if len(args) > 2 else None
        if not pwd:
            saved_cons = subprocess.run(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show"], capture_output=True, text=True).stdout
            is_saved = any(f"{target_ssid}:802-11-wireless" in l for l in saved_cons.splitlines())
            if not is_saved:
                import getpass
                try:
                    pwd = getpass.getpass(f"Enter WPA/WPA2 password for '{target_ssid}' (leave blank if open): ")
                except KeyboardInterrupt:
                    print()
                    return
        cmd = ["nmcli", "dev", "wifi", "connect", target_ssid]
        if pwd:
            cmd.extend(["password", pwd])
        print(f" Connecting to {Style.BOLD}{target_ssid}{Style.RESET}...")
        res = subprocess.run(cmd)
        if res.returncode == 0:
            log_success(f"Successfully connected to '{target_ssid}'!")
        else:
            log_error(f"Failed to connect to '{target_ssid}'.")
        return

    if args and args[0] in ("-i", "--status", "status", "info"):
        print(box_header("ACTIVE WI-FI INTERFACE STATUS"))
        dev_res = subprocess.run(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "dev"], capture_output=True, text=True).stdout
        wifi_dev = None
        active_con = None
        for l in dev_res.splitlines():
            parts = l.split(":")
            if len(parts) >= 4 and parts[1] == "wifi":
                wifi_dev = parts[0]
                if parts[2] == "connected":
                    active_con = parts[3]
                break

        radio_state = subprocess.run(["nmcli", "radio", "wifi"], capture_output=True, text=True).stdout.strip()
        print(f"  • {Style.BOLD}Radio State:{Style.RESET}      {Style.GREEN if radio_state == 'enabled' else Style.RED}{radio_state.upper()}{Style.RESET}")
        print(f"  • {Style.BOLD}Wi-Fi Device:{Style.RESET}     {Style.CYAN}{wifi_dev or 'None'}{Style.RESET}")

        if active_con and wifi_dev:
            print(f"  • {Style.BOLD}Connected SSID:{Style.RESET}   {Style.WHITE}{Style.BOLD}{active_con}{Style.RESET}")
            active_ap = subprocess.run(["nmcli", "-t", "-f", "ACTIVE,SSID,BSSID,CHAN,FREQ,RATE,SIGNAL,BARS,SECURITY", "dev", "wifi"], capture_output=True, text=True).stdout
            for al in active_ap.splitlines():
                if al.startswith("yes:"):
                    ap_parts = re.split(r'(?<!\\):', al)
                    ap_parts = [p.replace('\\:', ':').strip() for p in ap_parts]
                    if len(ap_parts) >= 9:
                        sig = int(ap_parts[6]) if ap_parts[6].isdigit() else 0
                        col = Style.GREEN if sig >= 70 else (Style.YELLOW if sig >= 40 else Style.RED)
                        print(f"  • {Style.BOLD}BSSID (MAC):{Style.RESET}      {Style.CYAN}{ap_parts[2]}{Style.RESET}")
                        print(f"  • {Style.BOLD}Signal Quality:{Style.RESET}   {col}{sig}%{Style.RESET}  {Style.GRAY}({ap_parts[7]}){Style.RESET}")
                        print(f"  • {Style.BOLD}Frequency Band:{Style.RESET}   {Style.YELLOW}{ap_parts[4]}{Style.RESET} (Channel {ap_parts[3]})")
                        print(f"  • {Style.BOLD}Link Bitrate:{Style.RESET}     {ap_parts[5]}")
                        print(f"  • {Style.BOLD}Security Type:{Style.RESET}    {Style.PURPLE}{ap_parts[8]}{Style.RESET}")
                    break

            ip_out = subprocess.run(["ip", "-4", "addr", "show", wifi_dev], capture_output=True, text=True).stdout
            for il in ip_out.splitlines():
                if "inet " in il:
                    print(f"  • {Style.BOLD}IPv4 Address:{Style.RESET}     {Style.GREEN}{il.strip().split()[1]}{Style.RESET}")
                    break
            rt_out = subprocess.run(["ip", "route", "show", "dev", wifi_dev], capture_output=True, text=True).stdout
            for rl in rt_out.splitlines():
                if "default via" in rl:
                    print(f"  • {Style.BOLD}IPv4 Gateway:{Style.RESET}     {Style.CYAN}{rl.strip().split()[2]}{Style.RESET}")
                    break
        else:
            print(f"  • {Style.BOLD}Connection State:{Style.RESET} {Style.YELLOW}Disconnected{Style.RESET}")
        print(box_footer())
        return

    if args and args[0] in ("-s", "--scan", "scan", "list"):
        print(box_header("NEARBY WI-FI ACCESS POINTS"))
        print(f" Scanning surrounding wireless spectrum...\n")
        networks = _parse_wifi_scan()
        if not networks:
            print(f"  {Style.YELLOW}No wireless networks detected.{Style.RESET}")
            print(box_footer())
            return
        print(f" {'':<2} {'SSID':<24} {'SIGNAL':<8} {'BARS':<8} {'FREQ':<10} {'CHAN':<6} {'RATE':<12} {'SECURITY'}")
        print(f" {Style.DARK_GRAY}{'─' * 88}{Style.RESET}")
        for n in networks:
            sig = int(n["signal"]) if str(n["signal"]).isdigit() else 0
            sig_col = Style.GREEN if sig >= 70 else (Style.YELLOW if sig >= 40 else Style.RED)
            in_use_mark = f"{Style.GREEN}★{Style.RESET}" if n["in_use"] else " "
            ssid_disp = f"{Style.BOLD}{n['ssid'][:23]:<24}{Style.RESET}" if n["in_use"] else f"{n['ssid'][:23]:<24}"
            freq_band = "2.4G" if "24" in str(n["freq"]) else ("5G" if "5" in str(n["freq"]) else "6G")
            print(f" {in_use_mark} {ssid_disp} {sig_col}{sig:>3}%{Style.RESET}    {n['bars']:<8} {Style.YELLOW}{freq_band:<10}{Style.RESET} {n['chan']:<6} {n['rate']:<12} {Style.PURPLE}{n['security'][:20]}{Style.RESET}")
        print(box_footer())
        return

    # Interactive fzf mode
    if not shutil.which("fzf"):
        builtin_wifi(["--scan"])
        return

    networks = _parse_wifi_scan()
    if not networks:
        log_warn("No wireless networks found nearby.")
        return

