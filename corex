def builtin_type_test():
    def _type_test_tui(stdscr):
        import curses, random
        curses.curs_set(1)
        stdscr.nodelay(False)
        curses.start_color()
        curses.use_default_colors()

        curses.init_pair(1, curses.COLOR_GREEN, -1)
        curses.init_pair(2, curses.COLOR_RED, -1)
        curses.init_pair(3, curses.COLOR_CYAN, -1)
        curses.init_pair(4, curses.COLOR_YELLOW, -1)

        while True:
            target_text = random.choice(TYPING_SNIPPETS)
            typed = []
            start_time = None

            while True:
                stdscr.erase()
                max_y, max_x = stdscr.getmaxyx()
                now = time.time()
                elapsed = (now - start_time) if start_time else 0
                mins = elapsed / 60.0

                correct_count = sum(1 for i, c in enumerate(typed) if i < len(target_text) and c == target_text[i])
                wpm = int((correct_count / 5.0) / mins) if mins > 0.01 else 0
                acc = int((correct_count / len(typed) * 100)) if typed else 100

                try:
                    stdscr.addstr(1, 2, "╭─ COREX TERMINAL TYPING SPEED TEST ────────────────────────────────╮", curses.color_pair(3))
                    stats_str = f" WPM: {wpm:<3}  │  Accuracy: {acc:>3}%  │  Time: {int(elapsed)}s  │  [ESC] Exit"
                    stdscr.addstr(2, 4, stats_str, curses.color_pair(4) | curses.A_BOLD)
                    stdscr.addstr(3, 2, "╰───────────────────────────────────────────────────────────────────╯", curses.color_pair(3))
                except curses.error:
                    pass

                text_y = 5
                text_x = 4
                curr_x = text_x
                curr_y = text_y

                for i, ch in enumerate(target_text):
                    if i < len(typed):
                        if typed[i] == ch:
                            attr = curses.color_pair(1) | curses.A_BOLD
                        else:
                            attr = curses.color_pair(2) | curses.A_BOLD | curses.A_REVERSE
                    else:
                        attr = curses.A_DIM

                    if curr_x >= max_x - 6:
                        curr_y += 1
                        curr_x = text_x

                    try:
                        stdscr.addstr(curr_y, curr_x, ch, attr)
                    except curses.error:
                        pass
                    curr_x += 1

                cy = text_y
                cx = text_x
                for i in range(len(typed)):
                    if cx >= max_x - 6:
                        cy += 1
                        cx = text_x
                    cx += 1
                try:
                    stdscr.move(cy, cx)
                except curses.error:
                    pass

                stdscr.refresh()

                if len(typed) >= len(target_text):
                    break

                ch = stdscr.getch()
                if start_time is None:
                    start_time = time.time()

                if ch in (27,):
                    return
                elif ch in (curses.KEY_BACKSPACE, 127, 8):
                    if typed:
                        typed.pop()
                elif 32 <= ch <= 126:
                    typed.append(chr(ch))

            curses.curs_set(0)
            final_mins = max(elapsed / 60.0, 0.01)
            final_wpm = int((correct_count / 5.0) / final_mins)
            final_acc = int((correct_count / len(typed) * 100)) if typed else 100

            rank = "Code Ninja" if final_wpm > 80 else ("Touch Typist" if final_wpm > 55 else ("Speed Coder" if final_wpm > 35 else "Script Kiddie"))

            res_y = curr_y + 3
            try:
                stdscr.addstr(res_y, 2, "╭─ TEST RESULTS ────────────────────────────────────────────────────╮", curses.color_pair(1) | curses.A_BOLD)
                stdscr.addstr(res_y + 1, 4, f"Speed: {final_wpm} WPM   │   Accuracy: {final_acc}%   │   Rank: {rank}", curses.color_pair(4) | curses.A_BOLD)
                stdscr.addstr(res_y + 2, 4, "Press [Enter] to try another text or [ESC] / [Q] to quit.", curses.A_DIM)
                stdscr.addstr(res_y + 3, 2, "╰───────────────────────────────────────────────────────────────────╯", curses.color_pair(1) | curses.A_BOLD)
                stdscr.refresh()
            except curses.error:
                pass

            while True:
                k = stdscr.getch()
                if k in (10, 13, ord(' ')):
                    curses.curs_set(1)
                    break
                elif k in (ord('q'), ord('Q'), 27):
                    return

    import curses
    curses.wrapper(_type_test_tui)


