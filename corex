def _format_kb(kb_val: int) -> str:
    if kb_val < 1024:
        return f"{kb_val} KB"
    mb = kb_val / 1024.0
    if mb < 1024:
        return f"{mb:.1f} MB"
    gb = mb / 1024.0
    return f"{gb:.2f} GB"


def render_proc_preview(pid_str: str):
    """Render deep process forensics in fzf preview window."""
    pid_str = pid_str.strip()
    if not pid_str.isdigit():
        return
    pid = int(pid_str)
    proc_dir = Path(f"/proc/{pid}")
    if not proc_dir.exists():
        print(box_header(f"PROCESS FORENSICS [PID: {pid}]"))
        print(f"  {Style.RED}Process {pid} has terminated or is not accessible.{Style.RESET}")
        print(box_footer())
        return

    status_info = {}
    try:
        for line in (proc_dir / "status").read_text().splitlines():
            if ":" in line:
                k, v = line.split(":", 1)
                status_info[k.strip()] = v.strip()
    except Exception:
        pass

    try:
        raw_cmd = (proc_dir / "cmdline").read_bytes().replace(b"\0", b" ").decode("utf-8", errors="replace").strip()
    except Exception:
        raw_cmd = status_info.get("Name", "unknown")

    try:
        exe_path = os.readlink(proc_dir / "exe")
    except Exception:
        exe_path = status_info.get("Name", "unknown")

    ppid = status_info.get("PPid", "0")
    parent_name = "systemd"
    try:
        if ppid != "0":
            parent_name = (Path(f"/proc/{ppid}/comm")).read_text().strip()
    except Exception:
        pass

    open_fds = []
    open_sockets = []
    fd_dir = proc_dir / "fd"
    fd_count = 0
    if fd_dir.exists():
        try:
            for fd_entry in fd_dir.iterdir():
                fd_count += 1
                try:
                    target = os.readlink(fd_entry)
                    if target.startswith("socket:["):
                        open_sockets.append(target)
                    elif not target.startswith("/dev/null") and not target.startswith("pipe:["):
                        open_fds.append(target)
                except Exception:
                    pass
        except Exception:
            pass

    uid = status_info.get("Uid", "").split()[0] if status_info.get("Uid") else ""
    user_name = "unknown"
    if uid:
        try:
            import pwd
            user_name = pwd.getpwuid(int(uid)).pw_name
        except Exception:
            user_name = uid

    state_str = status_info.get("State", "Unknown")
    threads_str = status_info.get("Threads", "1")

    def _get_mem_kb(key):
        val = status_info.get(key, "0 kB")
        nums = [c for c in val if c.isdigit()]
        return int("".join(nums)) if nums else 0

    rss_kb = _get_mem_kb("VmRSS")
    vsize_kb = _get_mem_kb("VmSize")
    peak_kb = _get_mem_kb("VmPeak")
    swap_kb = _get_mem_kb("VmSwap")
    shared_kb = _get_mem_kb("RssFile")

    cgroup_unit = ""
    try:
        cg_text = (proc_dir / "cgroup").read_text()
        for cgl in cg_text.splitlines():
            if "0::" in cgl:
                cgroup_unit = cgl.split("0::", 1)[1]
    except Exception:
        pass

    print(box_header(f"PROCESS FORENSICS [PID: {pid}]"))
    print(f"  • {Style.BOLD}Process Name:{Style.RESET}    {Style.WHITE}{Style.BOLD}{status_info.get('Name', 'unknown')}{Style.RESET}")
    print(f"  • {Style.BOLD}Executable:{Style.RESET}      {Style.CYAN}{exe_path}{Style.RESET}")
    print(f"  • {Style.BOLD}User / Owner:{Style.RESET}    {Style.YELLOW}{user_name}{Style.RESET} (UID {uid})")
    print(f"  • {Style.BOLD}Execution State:{Style.RESET} {state_str}")
    print(f"  • {Style.BOLD}Thread Count:{Style.RESET}    {Style.GREEN}{threads_str} active threads{Style.RESET}")
    print(f"  • {Style.BOLD}Parent Process:{Style.RESET}  {Style.PURPLE}{parent_name}{Style.RESET} (PPID {ppid})")

    print(f"\n  {Style.BOLD}MEMORY FOOTPRINT:{Style.RESET}")
    print(f"   {Style.DARK_GRAY}•{Style.RESET} Physical RAM (RSS):   {Style.GREEN}{Style.BOLD}{_format_kb(rss_kb)}{Style.RESET}")
    print(f"   {Style.DARK_GRAY}•{Style.RESET} Virtual Memory (Size): {_format_kb(vsize_kb)}")
    print(f"   {Style.DARK_GRAY}•{Style.RESET} Peak Virtual Memory:   {_format_kb(peak_kb)}")
    print(f"   {Style.DARK_GRAY}•{Style.RESET} Shared / Code Pages:   {_format_kb(shared_kb)}")
    print(f"   {Style.DARK_GRAY}•{Style.RESET} Swap Allocation:       {_format_kb(swap_kb)}")

    print(f"\n  {Style.BOLD}FULL COMMAND LINE ARGUMENTS:{Style.RESET}")
    cmd_disp = raw_cmd if len(raw_cmd) < 180 else raw_cmd[:180] + "..."
    print(f"   {Style.DARK_GRAY}❯{Style.RESET} {Style.WHITE}{cmd_disp}{Style.RESET}")

    if open_fds:
        print(f"\n  {Style.BOLD}OPEN FILE DESCRIPTORS ({fd_count} open):{Style.RESET}")
        for f in list(dict.fromkeys(open_fds))[:5]:
            print(f"   {Style.DARK_GRAY}•{Style.RESET} {f}")

    if open_sockets:
        print(f"\n  {Style.BOLD}ACTIVE SOCKETS / PORTS ({len(open_sockets)} sockets):{Style.RESET}")
        try:
            ss_out = subprocess.run(["ss", "-tulpn", "-H"], capture_output=True, text=True).stdout
            proc_ports = []
            for sl in ss_out.splitlines():
                if f"pid={pid}," in sl:
                    parts = sl.split()
                    if len(parts) >= 5:
                        proc_ports.append(f"{parts[0].upper()} {parts[4]} ({parts[1]})")
            if proc_ports:
                for pp in proc_ports[:4]:
                    print(f"   {Style.CYAN}•{Style.RESET} {pp}")
            else:
                for s in open_sockets[:3]:
                    print(f"   {Style.DARK_GRAY}•{Style.RESET} {s}")
        except Exception:
            for s in open_sockets[:3]:
                print(f"   {Style.DARK_GRAY}•{Style.RESET} {s}")

    if cgroup_unit:
        print(f"\n  {Style.BOLD}SYSTEMD SCOPE / CGROUP:{Style.RESET}")
        print(f"   {Style.DARK_GRAY}•{Style.RESET} {cgroup_unit}")

    print(box_footer())


def handle_proc_signal(pid_str: str, sig_name: str):
    """Internal helper to dispatch signal to PID from fzf keybindings."""
    if not pid_str.isdigit():
        return
    pid = int(pid_str)
    sig_map = {
        "kill": signal.SIGKILL,
        "term": signal.SIGTERM,
        "freeze": signal.SIGSTOP,
        "resume": signal.SIGCONT,
    }
    sig = sig_map.get(sig_name.lower())
    if not sig:
        return
    try:
        os.kill(pid, sig)
    except Exception:
        pass


def builtin_proc(extra_args: Optional[List[str]] = None):
    args = extra_args or []

    if len(args) >= 2 and args[0] in ("kill", "term", "freeze", "resume") and args[1].isdigit():
        handle_proc_signal(args[1], args[0])
