        try:
            ans = input().strip().lower()
            if ans in ("", "y", "yes"):
                self_exe = os.path.abspath(sys.argv[0])
                fzf_lines = []
                for cid in sorted(user_cmds.keys()):
                    spec = cfg.commands.get(cid)
                    desc = spec.description if spec else ""
                    cat = spec.category if spec else "Custom Actions"
                    tag = CATEGORY_TAGS.get(cat, "@custom")
                    fzf_lines.append(f"{cid}\t{tag}\t{cat}\t{desc}")
                fzf_cmd = [
                    "fzf",
                    "--delimiter=\t",
                    "--with-nth=1,2,4",
                    "--prompt=  ◈ Run Custom Action ❯ ",
                    "--header= [Enter] Execute  │  [ESC] Exit ",
                    "--border=rounded",
                    "--border-label= CoreX Custom Actions ",
                    "--preview", f"python3 '{self_exe}' __preview {{1}}",
                    "--preview-window=right:48%:border-rounded:wrap",
                    "--height=70%",
                ]
                proc = subprocess.Popen(fzf_cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
                out, _ = proc.communicate(input="\n".join(fzf_lines))
                if proc.returncode == 0 and out.strip():
                    selected_id = out.strip().split("\t")[0]
                    execute_command(selected_id, cfg)
        except KeyboardInterrupt:
            pass


