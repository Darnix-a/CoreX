def builtin_stats(cfg: CoreXConfig, extra_args: Optional[List[str]] = None):
    args = extra_args or []
    state = load_user_state()

    if "--reset" in args:
        state["frequency"] = {}
        state["last_used"] = {}
        save_user_state(state)
        print(f"\n {Style.GREEN}{Style.BOLD}✔ Execution telemetry & statistics have been reset.{Style.RESET}\n")
        return

    freq = state.get("frequency", {})
    last_used = state.get("last_used", {})
    pinned = state.get("pinned", [])

    total_runs = sum(freq.values())
    unique_run = len([k for k, v in freq.items() if v > 0 and k in cfg.commands])
    total_catalog = len(cfg.commands)

    c_blue = "\033[38;2;137;180;250m"
    c_mauve = "\033[38;2;203;166;247m"
    c_green = "\033[38;2;166;227;161m"
    c_yellow = "\033[38;2;249;226;175m"
    c_peach = "\033[38;2;250;179;135m"
    rst = Style.RESET
    bld = Style.BOLD
    dim = Style.DIM

    print(f"\n {c_blue}{bld}╭─ COREX WORKSTATION TELEMETRY & USAGE AUDITOR ───────────────────────╮{rst}")
    print(f" {c_blue}│{rst} {dim}Execution analytics, frequency profiling and catalog discovery{rst}      {c_blue}│{rst}")
    print(f" {c_blue}╰─────────────────────────────────────────────────────────────────────╯{rst}\n")

    pct_catalog = (unique_run / max(1, total_catalog)) * 100
    theme_name = THEMES.get(cfg.theme, {}).get("name", cfg.theme)
    print(f"  {bld}OVERVIEW METRICS:{rst}")
    print(f"   • {bld}Total Executions:{rst}       {c_blue}{bld}{total_runs}{rst} runs recorded")
    print(f"   • {bld}Distinct Actions Used:{rst}  {c_green}{bld}{unique_run}{rst} / {total_catalog} ({pct_catalog:.1f}% catalog coverage)")
    print(f"   • {bld}Pinned Favorites:{rst}       {c_yellow}{bld}{len(pinned)}{rst} starred actions")
    print(f"   • {bld}Active Theme Palette:{rst}   {c_mauve}{bld}{theme_name}{rst}")

    if total_runs == 0:
        print(f"\n  {dim}No command execution telemetry recorded yet.{rst}")
        print(f"  {dim}As you run actions via 'cx <cmd>' or the interactive menu, usage metrics appear here.{rst}\n")
        return

    sorted_freq = sorted(
        [(k, v) for k, v in freq.items() if k in cfg.commands],
        key=lambda x: x[1],
        reverse=True
    )[:10]

    max_count = sorted_freq[0][1] if sorted_freq else 1
    bar_width = 20

    print(f"\n  {bld}TOP EXECUTED ACTIONS:{rst}")
    for idx, (cid, count) in enumerate(sorted_freq, 1):
        spec = cfg.commands.get(cid)
        desc = spec.description if spec else ""
        tag = CATEGORY_TAGS.get(spec.category, "@misc") if spec else "@custom"
        t_col = get_tag_color(tag)

        bar_filled = int((count / max_count) * bar_width)
        bar_str = f"{c_blue}{'█' * bar_filled}{dim}{'░' * (bar_width - bar_filled)}{rst}"
        pct_share = (count / total_runs) * 100

        print(f"   {dim}#{idx:<2}{rst} {bld}{cid:<18}{rst} {t_col}{tag:<8}{rst} [{bar_str}] {c_blue}{bld}{count:>3}{rst} {dim}({pct_share:4.1f}%){rst}  {dim}{desc}{rst}")

    cat_counts: Dict[str, int] = {}
    for cid, count in freq.items():
        if cid in cfg.commands:
            spec = cfg.commands[cid]
            tag = CATEGORY_TAGS.get(spec.category, "@misc")
            cat_counts[tag] = cat_counts.get(tag, 0) + count

    sorted_cats = sorted(cat_counts.items(), key=lambda x: x[1], reverse=True)[:5]
    if sorted_cats:
        print(f"\n  {bld}TOP ACTIVE CATEGORIES:{rst}")
        for tag, c_cnt in sorted_cats:
            t_col = get_tag_color(tag)
            c_pct = (c_cnt / total_runs) * 100
            c_bar_filled = int((c_cnt / total_runs) * bar_width)
            c_bar = f"{t_col}{'█' * c_bar_filled}{dim}{'░' * (bar_width - c_bar_filled)}{rst}"
            print(f"   • {t_col}{bld}{tag:<10}{rst} [{c_bar}] {t_col}{bld}{c_cnt:>3}{rst} {dim}({c_pct:4.1f}% of all runs){rst}")

    now_ts = int(time.time())
    sorted_recent = sorted(
        [(k, v) for k, v in last_used.items() if k in cfg.commands],
        key=lambda x: x[1],
        reverse=True
    )[:5]

    def _fmt_ago(ts: int) -> str:
        diff = max(0, now_ts - ts)
        if diff < 60:
            return "just now"
        elif diff < 3600:
            return f"{diff // 60}m ago"
        elif diff < 86400:
            return f"{diff // 3600}h ago"
        else:
            return f"{diff // 86400}d ago"

    if sorted_recent:
        print(f"\n  {bld}RECENTLY RUN ACTIONS:{rst}")
        for cid, ts in sorted_recent:
            spec = cfg.commands.get(cid)
            desc = spec.description if spec else ""
            tag = CATEGORY_TAGS.get(spec.category, "@misc") if spec else "@custom"
            t_col = get_tag_color(tag)
            ago_str = _fmt_ago(ts)
            print(f"   • {bld}{cid:<18}{rst} {t_col}{tag:<8}{rst} {c_peach}{ago_str:<9}{rst} {dim}{desc}{rst}")

    unused = [cid for cid in cfg.commands.keys() if freq.get(cid, 0) == 0]
    if unused:
        import random
        sample_unused = random.sample(unused, min(3, len(unused)))
        print(f"\n  {bld}✨ EXPLORE UNUSED ACTIONS:{rst}")
        for cid in sample_unused:
            spec = cfg.commands[cid]
            tag = CATEGORY_TAGS.get(spec.category, "@misc")
            t_col = get_tag_color(tag)
            print(f"   • {bld}{cid:<18}{rst} {t_col}{tag:<8}{rst} {dim}{spec.description}{rst}")

    print(f"\n  {dim}Controls: 'cx stats --reset' to clear history  │  'cx pin <action>' to star{rst}\n")


