        curses.init_pair(1, curses.COLOR_GREEN, -1)
        curses.init_pair(2, curses.COLOR_RED, -1)
        curses.init_pair(3, curses.COLOR_YELLOW, -1)
        curses.init_pair(4, curses.COLOR_CYAN, -1)
        curses.init_pair(5, curses.COLOR_WHITE, -1)

        high_score_file = Path.home() / ".local" / "share" / "corex" / "snake_highscore.txt"
        high_score = 0
        if high_score_file.exists():
            try:
                high_score = int(high_score_file.read_text().strip())
            except Exception:
                pass

        while True:
            max_y, max_x = stdscr.getmaxyx()
            h, w = 20, 44
            if max_y < h + 4 or max_x < w + 4:
                stdscr.erase()
                stdscr.addstr(1, 1, "Terminal too small for Snake! Please resize window.", curses.A_BOLD)
                stdscr.refresh()
                time.sleep(1)
                return

            start_y = (max_y - h) // 2
            start_x = (max_x - w) // 2

            snake = [[h // 2, w // 2], [h // 2, w // 2 - 1], [h // 2, w // 2 - 2]]
            direction = curses.KEY_RIGHT
            score = 0
            speed = 0.10

            def spawn_food():
                while True:
                    fy = random.randint(1, h - 2)
                    fx = random.randint(1, w - 2)
                    if [fy, fx] not in snake:
                        return [fy, fx]

            food = spawn_food()
            paused = False

            while True:
                key = stdscr.getch()
                if key in (ord('q'), ord('Q'), 27):
                    return
                elif key in (ord('p'), ord('P'), ord(' ')):
                    paused = not paused

                if not paused:
                    if key in (curses.KEY_UP, ord('w'), ord('W')) and direction != curses.KEY_DOWN:
                        direction = curses.KEY_UP
                    elif key in (curses.KEY_DOWN, ord('s'), ord('S')) and direction != curses.KEY_UP:
                        direction = curses.KEY_DOWN
                    elif key in (curses.KEY_LEFT, ord('a'), ord('A')) and direction != curses.KEY_RIGHT:
                        direction = curses.KEY_LEFT
                    elif key in (curses.KEY_RIGHT, ord('d'), ord('D')) and direction != curses.KEY_LEFT:
                        direction = curses.KEY_RIGHT

                    head = [snake[0][0], snake[0][1]]
                    if direction == curses.KEY_UP:
                        head[0] -= 1
                    elif direction == curses.KEY_DOWN:
                        head[0] += 1
                    elif direction == curses.KEY_LEFT:
                        head[1] -= 1
                    elif direction == curses.KEY_RIGHT:
                        head[1] += 1

                    if head[0] <= 0 or head[0] >= h - 1 or head[1] <= 0 or head[1] >= w - 1:
                        break
                    if head in snake:
                        break

                    snake.insert(0, head)
                    if head == food:
                        score += 10
                        if score > high_score:
                            high_score = score
                            try:
                                high_score_file.parent.mkdir(parents=True, exist_ok=True)
                                high_score_file.write_text(str(high_score))
                            except Exception:
                                pass
                        speed = max(0.04, speed * 0.97)
                        food = spawn_food()
                    else:
                        snake.pop()

                stdscr.erase()
                for y in range(h):
                    for x in range(w):
                        if y == 0 or y == h - 1 or x == 0 or x == w - 1:
                            try:
                                stdscr.addstr(start_y + y, start_x + x, "█", curses.color_pair(4))
                            except curses.error:
                                pass

                hud = f" SCORE: {score}  │  HIGH: {high_score}  │  [P] Pause  │  [Q] Quit "
                try:
                    stdscr.addstr(start_y, start_x + max(1, (w - len(hud)) // 2), hud, curses.color_pair(4) | curses.A_BOLD)
                except curses.error:
                    pass

                try:
                    stdscr.addstr(start_y + food[0], start_x + food[1], "★", curses.color_pair(2) | curses.A_BOLD)
                except curses.error:
                    pass

                for i, seg in enumerate(snake):
                    try:
                        if i == 0:
                            stdscr.addstr(start_y + seg[0], start_x + seg[1], "◆", curses.color_pair(5) | curses.A_BOLD)
                        else:
                            stdscr.addstr(start_y + seg[0], start_x + seg[1], "■", curses.color_pair(1))
                    except curses.error:
                        pass

                if paused:
                    msg = " ⏸ PAUSED "
                    try:
                        stdscr.addstr(start_y + h // 2, start_x + (w - len(msg)) // 2, msg, curses.color_pair(3) | curses.A_REVERSE)
                    except curses.error:
                        pass

                stdscr.refresh()
                time.sleep(speed)

            over_box = [
                "╔═══════════════════════════╗",
                "║        GAME OVER!         ║",
                f"║  Final Score: {score:<11} ║",
                f"║  High Score:  {high_score:<11} ║",
                "║  [R] Restart   [Q] Quit   ║",
                "╚═══════════════════════════╝"
            ]
            stdscr.nodelay(False)
            oy = start_y + (h - len(over_box)) // 2
            ox = start_x + (w - len(over_box[0])) // 2
            for i, line in enumerate(over_box):
                try:
                    stdscr.addstr(oy + i, ox, line, curses.color_pair(2 if i == 1 else 4) | curses.A_BOLD)
                except curses.error:
                    pass
            stdscr.refresh()

            while True:
                k = stdscr.getch()
                if k in (ord('r'), ord('R'), 10, 13):
                    stdscr.nodelay(True)
                    break
                elif k in (ord('q'), ord('Q'), 27):
                    return

