def cmd_scratch(cfg: CoreXConfig, title: Optional[str] = None, dry_run: bool = False):
    """Instant temporary markdown scratchpad opened in $EDITOR with timestamp."""
    notes_dir = cfg.notes_dir
    notes_dir.mkdir(parents=True, exist_ok=True)
    editor = get_default_editor(cfg)
    timestamp = datetime.datetime.now().strftime("%Y-%m-%d_%H%M%S")

    if title:
        sanitized_title = re.sub(r"[^\w\-]", "_", title.strip())
        note_file = notes_dir / f"{timestamp}_{sanitized_title}.md"
        if not note_file.exists() and not dry_run:
            note_file.write_text(f"# {title.strip()}\nDate: {datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n\n")
        log_info(f"Opening scratchpad {note_file.name} in {editor}...")
        run_cmd([editor, str(note_file)], dry_run=dry_run)
        return

    existing_notes = sorted(list(notes_dir.glob("*.md")), key=lambda p: p.stat().st_mtime, reverse=True)
    if not existing_notes:
        # Create first scratch note
        note_file = notes_dir / f"{timestamp}_scratch.md"
        if not dry_run:
            note_file.write_text(f"# Scratchpad Note\nDate: {datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n\n")
        log_info(f"Created scratchpad note: {note_file.name}")
        run_cmd([editor, str(note_file)], dry_run=dry_run)
        return

    if not sys.stdin.isatty() or dry_run:
        print(f"Scratchpad directory: {notes_dir}")
        print(f"Found {len(existing_notes)} note(s):")
        for n in existing_notes[:10]:
            mtime = datetime.datetime.fromtimestamp(n.stat().st_mtime).strftime("%Y-%m-%d %H:%M")
            print(f" • {n.name} ({mtime})")
        return

    items = []
    for p in existing_notes:
        mtime = datetime.datetime.fromtimestamp(p.stat().st_mtime).strftime("%Y-%m-%d %H:%M")
        items.append(f"{p.name}\t{mtime}")

    preview_tool = "glow" if check_tool("glow") else ("bat" if check_tool("bat") else "cat")
    preview_cmd = f"{preview_tool} '{notes_dir}/'{{1}}"

    extra = [
        "--delimiter=\t",
        "--header=ENTER: Open Note | CTRL-N: New Note | CTRL-D: Delete Note",
        f"--bind=ctrl-d:execute(rm -f '{notes_dir}/'{{1}})+reload(ls -1t '{notes_dir}' | awk '{{print $1}}')",
    ]

    selected = run_fzf(
        items,
        prompt="cx notes > ",
        preview_cmd=preview_cmd,
        extra_args=extra,
    )

    if not selected:
        return

    chosen = selected[0].split("\t")[0]
    note_path = notes_dir / chosen
    run_cmd([editor, str(note_path)], dry_run=dry_run)


