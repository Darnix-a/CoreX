def save_command_to_config(
    cid: str,
    category: str,
    description: str,
    command: str,
    preview_cmd: str = "",
    requires_sudo: bool = False,
    confirm: bool = False,
    deps: Optional[List[str]] = None,
    config_path: Optional[Path] = None,
) -> bool:
    """Saves or updates a command in config.toml, keeping doctor at the bottom."""
    path = config_path or CONFIG_FILE
    if not path.exists():
        if DEFAULT_CONFIG_TEMPLATE.exists():
            path.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy(DEFAULT_CONFIG_TEMPLATE, path)
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text("[general]\neditor = ''\n\n[commands]\n", encoding="utf-8")

    text = path.read_text(encoding="utf-8")

    def escape_toml(val: str) -> str:
        return val.replace('\\', '\\\\').replace('"', '\\"').replace('\n', '\\n')

    lines = [
        f"[commands.{cid}]",
        f'category = "{escape_toml(category)}"',
        f'description = "{escape_toml(description)}"',
        f'command = "{escape_toml(command)}"',
    ]
    if preview_cmd:
        lines.append(f'preview_cmd = "{escape_toml(preview_cmd)}"')
    else:
        lines.append(f'preview_cmd = "echo \\"Action: {escape_toml(cid)}\\""')
    lines.append(f'requires_sudo = {"true" if requires_sudo else "false"}')
    lines.append(f'confirm = {"true" if confirm else "false"}')
    deps_list = deps or []
    deps_formatted = ", ".join([f'"{escape_toml(d)}"' for d in deps_list])
    lines.append(f'deps = [{deps_formatted}]')
    block = "\n".join(lines) + "\n\n"

    # If updating an existing command:
    pattern = rf"(?ms)^\[commands\.{re.escape(cid)}\].*?(?=(?:^\[|\Z))"
    if re.search(pattern, text):
        new_text = re.sub(pattern, block, text)
    else:
        # Insert before [commands.doctor] if present to keep doctor at bottom
        doctor_pos = text.find("[commands.doctor]")
        if doctor_pos != -1:
            new_text = text[:doctor_pos] + block + text[doctor_pos:]
        else:
            new_text = text.rstrip() + "\n\n" + block

    path.write_text(new_text, encoding="utf-8")
    return True


def remove_command_from_config(cid: str, config_path: Optional[Path] = None) -> bool:
    """Removes a command from config.toml."""
    path = config_path or CONFIG_FILE
    if not path.exists():
        return False
    text = path.read_text(encoding="utf-8")
    pattern = rf"(?ms)^\[commands\.{re.escape(cid)}\].*?(?=(?:^\[|\Z))"
    if not re.search(pattern, text):
        return False
    new_text = re.sub(pattern, "", text)
    new_text = re.sub(r"\n{3,}", "\n\n", new_text)
    path.write_text(new_text, encoding="utf-8")
    return True


def sync_completions(cfg: CoreXConfig):
    """Regenerates and updates completions across fish, bash, and zsh."""
    fish_path = Path.home() / ".config" / "fish" / "completions" / "cx.fish"
    if fish_path.parent.exists():
        try:
            fish_path.write_text(generate_fish_completions(cfg), encoding="utf-8")
        except Exception:
            pass

    bash_path = Path.home() / ".local" / "share" / "bash-completion" / "completions" / "cx"
    if bash_path.parent.exists():
        try:
            bash_path.write_text(generate_bash_completions(cfg), encoding="utf-8")
        except Exception:
            pass

    zsh_path = Path.home() / ".zsh" / "completions" / "_cx"
    if zsh_path.parent.exists():
        try:
            zsh_path.write_text(generate_zsh_completions(cfg), encoding="utf-8")
        except Exception:
            pass


def detect_command_dependencies(cmd_str: str) -> List[str]:
    """Scans shell command string to detect common CLI binaries."""
    ignore = {
        "if", "then", "else", "elif", "fi", "for", "while", "do", "done",
        "case", "esac", "echo", "cd", "pwd", "read", "true", "false",
        "test", "exit", "return", "set", "unset", "export", "alias",
        "source", "exec", "eval", "sh", "bash", "zsh", "sudo", "cx", "corex"
    }
    tokens = re.findall(r"(?:^|[|;&]\s*)([a-zA-Z0-9_\-\.]+)", cmd_str)
    deps = []
    for tok in tokens:
        tok = tok.strip()
        if tok and tok not in ignore and shutil.which(tok) and tok not in deps:
            deps.append(tok)
    return deps


def prompt_user(msg: str, default: str = "") -> str:
    """Helper for reading user input with fallback default."""
    try:
        val = input(msg).strip()
        return val if val else default
    except (KeyboardInterrupt, EOFError):
        print()
        raise KeyboardInterrupt()


def wizard_create_action(cfg: CoreXConfig, initial_id: Optional[str] = None):
    """Interactive step-by-step wizard to create a new action."""
    print(f"\n{box_header('ACTION BUILDER: CREATE NEW ACTION', color=Style.CYAN)}")
    print(f" {Style.GRAY}Follow the guided steps below. Press Ctrl+C to cancel.{Style.RESET}\n")

    # Step 1: Command Identifier
    cid = ""
    while not cid:
        raw_id = prompt_user(f"◈ {Style.BOLD}[1/6] Command ID / Slug{Style.RESET} [e.g. fast-backup, clean-pacman]: ", default=initial_id or "")
        cid = re.sub(r"[^a-zA-Z0-9_\-]", "-", raw_id.lower()).strip("-")
        if not cid:
            log_warn("Command ID cannot be empty.")
            continue
        if cid in cfg.commands:
            print(f"  {Style.YELLOW}▲ Action '{cid}' already exists!{Style.RESET}")
            ans = prompt_user(f"  Overwrite existing action '{cid}'? [y/N]: ", default="n").lower()
            if ans not in ("y", "yes"):
                cid = ""
                continue

    # Step 2: Category
    cats = list(CATEGORY_TAGS.keys())
    print(f"\n◈ {Style.BOLD}[2/6] Select Category:{Style.RESET}")
    for idx, cat_name in enumerate(cats, 1):
        tag = CATEGORY_TAGS[cat_name]
        color = get_tag_color(tag)
        print(f"   [{idx:2d}] {color}{tag:<9}{Style.RESET} {cat_name}")
    print(f"   [{len(cats)+1:2d}] {Style.ORANGE}@custom  {Style.RESET} Enter Custom Category")

    category = "Git, Dev & Code Utilities"
    cat_tag = "@dev"
    choice = prompt_user(f"  Choice [1-{len(cats)+1}, default: 6 (@dev)]: ", default="6").strip()
    if choice.isdigit() and 1 <= int(choice) <= len(cats):
        category = cats[int(choice) - 1]
        cat_tag = CATEGORY_TAGS[category]
    elif choice.isdigit() and int(choice) == len(cats) + 1:
        category = prompt_user("  Enter Custom Category Name: ", default="Custom Actions").strip()
        cat_tag = "@custom"
    else:
        found = False
        for cname, ctag in CATEGORY_TAGS.items():
            if choice.lower() in (ctag.lower(), cname.lower()):
                category = cname
                cat_tag = ctag
                found = True
                break
        if not found:
            category = "Git, Dev & Code Utilities"
            cat_tag = "@dev"

    # Step 3: Description
    print()
    desc = prompt_user(f"◈ {Style.BOLD}[3/6] Short Description{Style.RESET}: ", default=f"User action: {cid}")

    # Step 4: Shell Command & Live Syntax Validation
    print()
    cmd_str = ""
    while not cmd_str:
        cmd_str = prompt_user(f"◈ {Style.BOLD}[4/6] Shell Command to Execute{Style.RESET}: ")
        if not cmd_str:
            log_warn("Command string cannot be empty.")
            continue
        res = subprocess.run(["bash", "-n", "-c", cmd_str], capture_output=True, text=True)
        if res.returncode == 0:
            print(f"   {Style.GREEN}✔ Bash syntax check passed.{Style.RESET}")
        else:
            print(f"   {Style.RED}▲ Bash syntax warning/error:{Style.RESET} {res.stderr.strip()}")
            keep = prompt_user("   Keep this command anyway? [y/N]: ", default="n").lower()
            if keep not in ("y", "yes"):
                cmd_str = ""
                continue

    detected_deps = detect_command_dependencies(cmd_str)
    if detected_deps:
        print(f"   {Style.GRAY}Auto-detected dependencies: {', '.join(detected_deps)}{Style.RESET}")

    # Step 5: Live Preview Command
    print()
    prev_default = f"echo 'Action: {cid} | Runs: {cmd_str[:40]}...'"
    preview_cmd = prompt_user(f"◈ {Style.BOLD}[5/6] Live Preview Command{Style.RESET} (press Enter for default): ", default=prev_default)

    # Step 6: Privileges, Confirmation & Dependencies
    print()
    default_sudo = "y" if "sudo" in cmd_str else "n"
    sudo_ans = prompt_user(f"◈ {Style.BOLD}[6/6] Execution Options:{Style.RESET}\n  Requires Sudo / Root privileges? [{'Y/n' if default_sudo == 'y' else 'y/N'}]: ", default=default_sudo).lower()
    req_sudo = sudo_ans in ("y", "yes")

    conf_ans = prompt_user("  Prompt for confirmation before executing? [y/N]: ", default="n").lower()
    confirm = conf_ans in ("y", "yes")

    deps_default = ", ".join(detected_deps)
    deps_raw = prompt_user(f"  Binary dependencies (comma-separated, press Enter for '{deps_default or 'none'}'): ", default=deps_default)
    deps = [d.strip() for d in deps_raw.replace(" ", ",").split(",") if d.strip()]

    # Review & Test
    t_color = get_tag_color(cat_tag)
    print(f"\n{box_header('ACTION SPECIFICATION SUMMARY', color=t_color)}")
    print(f" {Style.BOLD}ID:{Style.RESET}           {Style.CYAN}{cid}{Style.RESET}")
    print(f" {Style.BOLD}Category:{Style.RESET}     {t_color}{cat_tag}{Style.RESET} {Style.GRAY}({category}){Style.RESET}")
    print(f" {Style.BOLD}Description:{Style.RESET}  {desc}")
    priv_tag = f"{Style.RED}ROOT (Sudo){Style.RESET}" if req_sudo else f"{Style.GREEN}USER (Safe){Style.RESET}"
    conf_tag = f"{Style.YELLOW}YES{Style.RESET}" if confirm else f"{Style.GRAY}NO{Style.RESET}"
    print(f" {Style.BOLD}Security:{Style.RESET}     {priv_tag}  •  Confirm: {conf_tag}")
    deps_str = ", ".join(deps) if deps else "native / none"
    print(f" {Style.BOLD}Dependencies:{Style.RESET} {deps_str}")
    print(f" {Style.BOLD}Command:{Style.RESET}      {Style.WHITE}{cmd_str}{Style.RESET}")
    print(box_footer(color=t_color))

    test_ans = prompt_user(f"\nWould you like to test-run this command now? [y/N]: ", default="n").lower()
    if test_ans in ("y", "yes"):
        print(f"\n{Style.CYAN}--- Executing Test Run ---{Style.RESET}")
        test_cmd = f"sudo {cmd_str}" if req_sudo and not cmd_str.strip().startswith("sudo") else cmd_str
        ret = subprocess.run(test_cmd, shell=True)
        print(f"{Style.CYAN}--- Test Exited with Code {ret.returncode} ---{Style.RESET}\n")

    save_ans = prompt_user(f"Save and register action '{cid}' to ~/.config/corex/config.toml? [Y/n]: ", default="y").lower()
    if save_ans in ("", "y", "yes"):
        save_command_to_config(
            cid=cid,
            category=category,
            description=desc,
            command=cmd_str,
            preview_cmd=preview_cmd,
            requires_sudo=req_sudo,
            confirm=confirm,
            deps=deps,
        )
        cfg.commands[cid] = CommandSpec(
            id=cid,
            category=category,
            description=desc,
            command=cmd_str,
            preview_cmd=preview_cmd,
            requires_sudo=req_sudo,
            confirm=confirm,
            deps=deps,
        )
        sync_completions(cfg)
        print(f"\n{box_header('ACTION SUCCESSFULLY REGISTERED', color=Style.GREEN)}")
        print(f"  {Style.GREEN}✔ Action '{cid}' saved to ~/.config/corex/config.toml{Style.RESET}")
        print(f"  {Style.GREEN}✔ Shell completions updated for Fish, Bash, and Zsh{Style.RESET}")
        print(f"  ⚡ Run it immediately with: {Style.BOLD}{Style.CYAN}cx {cid}{Style.RESET}")
        print(box_footer(color=Style.GREEN) + "\n")


def wizard_edit_action(cfg: CoreXConfig, target_id: Optional[str] = None):
    """Interactive wizard to edit an existing action."""
    cid = target_id
    if not cid:
        items = [f"{c.id}\t{c.description}" for c in cfg.commands.values()]
        if shutil.which("fzf") and sys.stdin.isatty():
            sel = run_fzf(items, prompt="Select action to edit > ")
            if sel:
                cid = sel[0].split("\t")[0].strip()
        if not cid:
            cid = prompt_user("Enter action ID to edit: ").strip()

    if not cid or cid not in cfg.commands:
        log_error(f"Action '{cid}' not found in configuration.")
        return

    spec = cfg.commands[cid]
    print(f"\n{box_header(f'EDIT ACTION: {cid}', color=Style.YELLOW)}")
    print(f"  [1] Interactive Field-by-Field Wizard")
    print(f"  [2] Open in Text Editor ($EDITOR)")
    print(f"  [3] Cancel")
    mode = prompt_user("Choice [1-3, default: 1]: ", default="1").strip()

    if mode == "2":
        ed = get_default_editor(cfg)
        line_num = 1
        if CONFIG_FILE.exists():
            for idx, line in enumerate(CONFIG_FILE.read_text(encoding="utf-8").splitlines(), 1):
                if line.strip() == f"[commands.{cid}]":
                    line_num = idx
                    break
        subprocess.run([ed, f"+{line_num}", str(CONFIG_FILE)])
        log_success(f"Configuration file edited. Shell completions updating...")
        sync_completions(load_config())
        return

    if mode != "1":
        log_info("Edit canceled.")
        return

    print(f"\n {Style.GRAY}Press Enter to keep the existing value.{Style.RESET}\n")
    new_desc = prompt_user(f"Description [{spec.description}]: ", default=spec.description)
    new_cmd = prompt_user(f"Command [{spec.command}]: ", default=spec.command)
    new_prev = prompt_user(f"Preview Command [{spec.preview_cmd}]: ", default=spec.preview_cmd)
    new_sudo = prompt_user(f"Requires Sudo? [{'Y/n' if spec.requires_sudo else 'y/N'}]: ", default="y" if spec.requires_sudo else "n").lower() in ("y", "yes")
    new_conf = prompt_user(f"Confirm prompt? [{'Y/n' if spec.confirm else 'y/N'}]: ", default="y" if spec.confirm else "n").lower() in ("y", "yes")
    deps_str = ", ".join(spec.deps)
    new_deps_raw = prompt_user(f"Dependencies [{deps_str}]: ", default=deps_str)
    new_deps = [d.strip() for d in new_deps_raw.replace(" ", ",").split(",") if d.strip()]

    save_command_to_config(
        cid=cid,
        category=spec.category,
        description=new_desc,
        command=new_cmd,
        preview_cmd=new_prev,
        requires_sudo=new_sudo,
        confirm=new_conf,
        deps=new_deps,
    )
    cfg.commands[cid] = CommandSpec(
        id=cid,
        category=spec.category,
        description=new_desc,
        command=new_cmd,
        preview_cmd=new_prev,
        requires_sudo=new_sudo,
        confirm=new_conf,
        deps=new_deps,
    )
    sync_completions(cfg)
    log_success(f"Action '{cid}' updated successfully!")


def wizard_delete_action(cfg: CoreXConfig, target_id: Optional[str] = None):
    """Safely removes an action from config.toml."""
    cid = target_id
    if not cid:
        items = [f"{c.id}\t{c.description}" for c in cfg.commands.values()]
        if shutil.which("fzf") and sys.stdin.isatty():
            sel = run_fzf(items, prompt="Select action to delete > ")
            if sel:
                cid = sel[0].split("\t")[0].strip()
        if not cid:
            cid = prompt_user("Enter action ID to delete: ").strip()

    if not cid or cid not in cfg.commands:
        log_error(f"Action '{cid}' not found.")
        return

    ans = prompt_user(f"Are you sure you want to permanently delete action '{cid}'? [y/N]: ", default="n").lower()
    if ans in ("y", "yes"):
        if remove_command_from_config(cid):
            if cid in cfg.commands:
                del cfg.commands[cid]
            sync_completions(cfg)
            log_success(f"Action '{cid}' permanently removed from configuration.")
        else:
            log_error(f"Could not remove '{cid}' from config file.")
    else:
        log_info("Deletion canceled.")


