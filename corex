    bitrate_raw = fmt.get("bit_rate")
    bitrate_str = f"{float(bitrate_raw) / 1000000.0:.2f} Mbps" if bitrate_raw and float(bitrate_raw) >= 1000000 else (f"{float(bitrate_raw) / 1000.0:.0f} kbps" if bitrate_raw else "Variable / Unspecified")

