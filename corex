def log_info(msg: str):
    print(f"{Style.BLUE}{Style.BOLD}◈{Style.RESET} {msg}")


def log_success(msg: str):
    print(f"{Style.GREEN}{Style.BOLD}✔{Style.RESET} {msg}")


def log_warn(msg: str):
    print(f"{Style.YELLOW}{Style.BOLD}▲{Style.RESET} {msg}")


def log_error(msg: str):
    print(f"{Style.RED}{Style.BOLD}✖{Style.RESET} {msg}", file=sys.stderr)


def log_step(step: str, detail: str):
    print(f"{Style.CYAN}{Style.BOLD}λ{Style.RESET} {Style.BOLD}{step}:{Style.RESET} {Style.GRAY}{detail}{Style.RESET}")


def box_header(title: str, width: int = 70, color: str = Style.CYAN) -> str:
    title_str = f" {title} " if title else ""
    line = "─" * max(0, width - len(title_str) - 3)
    return f"{color}╭─{Style.BOLD}{Style.WHITE}{title_str}{Style.RESET}{color}{line}╮{Style.RESET}"


def box_footer(width: int = 70, color: str = Style.CYAN) -> str:
    return f"{color}╰{'─' * max(0, width - 2)}╯{Style.RESET}"


# ---------------------------------------------------------------------------
# Declarative Command Model & TOML Config Loader
# ---------------------------------------------------------------------------
class CommandSpec:
    __slots__ = (
        "id",
        "category",
        "description",
        "command",
        "preview_cmd",
        "requires_sudo",
        "confirm",
        "deps",
    )

    def __init__(
        self,
        id: str,
        category: str,
        description: str,
        command: str,
        preview_cmd: str = "",
        requires_sudo: bool = False,
        confirm: bool = False,
        deps: Optional[List[str]] = None,
    ):
        self.id = id
        self.category = category
        self.description = description
        self.command = command
        self.preview_cmd = preview_cmd
        self.requires_sudo = requires_sudo
        self.confirm = confirm
        self.deps = deps if deps is not None else []


class CoreXConfig:
    def __init__(self):
        self.editor: str = ""
        self.notes_dir: Path = NOTES_DIR
        self.todo_file: Path = TODO_FILE
        self.color: bool = True
        self.comfyui_path: Path = Path.home() / "ComfyUI"
        self.comfyui_venv: str = "venv"
        self.comfyui_port: int = 8188
        self.comfyui_host: str = "127.0.0.1"
        self.vram_high_threshold_mb: int = 8192
        self.vram_low_threshold_mb: int = 4096
        self.comfyui_extra_flags: List[str] = ["--preview-method", "auto"]
        self.comfyui_auto_browser: bool = True
        self.comfyui_notify: bool = True
        self.ollama_url: str = "http://127.0.0.1:11434"
        self.ollama_model: str = "qwen2.5-coder:1.5b"
        self.ollama_auto_boot: bool = True
        self.commands: Dict[str, CommandSpec] = {}


def load_config(custom_path: Optional[Path] = None) -> CoreXConfig:
    path = custom_path or CONFIG_FILE
    if not path.exists():
        if DEFAULT_CONFIG_TEMPLATE.exists():
            path.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy(DEFAULT_CONFIG_TEMPLATE, path)
        else:
            return CoreXConfig()

    cfg = CoreXConfig()
    try:
        import tomllib
        with open(path, "rb") as f:
            data = tomllib.load(f)

        gen = data.get("general", {})
        cfg.editor = gen.get("editor", "")
        cfg.notes_dir = Path(os.path.expanduser(gen.get("notes_dir", str(NOTES_DIR))))
        cfg.todo_file = Path(os.path.expanduser(gen.get("todo_file", str(TODO_FILE))))
        cfg.color = gen.get("color", True)

        ai = data.get("ai", {})
        cfg.comfyui_path = Path(os.path.expanduser(ai.get("comfyui_path", "~/ComfyUI")))
        cfg.comfyui_venv = ai.get("comfyui_venv", "venv")
        cfg.comfyui_port = int(ai.get("comfyui_port", 8188))
        cfg.comfyui_host = str(ai.get("comfyui_host", "127.0.0.1"))
        cfg.vram_high_threshold_mb = int(ai.get("vram_high_threshold_mb", 8192))
        cfg.vram_low_threshold_mb = int(ai.get("vram_low_threshold_mb", 4096))
        cfg.comfyui_extra_flags = ai.get("comfyui_extra_flags", ["--preview-method", "auto"])
        cfg.comfyui_auto_browser = ai.get("comfyui_auto_browser", True)
        cfg.comfyui_notify = ai.get("comfyui_notify", True)
        cfg.ollama_url = ai.get("ollama_url", "http://127.0.0.1:11434")
        cfg.ollama_model = str(ai.get("model", "qwen2.5-coder:1.5b"))
        cfg.ollama_auto_boot = bool(ai.get("auto_boot", True))

        raw_cmds = data.get("commands", {})
        if DEFAULT_CONFIG_TEMPLATE.exists() and path != DEFAULT_CONFIG_TEMPLATE:
            try:
                with open(DEFAULT_CONFIG_TEMPLATE, "rb") as df:
                    default_data = tomllib.load(df)
                    default_cmds = default_data.get("commands", {})
                    for dcid, dcdef in default_cmds.items():
                        if dcid not in raw_cmds:
                            raw_cmds[dcid] = dcdef
            except Exception:
                pass

        for cid, cdef in raw_cmds.items():
            cfg.commands[cid] = CommandSpec(
                id=cid,
                category=cdef.get("category", "General"),
                description=cdef.get("description", ""),
                command=cdef.get("command", ""),
                preview_cmd=cdef.get("preview_cmd", ""),
                requires_sudo=bool(cdef.get("requires_sudo", False)),
                confirm=bool(cdef.get("confirm", False)),
                deps=list(cdef.get("deps", [])),
            )
    except Exception as e:
        log_warn(f"Config parse warning ({path}): {e}")

    return cfg


def get_default_editor(cfg: CoreXConfig) -> str:
    if cfg.editor and shutil.which(cfg.editor):
        return cfg.editor
    env_ed = os.environ.get("EDITOR") or os.environ.get("VISUAL")
    if env_ed and shutil.which(env_ed):
        return env_ed
    for c in ["nvim", "micro", "helix", "nano", "vi"]:
        if shutil.which(c):
            return c
    return "nano"


# ---------------------------------------------------------------------------
# FZF Helper
# ---------------------------------------------------------------------------
def run_fzf(
    items: List[str],
    prompt: str = "cx > ",
    preview_cmd: Optional[str] = None,
    multi: bool = False,
    header: Optional[str] = None,
    preview_window: str = "right:55%:border-left:wrap",
    extra_args: Optional[List[str]] = None,
) -> List[str]:
    if not shutil.which("fzf"):
        log_error("'fzf' is required for interactive navigation. Run: sudo pacman -S fzf")
        return []

    if not sys.stdin.isatty() or not sys.stdout.isatty():
        return [items[0]] if items else []

    fzf_args = [
        "fzf",
        "--ansi",
        f"--prompt={prompt}",
        "--height=85%",
        "--layout=reverse",
        "--border=rounded",
        "--scrollbar=│",
        "--info=inline-right",
        "--color=bg+:#1e1e2e,bg:#181825,spinner:#f5e0dc,hl:#89b4fa",
        "--color=fg:#cdd6f4,header:#89dceb,info:#cba6f7,pointer:#f5e0dc",
        "--color=marker:#b4befe,fg+:#ffffff,prompt:#89b4fa,hl+:#f38ba8",
        "--color=border:#45475a,label:#89b4fa,preview-border:#45475a,preview-label:#cba6f7",
    ]

    if multi:
        fzf_args.append("--multi")
    if header:
        fzf_args.extend(["--header", header])
    if preview_cmd:
        fzf_args.extend(["--preview", preview_cmd, f"--preview-window={preview_window}"])
    if extra_args:
        fzf_args.extend(extra_args)

    try:
        proc = subprocess.Popen(
            fzf_args,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
        stdout, _ = proc.communicate(input="\n".join(items))
        if proc.returncode != 0:
            return []

        has_expect = extra_args and any(isinstance(a, str) and "--expect" in a for a in extra_args)
        if has_expect:
            lines = stdout.splitlines()
            if not lines:
                return []
            # In --expect mode: line 0 is key (empty string for Enter), lines 1+ are selected items
            key = lines[0].strip()
            items_selected = [l.strip() for l in lines[1:] if l.strip()]
            if not items_selected:
                return []
            return [key] + items_selected

        return [line.strip() for line in stdout.strip().split("\n") if line.strip()]
    except KeyboardInterrupt:
        return []


def copy_to_clipboard(text: str) -> bool:
    """Copies text to system clipboard using wl-copy (Wayland) or xclip (X11)."""
    if shutil.which("wl-copy"):
        try:
            subprocess.run(["wl-copy"], input=text.encode("utf-8"), check=True, timeout=2.0)
            return True
        except Exception:
            pass
    if shutil.which("xclip"):
        try:
            subprocess.run(["xclip", "-selection", "clipboard"], input=text.encode("utf-8"), check=True, timeout=2.0)
            return True
        except Exception:
            pass
    return False


