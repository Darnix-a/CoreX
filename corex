def builtin_fkill(filter_term: Optional[str] = None):
    res = subprocess.run(["ps", "-eo", "pid,user,%cpu,%mem,stat,comm", "--sort=-%cpu"], capture_output=True, text=True)
    if res.returncode != 0:
        return
    lines = res.stdout.strip().splitlines()[1:]
    items = []
    for l in lines:
        parts = l.split(None, 5)
        if len(parts) >= 6:
            pid, user, cpu, mem, stat, comm = parts
            if filter_term and filter_term.lower() not in comm.lower():
                continue
            items.append(f"{pid:<8}\t{user:<10}\t{cpu:<6}%\t{mem:<6}%\t{stat:<5}\t{comm}")

    preview = "cat /proc/{1}/status 2>/dev/null | grep -E 'Name|State|VmSize|VmRSS|Threads' || echo 'Process terminated'"
    extra = [
        "--delimiter=\t",
        "--header=ENTER: SIGTERM (-15) | CTRL-X: SIGKILL (-9) | TAB: Multi-select",
        "--bind=ctrl-x:execute(kill -9 {+1} 2>/dev/null)+reload(ps -eo pid,user,%cpu,%mem,stat,comm --sort=-%cpu | tail -n +2 | awk '{printf \"%-8s\\t%-10s\\t%-6s%%\\t%-6s%%\\t%-5s\\t%s\\n\", $1,$2,$3,$4,$5,$6}')",
    ]
    selected = run_fzf(items, prompt="fkill > ", preview_cmd=preview, multi=True, extra_args=extra)
    if not selected:
        return
    pids = [s.split("\t")[0].strip() for s in selected]
    log_warn(f"Sending SIGTERM to {', '.join(pids)}...")
    for p in pids:
        subprocess.run(["kill", "-15", p], check=False)
    log_success("SIGTERM signals sent.")


