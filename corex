def _play_radio_stream(st: Dict[str, Any]):
    """Tunes into a radio station with a live now-playing terminal cockpit and interactive controls."""
    if os.path.exists(RADIO_SOCK):
        try:
            os.remove(RADIO_SOCK)
        except Exception:
            pass

    cmd = [
        "mpv",
        "--no-video",
        f"--input-ipc-server={RADIO_SOCK}",
        "--really-quiet",
        st["url"],
    ]

    # Non-interactive / headless / background fallback
    if not sys.stdin.isatty():
        cmd = [
            "mpv",
            "--no-video",
            f"--input-ipc-server={RADIO_SOCK}",
            "--term-status-msg=🎵 ${metadata/by-key/icy-title:${media-title}}",
            st["url"],
        ]
        try:
            subprocess.run(cmd)
        except KeyboardInterrupt:
            pass
        finally:
            if os.path.exists(RADIO_SOCK):
                try:
                    os.remove(RADIO_SOCK)
                except Exception:
                    pass
        return

    # Interactive TTY Mode with Live Now-Playing Cockpit
    print(f"\n{box_header('CONNECTING TO RADIO STREAM', color=Style.CYAN)}")
    print(f" Station:  {Style.BOLD}{st['name']}{Style.RESET}")
    print(f" Genre:    {st.get('genre', 'Music')}")
    print(f" URL:      {st['url']}")
    print(f" Audio:    mpv --no-video (PipeWire Low-Latency)")
    print(box_footer(color=Style.CYAN))
    log_step("Tuning in", f"Connecting to {st['name']}...")

    proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    import termios
    import tty
    import select

    old_term = None
    try:
        old_term = termios.tcgetattr(sys.stdin)
        tty.setcbreak(sys.stdin.fileno())
    except Exception:
        old_term = None

    sock = None
    track_title = "Buffering stream..."
    is_paused = False
    vol = 100.0
    is_mute = False
    recent_tracks: List[Tuple[str, str]] = []
    flash_msg = ""
    flash_time = 0.0

    try:
        # Wait up to 3 seconds for mpv IPC socket to be ready
        for _ in range(30):
            if os.path.exists(RADIO_SOCK):
                break
            if proc.poll() is not None:
                break
            time.sleep(0.1)

        if os.path.exists(RADIO_SOCK):
            try:
                sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                sock.connect(RADIO_SOCK)
                sock.setblocking(False)
                # Observe metadata, pause, volume, mute
                sock.sendall(json.dumps({"command": ["observe_property", 1, "metadata"]}).encode("utf-8") + b"\n")
                sock.sendall(json.dumps({"command": ["observe_property", 2, "pause"]}).encode("utf-8") + b"\n")
                sock.sendall(json.dumps({"command": ["observe_property", 3, "volume"]}).encode("utf-8") + b"\n")
                sock.sendall(json.dumps({"command": ["observe_property", 4, "mute"]}).encode("utf-8") + b"\n")
            except Exception:
                sock = None

        def redraw_tuner(elapsed_sec: int):
            sys.stdout.write("\033[2J\033[H")  # Clear screen and move cursor to top-left
            status_str = f"{Style.YELLOW}⏸ PAUSED{Style.RESET}" if is_paused else f"{Style.GREEN}● PLAYING{Style.RESET}"
            mins, secs = divmod(elapsed_sec, 60)
            dur_str = f"{mins:02d}:{secs:02d}"
            vol_str = f"{Style.RED}MUTED{Style.RESET}" if is_mute else f"{int(vol)}%"

            print(box_header(f"LIVE RADIO TUNER: {st['name']}", color=Style.CYAN))
            print(f"  • {Style.BOLD}Category:{Style.RESET}     {st.get('category', 'Radio'):<20} {Style.BOLD}Genre:{Style.RESET} {st.get('genre', 'Music')}")
            print(f"  • {Style.BOLD}Playback:{Style.RESET}     {status_str} ({dur_str})      {Style.BOLD}Volume:{Style.RESET} {vol_str}")
            print(f"{Style.DARK_GRAY}{'─' * 64}{Style.RESET}")
            print(f"  {Style.BOLD}🎵 CURRENTLY STREAMING SONG:{Style.RESET}")
            if track_title and track_title != "Buffering stream...":
                print(f"     {Style.GREEN}{Style.BOLD}{track_title}{Style.RESET}")
            else:
                print(f"     {Style.GRAY}Demuxing stream & awaiting track metadata...{Style.RESET}")
            print(f"{Style.DARK_GRAY}{'─' * 64}{Style.RESET}")
            print(f"  {Style.BOLD}HOTKEYS:{Style.RESET}")
            print(f"  [q] Stop & Exit   [Space] Pause   [c] Copy Song   [-/+] Volume   [m] Mute")
            if flash_msg and (time.time() - flash_time < 3.5):
                print(f"{Style.DARK_GRAY}{'─' * 64}{Style.RESET}")
                print(f"  {flash_msg}")
            if recent_tracks:
                print(f"{Style.DARK_GRAY}{'─' * 64}{Style.RESET}")
                print(f"  {Style.BOLD}Track History (This Session):{Style.RESET}")
                for t_time, t_name in recent_tracks[-5:]:
                    print(f"   {Style.DARK_GRAY}• [{t_time}]{Style.RESET} {t_name}")
            print(box_footer(color=Style.CYAN))
            sys.stdout.flush()

        start_time = time.time()
        last_render = 0.0
        buf = ""

        sys.stdout.write(f"\033]0;🎵 Connecting... | {st['name']} - CoreX Radio\007")
        sys.stdout.flush()

        while proc.poll() is None:
            now = time.time()
            elapsed = int(now - start_time)

            rlist = [sys.stdin]
            if sock:
                rlist.append(sock)

            r, _, _ = select.select(rlist, [], [], 0.5)

            if sock in r:
                try:
                    chunk = sock.recv(4096).decode("utf-8", errors="replace")
                    if chunk:
                        buf += chunk
                        while "\n" in buf:
                            line, buf = buf.split("\n", 1)
                            if not line.strip():
                                continue
                            try:
                                ev = json.loads(line.strip())
                                if ev.get("event") == "property-change":
                                    pname = ev.get("name")
                                    pdata = ev.get("data")
                                    if pname == "metadata" and isinstance(pdata, dict):
                                        new_t = pdata.get("icy-title") or pdata.get("icy-name")
                                        if new_t and new_t != track_title:
                                            track_title = new_t
                                            cur_clock = time.strftime("%H:%M:%S")
                                            recent_tracks.append((cur_clock, new_t))
                                            try:
                                                cache = {}
                                                if os.path.exists(RADIO_CACHE_FILE):
                                                    with open(RADIO_CACHE_FILE, "r") as f:
                                                        cache = json.load(f)
                                                cache[st["url"]] = {"title": new_t, "ts": time.time()}
                                                with open(RADIO_CACHE_FILE, "w") as f:
                                                    json.dump(cache, f)
                                            except Exception:
                                                pass
                                            sys.stdout.write(f"\033]0;🎵 {new_t} | {st['name']} - CoreX Radio\007")
                                            sys.stdout.flush()
                                            redraw_tuner(elapsed)
                                    elif pname == "pause":
                                        is_paused = bool(pdata)
                                        redraw_tuner(elapsed)
                                    elif pname == "volume":
                                        vol = float(pdata) if pdata is not None else 100.0
                                        redraw_tuner(elapsed)
                                    elif pname == "mute":
                                        is_mute = bool(pdata)
                                        redraw_tuner(elapsed)
                            except Exception:
                                pass
                except Exception:
                    pass

            if sys.stdin in r:
                ch = sys.stdin.read(1)
                if ch in ("q", "Q", "\x03", "\x04"):
                    break
                elif ch in (" ", "p", "P"):
                    if sock:
                        sock.sendall(json.dumps({"command": ["cycle", "pause"]}).encode("utf-8") + b"\n")
                elif ch in ("c", "C", "y", "Y"):
                    if track_title and track_title != "Buffering stream...":
                        copy_to_clipboard(track_title)
                        flash_msg = f"{Style.GREEN}✔ Copied to clipboard:{Style.RESET} '{track_title}'"
                        flash_time = time.time()
                        redraw_tuner(elapsed)
                elif ch in ("-", "9", "_"):
                    if sock:
                        sock.sendall(json.dumps({"command": ["add", "volume", -5]}).encode("utf-8") + b"\n")
                elif ch in ("+", "=", "0"):
                    if sock:
                        sock.sendall(json.dumps({"command": ["add", "volume", 5]}).encode("utf-8") + b"\n")
                elif ch in ("m", "M"):
                    if sock:
                        sock.sendall(json.dumps({"command": ["cycle", "mute"]}).encode("utf-8") + b"\n")

            if now - last_render >= 1.0:
                last_render = now
                redraw_tuner(elapsed)

    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write("\033]0;\007")
        sys.stdout.flush()
        if old_term is not None:
            try:
                termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old_term)
            except Exception:
                pass
        if sock:
            try:
                sock.close()
            except Exception:
                pass
        if proc.poll() is None:
            try:
                proc.terminate()
                proc.wait(timeout=1.5)
            except Exception:
                proc.kill()
        if os.path.exists(RADIO_SOCK):
            try:
                os.remove(RADIO_SOCK)
            except Exception:
                pass
        print(f"\n{Style.CYAN}Radio playback stopped. Thanks for listening!{Style.RESET}\n")


def builtin_stream_radio(extra_args: Optional[List[str]] = None):
    stations = list(RADIO_STATIONS)
    custom_stations = load_custom_radio_stations()
    if custom_stations:
        stations = custom_stations + stations

    query = " ".join(extra_args).strip() if extra_args else ""

    # If direct query was given or non-interactive mode
    if query:
        # Check for exact or prefix name match first
        exact_match = next((s for s in stations if query.lower() == s["name"].lower() or query.lower() == s["name"].lower().replace("somafm - ", "")), None)
        if exact_match:
            _play_radio_stream(exact_match)
            return

        direct_matches = [
            s for s in stations
            if query.lower() in s["name"].lower() or query.lower() in s["genre"].lower() or query.lower() in s["category"].lower()
        ]
        if len(direct_matches) == 1:
            st = direct_matches[0]
            _play_radio_stream(st)
            return
        elif not sys.stdin.isatty() and direct_matches:
            _play_radio_stream(direct_matches[0])
            return

    if not sys.stdin.isatty():
        _play_radio_stream(stations[0])
        return

    items = []
    for s in stations:
        tag = f"[{s['category']}]"
        line = f"{tag:<20} {s['name']:<30} {s['genre']:<24} {s['desc']}\t{s['url']}\t{s['name']}"
        items.append(line)

    self_exe = os.path.abspath(sys.argv[0])
    preview_cmd = f"python3 '{self_exe}' __preview_radio {{3}}"

    fzf_extra = ["--delimiter=\t", "--with-nth=1", "--expect=ctrl-y"]
    if query:
        fzf_extra.append(f"--query={query}")

    header = (
        f"CoreX Live Radio Hub ({len(stations)} Curated Commercial-Free Streams)\n"
        "ENTER: Tune In   |   CTRL-Y: Copy Stream URL   |   Type to filter by genre or name"
    )

    selected = run_fzf(
        items,
        prompt="Radio Station > ",
        preview_cmd=preview_cmd,
        header=header,
        extra_args=fzf_extra,
    )

    if not selected:
        return

    if len(selected) >= 2:
        key = selected[0].strip()
        chosen_line = selected[1].strip()
    else:
        key = ""
        chosen_line = selected[0].strip()

    parts = chosen_line.split("\t")
    if len(parts) < 3:
        return
    st_url = parts[1].strip()
    st_name = parts[2].strip()

    st_obj = next((s for s in stations if s["url"] == st_url), None) or {
        "name": st_name,
        "category": "Radio",
        "genre": "Live Stream",
        "url": st_url,
        "desc": "",
    }

    if key == "ctrl-y":
        copied = copy_to_clipboard(st_url)
        if copied:
            log_success(f"Stream URL copied to clipboard: {st_url}")
        else:
            print(f"\n{Style.CYAN}Stream URL:{Style.RESET} {st_url}\n")
        return

    _play_radio_stream(st_obj)


def get_now_playing() -> Optional[Dict[str, Any]]:
    """Detects currently playing track from CoreX Radio IPC, MPRIS (playerctl), or MPV sockets."""
    # 1. Check CoreX Radio mpv socket
    sock_path = "/tmp/corex-radio.sock"
    if os.path.exists(sock_path):
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(1.5)
            s.connect(sock_path)
            sf = s.makefile("r", encoding="utf-8")

            s.sendall(json.dumps({"command": ["get_property", "metadata"], "request_id": 1}).encode("utf-8") + b"\n")
            meta = {}
            while True:
                line = sf.readline()
                if not line:
                    break
                obj = json.loads(line)
                if obj.get("request_id") == 1:
                    meta = obj.get("data", {}) or {}
                    break

            s.sendall(json.dumps({"command": ["get_property", "media-title"], "request_id": 2}).encode("utf-8") + b"\n")
            media_title = ""
            while True:
                line = sf.readline()
                if not line:
                    break
                obj = json.loads(line)
                if obj.get("request_id") == 2:
                    media_title = str(obj.get("data", "") or "")
                    break

            s.sendall(json.dumps({"command": ["get_property", "pause"], "request_id": 3}).encode("utf-8") + b"\n")
            paused = False
            while True:
                line = sf.readline()
                if not line:
                    break
                obj = json.loads(line)
                if obj.get("request_id") == 3:
                    paused = bool(obj.get("data", False))
                    break
            s.close()

            icy_title = meta.get("icy-title") or meta.get("title") or media_title
            station_name = meta.get("icy-name", "CoreX Radio")
            if not icy_title or icy_title.lower() in ("mp3", "aac", "ogg", "stream", "live", "groovesalad-128-mp3", "dronezone-128-mp3", "defcon-128-mp3"):
                icy_title = station_name

            artist, title = "", icy_title
            if " - " in icy_title:
                parts = icy_title.split(" - ", 1)
                artist = parts[0].strip()
                title = parts[1].strip()

            return {
                "source": "CoreX Radio Stream",
                "player": "mpv",
                "artist": artist,
                "title": title,
                "album": station_name,
                "genre": meta.get("icy-genre", ""),
                "bitrate": f"{meta.get('icy-br')} kbps" if meta.get("icy-br") else "",
                "status": "Paused" if paused else "Playing",
                "raw": icy_title,
            }
        except Exception:
            pass

    # 2. Check playerctl (MPRIS: Spotify, Firefox, VLC, Amberol, etc.)
    if shutil.which("playerctl"):
        try:
            res = subprocess.run(
                ["playerctl", "-a", "metadata", "--format", "{{status}}|{{playerName}}|{{artist}}|{{title}}|{{album}}"],
                capture_output=True,
                text=True,
                timeout=1.2,
            )
            lines = [l.strip() for l in res.stdout.strip().splitlines() if l.strip()]
            if lines:
                playing = [l for l in lines if l.startswith("Playing")]
                chosen = playing[0] if playing else lines[0]
                parts = chosen.split("|")
                status = parts[0] if len(parts) > 0 else "Playing"
                player = parts[1] if len(parts) > 1 else "Player"
                artist = parts[2] if len(parts) > 2 else ""
                title = parts[3] if len(parts) > 3 else ""
                album = parts[4] if len(parts) > 4 else ""
                raw = f"{artist} - {title}" if (artist and title) else (title or artist)
                if raw:
                    return {
                        "source": f"MPRIS ({player.capitalize()})",
                        "player": player,
                        "artist": artist,
                        "title": title,
                        "album": album,
                        "genre": "",
                        "bitrate": "",
                        "status": status,
                        "raw": raw,
                    }
        except Exception:
            pass

    return None


def builtin_now_playing(extra_args: Optional[List[str]] = None):
    """Inspects currently playing song from CoreX Radio stream, Spotify, browser or playerctl."""
    args = extra_args or []
    short_mode = "--short" in args or "-s" in args
    notify_mode = "--notify" in args or "-n" in args
    follow_mode = "--follow" in args or "-f" in args
    no_copy = "--no-copy" in args

    if follow_mode:
        print(f"{Style.CYAN}📡 Monitoring track changes live (Press Ctrl+C to quit)...{Style.RESET}\n")
        last_track = None
        try:
            while True:
                info = get_now_playing()
                if info:
                    cur = info["raw"]
                    if cur != last_track:
                        last_track = cur
                        status_sym = f"{Style.GREEN}▶{Style.RESET}" if info["status"] == "Playing" else f"{Style.YELLOW}⏸{Style.RESET}"
                        print(f" {status_sym} {Style.BOLD}{cur}{Style.RESET} {Style.DARK_GRAY}[{info['source']}]{Style.RESET}")
                        if notify_mode and shutil.which("notify-send"):
                            subprocess.run(["notify-send", "-a", "CoreX", "-i", "audio-headphones", "Now Playing", cur])
                time.sleep(2.0)
        except KeyboardInterrupt:
            print("\nExited track monitor.")
            return

    info = get_now_playing()
    if not info:
        if short_mode:
            print("No media playing")
        else:
            log_warn("No active media streams detected (checked CoreX Radio, Spotify, Firefox, MPV, playerctl).")
            print(f"  {Style.GRAY}Tip: Run {Style.BOLD}cx stream-radio{Style.RESET}{Style.GRAY} to tune into 48+ commercial-free streams!{Style.RESET}\n")
        return

    track_str = info["raw"]

    if short_mode:
        print(f"🎵 {track_str}")
        return

    status_color = Style.GREEN if info["status"] == "Playing" else Style.YELLOW
    status_sym = "● Playing" if info["status"] == "Playing" else "⏸ Paused"

