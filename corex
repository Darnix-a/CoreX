def execute_command(cmd_id: str, cfg: CoreXConfig, dry_run: bool = False, extra_args: Optional[List[str]] = None):
    # Alias mapping for backward compatibility
    alias_map = {
        "comfy": "comfy-boot",
        "comfyui": "comfy-boot",
        "stream": "stream-yt",
        "rip": "rip-flac",
        "kill": "fkill",
        "vram": "vram-watch",
        "snap": "snap-now",
        "snapshot": "snap-now",
        "scratch": "notes",
        "ai": "ollama-ps",
        "docker": "docker-fzf",
    }
    actual_id = alias_map.get(cmd_id, cmd_id)
    spec = cfg.commands.get(actual_id)

    if not spec:
        log_error(f"Unknown command '{cmd_id}'. Run 'cx --list' or 'cx --help' for available actions.")
        sys.exit(1)

    # Dependency check
    for d in spec.deps:
        if not shutil.which(d):
            log_warn(f"Required binary '{d}' is missing! Command may fail. (Install: sudo pacman -S {d})")

    # Confirmation check
    if spec.confirm and not dry_run:
        print(f"{Style.YELLOW}{Style.BOLD}⚠️  Action '{actual_id}' requires confirmation. Proceed? [y/N]:{Style.RESET} ", end="", flush=True)
        try:
            ans = input().strip().lower()
            if ans not in ["y", "yes"]:
                log_info("Operation canceled.")
                return
        except (KeyboardInterrupt, EOFError):
            print()
            return

    # Check built-in dispatch
    if spec.command.startswith("cx __builtin "):
        builtin_name = spec.command.replace("cx __builtin ", "").strip()
        args = extra_args or []
        dispatch_builtin(builtin_name, cfg, dry_run=dry_run, extra_args=args)
        return

    # Shell execution
    final_cmd = spec.command
    if extra_args:
        # Append quoted arguments
        quoted_args = " ".join([f"'{a}'" if " " in a else a for a in extra_args])
        final_cmd = f"{final_cmd} {quoted_args}"

    if spec.requires_sudo and os.geteuid() != 0 and not final_cmd.strip().startswith("sudo"):
        final_cmd = f"sudo {final_cmd}"

    if dry_run:
        print(f"{Style.YELLOW}[DRY-RUN]{Style.RESET} {Style.BOLD}{final_cmd}{Style.RESET}")
        return

    try:
        ret = subprocess.run(final_cmd, shell=True)
        sys.exit(ret.returncode)
    except KeyboardInterrupt:
        sys.exit(130)


def dispatch_builtin(name: str, cfg: CoreXConfig, dry_run: bool = False, extra_args: Optional[List[str]] = None):
    args = extra_args or []
    if dry_run:
        print(f"{Style.YELLOW}[DRY-RUN]{Style.RESET} Built-in action: cx __builtin {name} {' '.join(args)}".strip())
        return

    if name == "comfy-boot":
        builtin_comfy_boot(cfg, dry_run=dry_run, extra_args=args)
    elif name == "ollama-ps":
        builtin_ollama_ps(cfg)
    elif name == "ollama-drop":
        builtin_ollama_drop(cfg)
    elif name == "model-symlink":
        builtin_model_symlink(cfg)
    elif name == "stream-yt":
        q = " ".join(args) if args else None
        builtin_stream_yt(video=False, query=q, dry_run=dry_run)
    elif name == "stream-video":
        q = " ".join(args) if args else None
        builtin_stream_yt(video=True, query=q, dry_run=dry_run)
    elif name == "stream-radio":
        builtin_stream_radio()
    elif name.startswith("rip-audio"):
        fmt = "opus" if "opus" in name else "flac"
        builtin_rip_audio(fmt=fmt, dry_run=dry_run)
    elif name == "trim-video":
        builtin_trim_video()
    elif name == "make-gif":
        builtin_make_gif()
    elif name == "pw-devices":
        builtin_pw_devices()
    elif name == "pw-volume":
        builtin_pw_volume()
    elif name == "fkill":
        flt = args[0] if args else None
        builtin_fkill(filter_term=flt)
    elif name == "snap-fzf":
        builtin_snap_fzf()
    elif name == "my-ip":
        builtin_my_ip()
    elif name == "port-audit":
        builtin_port_audit()
    elif name == "serve-dir":
        builtin_serve_dir()
    elif name == "docker-fzf":
        builtin_docker_fzf()
    elif name == "calc":
        expr = " ".join(args) if args else None
        builtin_calc(expr)
    elif name == "timer":
        dur = args[0] if args else None
        builtin_timer(dur)
    elif name == "stopwatch":
        builtin_stopwatch()
    elif name == "notes":
        t = " ".join(args) if args else None
        builtin_notes(cfg, title=t)
    elif name == "todo":
        builtin_todo(cfg)
    elif name == "sys-info":
        builtin_sys_info()
    elif name == "sens-watch":
        subprocess.run(["watch", "-n", "1", "sensors 2>/dev/null; echo; nvidia-smi --query-gpu=temperature.gpu,power.draw --format=csv,noheader 2>/dev/null"])
    elif name == "gpu-clock":
        subprocess.run(["sudo", "nvidia-smi", "-pm", "1"])
        log_success("Nvidia Persistence Mode Enabled.")
    elif name == "cpu-turboboost":
        p_intel = Path("/sys/devices/system/cpu/intel_pstate/no_turbo")
        p_amd = Path("/sys/devices/system/cpu/cpufreq/boost")
        if p_intel.exists():
            cur = p_intel.read_text().strip()
            new_val = "0" if cur == "1" else "1"
            subprocess.run(f"echo {new_val} | sudo tee {p_intel}", shell=True)
            log_success(f"Turbo Boost set to {'Enabled' if new_val == '0' else 'Disabled'}")
        elif p_amd.exists():
            cur = p_amd.read_text().strip()
            new_val = "1" if cur == "0" else "0"
            subprocess.run(f"echo {new_val} | sudo tee {p_amd}", shell=True)
            log_success(f"AMD Core Boost set to {'Enabled' if new_val == '1' else 'Disabled'}")
        else:
            log_warn("No Turbo Boost hardware control found.")
    elif name == "mon-res":
        subprocess.run(["hyprctl", "monitors"])
    elif name.startswith("mon-preset"):
        log_info(f"Applying monitor preset: {name}")
    elif name == "game-mode":
        subprocess.run("echo performance | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor", shell=True)
        log_success("Game Mode Activated: CPU governor set to performance.")
    else:
        log_warn(f"Built-in {name} not implemented.")


