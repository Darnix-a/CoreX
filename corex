class CoreXConfig:
    editor: str = ""
    notes_dir: Path = DEFAULT_NOTES_DIR
    color: bool = True
    comfyui_path: Path = Path.home() / "ComfyUI"
    comfyui_venv: str = "venv"
    comfyui_port: int = 8188
    comfyui_host: str = "127.0.0.1"
    vram_high_threshold_mb: int = 8192
    vram_low_threshold_mb: int = 4096
    comfyui_extra_flags: List[str] = dataclasses.field(default_factory=lambda: ["--preview-method", "auto"])
    comfyui_auto_browser: bool = True
    comfyui_notify: bool = True
    ollama_url: str = "http://127.0.0.1:11434"
    music_dir: Path = Path.home() / "Music"
    stream_provider: str = "ytsearch"
    stream_results_count: int = 25
    mpv_hwdec: str = "auto"
    rip_format: str = "flac"
    rip_flac_bits: str = "24"
    rip_opus_bitrate: str = "256k"
    snapshot_backend: str = "auto"
    snapper_config: str = "root"
    btrfs_mount: str = "/"
    custom_commands: Dict[str, Dict[str, str]] = dataclasses.field(default_factory=dict)


def load_config(config_path: Optional[Path] = None) -> CoreXConfig:
    path = config_path or DEFAULT_CONFIG_PATH
    cfg = CoreXConfig()
    if not path.exists():
        return cfg

    try:
        with open(path, "rb") as f:
            data = tomllib.load(f)

        gen = data.get("general", {})
        cfg.editor = gen.get("editor", "")
        cfg.notes_dir = Path(os.path.expanduser(gen.get("notes_dir", str(DEFAULT_NOTES_DIR))))
        cfg.color = gen.get("color", True)

        ai = data.get("ai", {})
        cfg.comfyui_path = Path(os.path.expanduser(ai.get("comfyui_path", "~/ComfyUI")))
        cfg.comfyui_venv = ai.get("comfyui_venv", "venv")
        cfg.comfyui_port = int(ai.get("comfyui_port", 8188))
        cfg.comfyui_host = str(ai.get("comfyui_host", "127.0.0.1"))
        cfg.vram_high_threshold_mb = int(ai.get("vram_high_threshold_mb", 8192))
        cfg.vram_low_threshold_mb = int(ai.get("vram_low_threshold_mb", 4096))
        cfg.comfyui_extra_flags = ai.get("comfyui_extra_flags", ["--preview-method", "auto"])
        cfg.comfyui_auto_browser = ai.get("comfyui_auto_browser", True)
        cfg.comfyui_notify = ai.get("comfyui_notify", True)
        cfg.ollama_url = ai.get("ollama_url", "http://127.0.0.1:11434")

        med = data.get("media", {})
        cfg.music_dir = Path(os.path.expanduser(med.get("music_dir", "~/Music")))
        cfg.stream_provider = med.get("stream_provider", "ytsearch")
        cfg.stream_results_count = int(med.get("stream_results_count", 25))
        cfg.mpv_hwdec = med.get("mpv_hwdec", "auto")
        cfg.rip_format = med.get("rip_format", "flac")
        cfg.rip_flac_bits = str(med.get("rip_flac_bits", "24"))
        cfg.rip_opus_bitrate = str(med.get("rip_opus_bitrate", "256k"))

        sys_sec = data.get("system", {})
        cfg.snapshot_backend = sys_sec.get("snapshot_backend", "auto")
        cfg.snapper_config = sys_sec.get("snapper_config", "root")
        cfg.btrfs_mount = sys_sec.get("btrfs_mount", "/")

        cfg.custom_commands = data.get("custom_commands", {})
    except Exception as e:
        log_warn(f"Failed to load config {path}: {e}. Using defaults.")

    return cfg


def get_default_editor(cfg: CoreXConfig) -> str:
    if cfg.editor and shutil.which(cfg.editor):
        return cfg.editor
    env_editor = os.environ.get("EDITOR") or os.environ.get("VISUAL")
    if env_editor and shutil.which(env_editor):
        return env_editor
    for cand in ["nvim", "micro", "helix", "nano", "vi"]:
        if shutil.which(cand):
            return cand
    return "nano"


# ---------------------------------------------------------------------------
# Process Execution & Signal Management
# ---------------------------------------------------------------------------
def run_cmd(
    cmd: List[str] | str,
    shell: bool = False,
    dry_run: bool = False,
    cwd: Optional[Path | str] = None,
    capture_output: bool = False,
    env: Optional[Dict[str, str]] = None,
) -> Tuple[int, str, str]:
    """Execute command with clean signal handling and dry-run support."""
    cmd_str = cmd if isinstance(cmd, str) else " ".join(cmd)
    if dry_run:
        print(f"{Style.YELLOW}[DRY-RUN]{Style.RESET} {Style.BOLD}{cmd_str}{Style.RESET}" + (f" (cwd: {cwd})" if cwd else ""))
        return 0, "", ""

    effective_env = os.environ.copy()
    if env:
        effective_env.update(env)

    try:
        if capture_output:
            res = subprocess.run(
                cmd,
                shell=shell,
                cwd=cwd,
                capture_output=True,
                text=True,
                env=effective_env,
            )
            return res.returncode, res.stdout, res.stderr
        else:
            res = subprocess.run(
                cmd,
                shell=shell,
                cwd=cwd,
                env=effective_env,
            )
            return res.returncode, "", ""
    except KeyboardInterrupt:
        return 130, "", ""
    except Exception as e:
        return 1, "", str(e)


def check_tool(tool_name: str) -> bool:
    return shutil.which(tool_name) is not None


def is_port_in_use(host: str, port: int) -> Tuple[bool, Optional[int]]:
    """Check if TCP port is active and attempt to discover the listening PID."""
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.2)
        try:
            s.connect((host, port))
            ret, out, _ = run_cmd(["ss", "-tulpn", f"sport = :{port}"], capture_output=True)
            match = re.search(r"pid=(\d+)", out)
            pid = int(match.group(1)) if match else None
            return True, pid
        except (ConnectionRefusedError, TimeoutError, OSError):
            return False, None


# ---------------------------------------------------------------------------
# FZF Integration Helper
# ---------------------------------------------------------------------------
def run_fzf(
    items: List[str],
    prompt: str = "cx > ",
    preview_cmd: Optional[str] = None,
    multi: bool = False,
    header: Optional[str] = None,
    preview_window: str = "right:55%:border-left:wrap",
    extra_args: Optional[List[str]] = None,
) -> List[str]:
    """Invoke fzf with customized styling, previews, and keybindings."""
    if not check_tool("fzf"):
        log_error("'fzf' is not installed! CoreX interactive interface requires fzf.")
        log_info("Install fzf via your package manager: sudo pacman -S fzf")
        sys.exit(1)

    # If stdin/stdout is not a tty, don't hang
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        if items:
            return [items[0]]
        return []

    fzf_args = [
        "fzf",
        "--ansi",
        f"--prompt={prompt}",
        "--height=85%",
        "--layout=reverse",
        "--border=rounded",
        "--color=bg+:#1e1e2e,bg:#181825,spinner:#f5e0dc,hl:#f38ba8",
        "--color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc",
        "--color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8",
    ]

    if multi:
        fzf_args.append("--multi")
    if header:
        fzf_args.extend(["--header", header])
    if preview_cmd:
        fzf_args.extend(["--preview", preview_cmd, f"--preview-window={preview_window}"])
    if extra_args:
        fzf_args.extend(extra_args)

    try:
        proc = subprocess.Popen(
            fzf_args,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
        stdout, _ = proc.communicate(input="\n".join(items))
        if proc.returncode != 0:
            return []
        selected = [line.strip() for line in stdout.strip().split("\n") if line.strip()]
        return selected
    except KeyboardInterrupt:
        return []


