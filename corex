        full_export = "--full" in args
        target_args = [a for a in args if a != "--full"]
        target = target_args[0] if target_args else ""
        builtin_export(cfg, target_path=target, full=full_export)
        sys.exit(0)

    if parsed.command == "import":
        src = (parsed.args[0] if parsed.args else "") or (unknown[0] if unknown else "")
        builtin_import(cfg, source_path=src)
        sys.exit(0)

    # Desktop Entry & Window Manager Integrations
    if parsed.command in ("install-desktop", "desktop-install"):
        builtin_install_desktop()
