def builtin_timer(duration_str: Optional[str] = None):
    dur_str = duration_str
    if not dur_str:
        print(f"{Style.CYAN}Timer duration (e.g. 5m, 30s, 1h):{Style.RESET} ", end="", flush=True)
        dur_str = input().strip()
    if not dur_str:
        return

    sec = 0
    m = re.match(r"^(\d+)([smh]?)$", dur_str)
    if m:
        val, unit = int(m.group(1)), m.group(2)
        if unit == "h":
            sec = val * 3600
        elif unit == "m":
            sec = val * 60
        else:
            sec = val
    else:
        log_error("Invalid duration format. Use 30s, 5m, 1h, etc.")
        return

    total = sec
    log_info(f"Countdown timer started for {dur_str}...")
    try:
        while sec > 0:
            pct = ((total - sec) / total) * 100
            bar = "█" * int((pct / 100) * 30)
            bar_pad = "░" * (30 - len(bar))
            mins, s = divmod(sec, 60)
            hrs, mins = divmod(mins, 60)
            t_disp = f"{hrs:02d}:{mins:02d}:{s:02d}" if hrs > 0 else f"{mins:02d}:{s:02d}"
            print(f"\r {Style.CYAN}⏳ [{Style.GREEN}{bar}{Style.DARK_GRAY}{bar_pad}{Style.CYAN}] {t_disp} remaining ({pct:.0f}%){Style.RESET}", end="", flush=True)
