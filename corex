def builtin_irq_top():
    print(box_header("HARDWARE & SOFTWARE INTERRUPTS (TOP IRQs)"))
    try:
        lines = Path("/proc/interrupts").read_text().splitlines()
        cpus = lines[0].split()
        num_cpus = len(cpus)
        print(f" {Style.BOLD}Online CPU Cores:{Style.RESET} {num_cpus}")
        print(f"\n {Style.BOLD}{'IRQ':<6} {'TOTAL':<14} {'TYPE':<16} {'DEVICE / SUBSYSTEM'}{Style.RESET}")
        print(f" {Style.DARK_GRAY}{'─' * 66}{Style.RESET}")
        irq_data = []
        for l in lines[1:]:
            parts = l.split(None, num_cpus + 2)
            if len(parts) >= num_cpus + 2:
                irq_id = parts[0].replace(":", "")
                counts = [int(x) for x in parts[1:num_cpus + 1] if x.isdigit()]
                total = sum(counts)
                irq_type = parts[num_cpus + 1] if len(parts) > num_cpus + 1 else ""
                device = parts[num_cpus + 2] if len(parts) > num_cpus + 2 else ""
                irq_data.append((total, irq_id, irq_type, device))
        irq_data.sort(reverse=True, key=lambda x: x[0])
        for tot, i_id, i_type, dev in irq_data[:20]:
            print(f" {i_id:<6} {tot:<14} {i_type:<16} {Style.CYAN}{dev}{Style.RESET}")
    except Exception as e:
        log_error(f"Cannot read /proc/interrupts: {e}")
    print(box_footer())


def builtin_oom_score():
    print(box_header("OUT-OF-MEMORY (OOM) KILLER BADNESS RANKING"))
    procs = []
    for pid_dir in Path("/proc").glob("[0-9]*"):
        try:
            pid = pid_dir.name
            score_f = pid_dir / "oom_score"
            cmd_f = pid_dir / "cmdline"
            if score_f.exists() and cmd_f.exists():
                score = int(score_f.read_text().strip())
                cmd = cmd_f.read_text().replace("\0", " ").strip()
                if not cmd:
                    cmd = (pid_dir / "comm").read_text().strip()
                procs.append((score, pid, cmd[:40]))
        except Exception:
            continue
    procs.sort(reverse=True, key=lambda x: x[0])
    print(f" {Style.BOLD}{'OOM SCORE':<12} {'PID':<8} {'COMMAND'}{Style.RESET}")
    print(f" {Style.DARK_GRAY}{'─' * 66}{Style.RESET}")
    for score, pid, cmd in procs[:25]:
        color = Style.RED if score > 500 else (Style.YELLOW if score > 100 else Style.GREEN)
        print(f" {color}{score:<12}{Style.RESET} {pid:<8} {cmd}")
    print(box_footer())


def builtin_ram_breakdown():
    print(box_header("PHYSICAL RAM FORENSIC BREAKDOWN"))
    try:
        mem = Path("/proc/meminfo").read_text()
        def get_kb(key: str) -> int:
            m = re.search(rf"^{key}:\s+(\d+)", mem, re.M)
            return int(m.group(1)) if m else 0

        tot = get_kb("MemTotal") // 1024
        free = get_kb("MemFree") // 1024
        avail = get_kb("MemAvailable") // 1024
        active = get_kb("Active") // 1024
        inactive = get_kb("Inactive") // 1024
        dirty = get_kb("Dirty") // 1024
        wb = get_kb("Writeback") // 1024
        anon = get_kb("AnonPages") // 1024
        slab = get_kb("Slab") // 1024
        s_rec = get_kb("SReclaimable") // 1024
        s_unrec = get_kb("SUnreclaim") // 1024
        zram_kb = get_kb("Zram")

        print(f" {Style.BOLD}Total Physical RAM:{Style.RESET}  {tot} MiB")
