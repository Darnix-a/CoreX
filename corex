def log_info(msg: str):
    print(f"{Style.BLUE}{Style.BOLD}◈{Style.RESET} {msg}")


def log_success(msg: str):
    print(f"{Style.GREEN}{Style.BOLD}✔{Style.RESET} {msg}")


def log_warn(msg: str):
    print(f"{Style.YELLOW}{Style.BOLD}▲{Style.RESET} {msg}")


def log_error(msg: str):
    print(f"{Style.RED}{Style.BOLD}✖{Style.RESET} {msg}", file=sys.stderr)


def log_step(step: str, detail: str):
    print(f"{Style.CYAN}{Style.BOLD}λ{Style.RESET} {Style.BOLD}{step}:{Style.RESET} {Style.GRAY}{detail}{Style.RESET}")


def box_header(title: str, width: int = 70, color: str = Style.CYAN) -> str:
    title_str = f" {title} " if title else ""
    line = "─" * max(0, width - len(title_str) - 3)
    return f"{color}╭─{Style.BOLD}{Style.WHITE}{title_str}{Style.RESET}{color}{line}╮{Style.RESET}"


def box_footer(width: int = 70, color: str = Style.CYAN) -> str:
    return f"{color}╰{'─' * max(0, width - 2)}╯{Style.RESET}"


# ---------------------------------------------------------------------------
# Declarative Command Model & TOML Config Loader
