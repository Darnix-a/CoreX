def get_install_hint(pkg: str) -> str:
    """Returns a tailored install command for the current distribution."""
    _, inst, _, distro = detect_package_manager()
    pkg_map = get_package_map(distro)
    actual_pkg = pkg_map.get(pkg, pkg)
    if inst:
        return f"{inst} {actual_pkg}"
    return f"Install {actual_pkg} via your package manager"


