def builtin_semver_bump():
    files = ["pyproject.toml", "package.json", "Cargo.toml"]
    target = None
    for f in files:
        if Path(f).exists():
            target = Path(f)
            break
    if not target:
        log_warn("No pyproject.toml, package.json, or Cargo.toml found in cwd.")
        return

    content = target.read_text()
    m = re.search(r'(version\s*=\s*["\'])([\d\.]+)(["\'])', content)
    if not m:
        m = re.search(r'("version":\s*["\'])([\d\.]+)(["\'])', content)
    if not m:
        log_error("Could not find version string.")
        return

    cur_v = m.group(2)
    parts = cur_v.split(".")
    while len(parts) < 3:
        parts.append("0")
    major, minor, patch = int(parts[0]), int(parts[1]), int(parts[2])

    v_patch = f"{major}.{minor}.{patch + 1}"
    v_minor = f"{major}.{minor + 1}.0"
    v_major = f"{major + 1}.0.0"

    print(f"Current version in {target.name}: {Style.BOLD}{cur_v}{Style.RESET}")
    choice = run_fzf([f"patch: {v_patch}", f"minor: {v_minor}", f"major: {v_major}"], prompt="Select version bump > ")
    if not choice:
        return
    new_v = choice[0].split(":")[1].strip()
    new_content = content.replace(m.group(0), f"{m.group(1)}{new_v}{m.group(3)}")
    target.write_text(new_content)
    log_success(f"Bumped version: {cur_v} -> {new_v} in {target.name}")


def builtin_mtu_bench():
    print(box_header("MTU / MSS PACKET SWEEP TEST"))
    # Find default gateway
    gw = "1.1.1.1"
    try:
        res = subprocess.run(["ip", "route", "show", "default"], capture_output=True, text=True)
        gw = res.stdout.split()[2]
    except Exception:
        pass
    log_info(f"Probing target {gw} for maximum non-fragmented packet size...")
    optimal = 1500
    for size in [1500, 1492, 1472, 1464, 1448, 1400, 1360]:
        # -M do means don't fragment
        cmd = ["ping", "-c", "1", "-M", "do", "-s", str(size), "-W", "1", gw]
        ret = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if ret.returncode == 0:
            optimal = size + 28 # Add IP+ICMP header
            print(f" {Style.GREEN}✔ Packet size {size} bytes passed (MTU = {optimal}){Style.RESET}")
            break
        else:
            print(f" {Style.RED}✖ Packet size {size} bytes fragmented{Style.RESET}")
    print(f"\n Recommended MTU for this interface: {Style.BOLD}{optimal}{Style.RESET}")
    print(box_footer())


def builtin_pw_link_fzf():
    res = subprocess.run(["pw-link", "-io"], capture_output=True, text=True)
    if res.returncode != 0:
        log_error("pw-link unavailable or PipeWire not running.")
        return
    ports = [p.strip() for p in res.stdout.strip().splitlines() if p.strip()]
    out_ports = [p for p in ports if ":output" in p or ":capture" in p]
    in_ports = [p for p in ports if ":input" in p or ":playback" in p]
    sel_out = run_fzf(out_ports, prompt="Select Output Source Port > ")
    if not sel_out:
        return
    sel_in = run_fzf(in_ports, prompt=f"Connect '{sel_out[0]}' to Input Sink > ")
    if not sel_in:
        return
    subprocess.run(["pw-link", sel_out[0], sel_in[0]])
    log_success(f"Linked: {sel_out[0]} -> {sel_in[0]}")


