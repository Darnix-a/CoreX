def get_default_config_path() -> Optional[Path]:
    """Finds the built-in base configuration template path."""
    candidates = [
        DEFAULT_CONFIG_TEMPLATE,
        Path(__file__).resolve().parent / "config.default.toml",
        Path("/usr/share/corex/config.default.toml"),
        Path("/usr/local/share/corex/config.default.toml"),
        Path.home() / ".local" / "share" / "corex" / "config.default.toml",
    ]
    for c in candidates:
        if c.exists():
            return c
    return None


def load_config(custom_path: Optional[Path] = None, ignore_cache: bool = False) -> CoreXConfig:
    user_config_path = custom_path or CONFIG_FILE
    default_path = get_default_config_path()

    user_stat = user_config_path.stat() if user_config_path.exists() else None
    tmpl_stat = default_path.stat() if default_path and default_path.exists() else None

    # Fast binary cache path (sub-1ms cold starts)
    if not ignore_cache and custom_path is None and CONFIG_CACHE_FILE.exists():
        try:
            import pickle
            with open(CONFIG_CACHE_FILE, "rb") as cf:
                cache_meta = pickle.load(cf)
            if (
                cache_meta.get("version") == VERSION
                and cache_meta.get("user_mtime") == (user_stat.st_mtime if user_stat else None)
                and cache_meta.get("user_size") == (user_stat.st_size if user_stat else None)
                and cache_meta.get("tmpl_mtime") == (tmpl_stat.st_mtime if tmpl_stat else None)
                and cache_meta.get("tmpl_size") == (tmpl_stat.st_size if tmpl_stat else None)
            ):
                cached_cfg = cache_meta["cfg"]
                cached_cfg.config_path = user_config_path.resolve()
                if cached_cfg.color:
                    apply_theme(cached_cfg.theme)
                return cached_cfg
        except Exception:
            pass

    cfg = CoreXConfig()
    cfg.config_path = user_config_path.resolve()
    try:
        import tomllib

        # 1. Layer 1: Load built-in defaults first (base catalog)
        if default_path and default_path.exists():
            try:
                with open(default_path, "rb") as df:
                    default_data = tomllib.load(df)

                def_gen = default_data.get("general", {})
                cfg.editor = def_gen.get("editor", "")
                cfg.notes_dir = Path(os.path.expanduser(def_gen.get("notes_dir", str(NOTES_DIR))))
                cfg.todo_file = Path(os.path.expanduser(def_gen.get("todo_file", str(TODO_FILE))))
                cfg.color = def_gen.get("color", True)
                cfg.theme = str(def_gen.get("theme", "catppuccin-mocha")).strip()

                def_ai = default_data.get("ai", {})
                cfg.comfyui_path = Path(os.path.expanduser(def_ai.get("comfyui_path", "~/ComfyUI")))
                cfg.comfyui_venv = def_ai.get("comfyui_venv", "venv")
                cfg.comfyui_port = int(def_ai.get("comfyui_port", 8188))
                cfg.comfyui_host = str(def_ai.get("comfyui_host", "127.0.0.1"))
                cfg.vram_high_threshold_mb = int(def_ai.get("vram_high_threshold_mb", 8192))
                cfg.vram_low_threshold_mb = int(def_ai.get("vram_low_threshold_mb", 4096))
                cfg.comfyui_extra_flags = list(def_ai.get("comfyui_extra_flags", ["--preview-method", "auto"]))
                cfg.comfyui_auto_browser = def_ai.get("comfyui_auto_browser", True)
                cfg.comfyui_notify = def_ai.get("comfyui_notify", True)
                cfg.ollama_url = def_ai.get("ollama_url", "http://127.0.0.1:11434")
                cfg.ollama_model = str(def_ai.get("model", "qwen2.5-coder:1.5b"))
                cfg.ollama_auto_boot = bool(def_ai.get("auto_boot", True))

                for cid, cdef in default_data.get("commands", {}).items():
                    cfg.commands[cid] = CommandSpec(
                        id=cid,
                        category=cdef.get("category", "General"),
                        description=cdef.get("description", ""),
                        command=cdef.get("command", ""),
                        preview_cmd=cdef.get("preview_cmd", ""),
                        requires_sudo=bool(cdef.get("requires_sudo", False)),
                        confirm=bool(cdef.get("confirm", False)),
                        deps=list(cdef.get("deps", [])),
                    )
            except Exception as e:
                log_warn(f"Failed parsing default config ({default_path}): {e}")

        # 2. If user config does not exist, initialize lightweight starter config
        if not user_config_path.exists():
            try:
                user_config_path.parent.mkdir(parents=True, exist_ok=True)
                starter_toml = (
                    "# CoreX (cx) User Configuration & Overrides\n"
                    "# Location: ~/.config/corex/config.toml\n"
                    "# Built-in defaults are automatically loaded. Add custom commands,\n"
                    "# setting overrides, or use 'disabled = true' to disable built-in actions.\n\n"
                    "[general]\n"
                    f'theme = "{cfg.theme}"\n\n'
                    "[commands]\n"
                )
                user_config_path.write_text(starter_toml, encoding="utf-8")
                user_stat = user_config_path.stat()
            except Exception:
                pass

        # 3. Layer 2: Deep-merge user overrides on top of defaults
        if user_config_path.exists() and (default_path is None or user_config_path != default_path):
            try:
                with open(user_config_path, "rb") as uf:
                    user_data = tomllib.load(uf)

                u_gen = user_data.get("general", {})
                if "editor" in u_gen:
                    cfg.editor = u_gen["editor"]
                if "notes_dir" in u_gen:
                    cfg.notes_dir = Path(os.path.expanduser(u_gen["notes_dir"]))
                if "todo_file" in u_gen:
                    cfg.todo_file = Path(os.path.expanduser(u_gen["todo_file"]))
                if "color" in u_gen:
                    cfg.color = bool(u_gen["color"])
                if "theme" in u_gen:
                    cfg.theme = str(u_gen["theme"]).strip()

                u_ai = user_data.get("ai", {})
                if "comfyui_path" in u_ai:
                    cfg.comfyui_path = Path(os.path.expanduser(u_ai["comfyui_path"]))
                if "comfyui_venv" in u_ai:
                    cfg.comfyui_venv = u_ai["comfyui_venv"]
                if "comfyui_port" in u_ai:
                    cfg.comfyui_port = int(u_ai["comfyui_port"])
                if "comfyui_host" in u_ai:
                    cfg.comfyui_host = str(u_ai["comfyui_host"])
                if "vram_high_threshold_mb" in u_ai:
                    cfg.vram_high_threshold_mb = int(u_ai["vram_high_threshold_mb"])
                if "vram_low_threshold_mb" in u_ai:
                    cfg.vram_low_threshold_mb = int(u_ai["vram_low_threshold_mb"])
                if "comfyui_extra_flags" in u_ai:
                    cfg.comfyui_extra_flags = list(u_ai["comfyui_extra_flags"])
                if "comfyui_auto_browser" in u_ai:
                    cfg.comfyui_auto_browser = bool(u_ai["comfyui_auto_browser"])
                if "comfyui_notify" in u_ai:
                    cfg.comfyui_notify = bool(u_ai["comfyui_notify"])
                if "ollama_url" in u_ai:
                    cfg.ollama_url = str(u_ai["ollama_url"])
                if "model" in u_ai:
                    cfg.ollama_model = str(u_ai["model"])
                elif "ollama_model" in u_ai:
                    cfg.ollama_model = str(u_ai["ollama_model"])
                if "auto_boot" in u_ai:
                    cfg.ollama_auto_boot = bool(u_ai["auto_boot"])
                elif "ollama_auto_boot" in u_ai:
                    cfg.ollama_auto_boot = bool(u_ai["ollama_auto_boot"])

                # Command overrides & extensions
                for cid, cdef in user_data.get("commands", {}).items():
                    # Check for disabled flag
                    is_dis = cdef.get("disabled", False)
                    if is_dis is True or str(is_dis).lower() in ("true", "1", "yes"):
                        if cid in cfg.commands:
                            del cfg.commands[cid]
                        continue

                    if cid in cfg.commands:
                        # Override existing built-in command properties
                        spec = cfg.commands[cid]
                        if "category" in cdef:
                            spec.category = cdef["category"]
                        if "description" in cdef:
                            spec.description = cdef["description"]
                        if "command" in cdef:
                            spec.command = cdef["command"]
                        if "preview_cmd" in cdef:
                            spec.preview_cmd = cdef["preview_cmd"]
                        if "requires_sudo" in cdef:
                            spec.requires_sudo = bool(cdef["requires_sudo"])
                        if "confirm" in cdef:
                            spec.confirm = bool(cdef["confirm"])
                        if "deps" in cdef:
                            spec.deps = list(cdef["deps"])
                    else:
                        # Append new custom user command
                        cfg.commands[cid] = CommandSpec(
                            id=cid,
                            category=cdef.get("category", "Custom Actions"),
                            description=cdef.get("description", ""),
                            command=cdef.get("command", ""),
                            preview_cmd=cdef.get("preview_cmd", ""),
                            requires_sudo=bool(cdef.get("requires_sudo", False)),
                            confirm=bool(cdef.get("confirm", False)),
                            deps=list(cdef.get("deps", [])),
                        )
            except Exception as e:
                log_warn(f"User config parse warning ({user_config_path}): {e}")

        if cfg.color:
            apply_theme(cfg.theme)

        # Save to fast binary cache
        if custom_path is None:
            try:
                import pickle
                CONFIG_CACHE_FILE.parent.mkdir(parents=True, exist_ok=True)
                u_stat = user_config_path.stat() if user_config_path.exists() else None
                t_stat = default_path.stat() if default_path and default_path.exists() else None
                cache_meta = {
                    "version": VERSION,
                    "user_mtime": u_stat.st_mtime if u_stat else None,
                    "user_size": u_stat.st_size if u_stat else None,
                    "tmpl_mtime": t_stat.st_mtime if t_stat else None,
                    "tmpl_size": t_stat.st_size if t_stat else None,
                    "cfg": cfg,
                }
                with open(CONFIG_CACHE_FILE, "wb") as cf:
                    pickle.dump(cache_meta, cf, protocol=pickle.HIGHEST_PROTOCOL)
            except Exception:
                pass

    except Exception as e:
        log_warn(f"Config load error: {e}")

    return cfg


def get_default_editor(cfg: CoreXConfig) -> str:
    if cfg.editor and shutil.which(cfg.editor):
        return cfg.editor
    env_ed = os.environ.get("EDITOR") or os.environ.get("VISUAL")
    if env_ed and shutil.which(env_ed):
        return env_ed
    for c in ["nvim", "micro", "helix", "nano", "vi"]:
        if shutil.which(c):
            return c
    return "nano"


