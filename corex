def builtin_doctor(cfg: CoreXConfig, dry_run: bool = False, auto_install: bool = False):
    print(box_header("COREX SYSTEM DOCTOR & DEPENDENCY AUDITOR"))
    log_info("Auditing command matrix, testing syntax and scanning dependencies...")

    total_commands = len(cfg.commands)
    ready_count = 0
    missing_deps_map: Dict[str, List[str]] = {}
    syntax_errs: List[Tuple[str, str]] = []

    pm, inst_prefix, update_cmd, distro = detect_package_manager()
    PKG_MAP = get_package_map(distro)

    known_builtins = {
        "comfy-boot", "ollama-ps", "ollama-drop", "model-symlink", "stream-yt",
        "stream-video", "stream-radio", "rip-audio", "trim-video", "make-gif",
        "pw-devices", "pw-volume", "fkill", "snap-fzf", "my-ip", "port-audit",
        "serve-dir", "docker-fzf", "calc", "timer", "stopwatch", "notes", "todo",
        "sys-info", "irq-top", "oom-score", "ram-breakdown", "hugepages-toggle",
        "socket-summary", "kmod-fzf", "vk-layers", "regex-test", "semver-bump",
        "mtu-bench", "pw-link-fzf", "port-forward", "doctor", "sens-watch",
        "gpu-clock", "cpu-turboboost", "mon-res", "mon-preset", "game-mode", "builder",
        "url-short", "ask", "models", "now-playing", "song", "np", "speedtest", "speed-check",
        "sys-update", "update", "fetch", "type-test", "typing", "snake", "quote", "zen", "clock", "matrix", "cmatrix",
        "bonsai", "tree", "share", "upload", "paste", "disks", "disk", "df", "audio-test", "sound-test", "sensors", "thermals", "colors", "palette", "colortest"
    }

    for cid, spec in cfg.commands.items():
        if cid == "doctor":
            ready_count += 1
            continue

        cmd_str = spec.command.strip()
        cmd_missing_deps = []

        # 1. Check declared dependencies
        for dep in spec.deps:
            if not shutil.which(dep):
                cmd_missing_deps.append(dep)
                missing_deps_map.setdefault(dep, []).append(cid)

        # 2. Check bash syntax for shell commands or built-in registry
        if not cmd_str.startswith("cx __builtin"):
            res = subprocess.run(["bash", "-n", "-c", cmd_str], capture_output=True, text=True)
            if res.returncode != 0:
                syntax_errs.append((cid, res.stderr.strip()))
        else:
            b_name = cmd_str.replace("cx __builtin ", "").strip().split()[0]
            if b_name not in known_builtins:
                syntax_errs.append((cid, f"Built-in '{b_name}' not implemented in dispatcher"))

        if not cmd_missing_deps:
            ready_count += 1

    pct = (ready_count / total_commands * 100) if total_commands else 0
    print(f" {Style.BOLD}Total Actions In Matrix:{Style.RESET}   {total_commands}")
    print(f" {Style.BOLD}Actions 100% Operational:{Style.RESET} {Style.GREEN}{Style.BOLD}{ready_count}{Style.RESET} / {total_commands} ({pct:.1f}%)")

    if syntax_errs:
        print(f" {Style.BOLD}Shell Syntax Errors:{Style.RESET}      {Style.RED}{len(syntax_errs)} detected{Style.RESET}")
        for cid, err in syntax_errs:
            print(f"   • {Style.RED}{cid}{Style.RESET}: {err}")
    else:
        print(f" {Style.BOLD}Shell Command Syntax:{Style.RESET}     {Style.GREEN}✔ 100% Clean & Valid{Style.RESET}")

    print(box_footer())

    if not missing_deps_map:
        log_success("All registered workstation actions have 100% of their dependencies satisfied!")
        return

    SPECIAL_INSTALL = {
        "demucs": "pipx install demucs (or uv tool install demucs)",
    }

    missing_system_pkgs = set()
    standalone_tools = []

    for dep, affected_cmds in sorted(missing_deps_map.items()):
        if dep in SPECIAL_INSTALL:
            standalone_tools.append((dep, SPECIAL_INSTALL[dep], affected_cmds))
        else:
            pkg = PKG_MAP.get(dep, dep)
            missing_system_pkgs.add(pkg)
            sample_cmds = ", ".join(affected_cmds[:3])
            if len(affected_cmds) > 3:
                sample_cmds += f" (+{len(affected_cmds) - 3} more)"
            print(f"  • {Style.RED}{dep:<14}{Style.RESET} -> package: {Style.CYAN}{pkg:<16}{Style.RESET} (needed by: {Style.GRAY}{sample_cmds}{Style.RESET})")

    if standalone_tools:
        print(f"\n{Style.YELLOW}{Style.BOLD}Python / Standalone Tools (Install via pipx or uv):{Style.RESET}")
        for dep, hint, affected_cmds in standalone_tools:
            sample_cmds = ", ".join(affected_cmds[:3])
            if len(affected_cmds) > 3:
                sample_cmds += f" (+{len(affected_cmds) - 3} more)"
            print(f"  • {Style.RED}{dep:<14}{Style.RESET} -> {Style.CYAN}{hint}{Style.RESET} (needed by: {Style.GRAY}{sample_cmds}{Style.RESET})")

    sorted_pkgs = sorted(missing_system_pkgs)

    if not sorted_pkgs:
        if standalone_tools:
            log_info("All missing dependencies are standalone / pipx tools. Install them using the commands above.")
        return

    if not pm or not inst_prefix:
        log_warn("No supported package manager (apt, dnf, zypper, pacman, paru, yay, apk, xbps) found. Please install packages manually:")
        print(f"  Packages: {' '.join(sorted_pkgs)}")
        return

    install_cmd = f"{inst_prefix} {' '.join(sorted_pkgs)}"
    distro_title = distro.title() if distro != "unknown" else "System"
    print(f"\n{Style.BOLD}Proposed Install Command ({distro_title} / {pm}):{Style.RESET}")
    print(f"  {Style.CYAN}{install_cmd}{Style.RESET}")

    if dry_run:
        print(f"\n{Style.YELLOW}[DRY-RUN]{Style.RESET} Skipped package installation.")
        return

    do_install = auto_install
    if not do_install:
        try:
            print(f"\n{Style.BOLD}Would you like to install {len(sorted_pkgs)} missing packages now? [Y/n]: {Style.RESET}", end="", flush=True)
            ans = input().strip().lower()
            if ans in ("", "y", "yes"):
                do_install = True
        except (KeyboardInterrupt, EOFError):
            print()
            return

    if do_install:
        log_info(f"Executing: {install_cmd}")
        ret = subprocess.run(install_cmd, shell=True)
        if ret.returncode == 0:
            log_success("Package installation completed successfully! Re-verifying...")
            resolved = [d for d in missing_deps_map if shutil.which(d)]
            still_missing = [d for d in missing_deps_map if not shutil.which(d)]
            if resolved:
                print(f"  {Style.GREEN}✔ Installed tools now active: {', '.join(resolved)}{Style.RESET}")
            if still_missing:
                print(f"  {Style.YELLOW}▲ Still missing (may need manual setup or reboot): {', '.join(still_missing)}{Style.RESET}")
            else:
                log_success("All workstation dependencies are now 100% installed and operational!")
        else:
            log_error(f"Package installation returned exit code {ret.returncode}.")
            if update_cmd:
                log_warn("If errors occurred, your package repositories may need a refresh:")
                print(f"  {Style.BOLD}{update_cmd}{Style.RESET}")


