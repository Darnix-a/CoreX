        "wpctl": "wireplumber",
        "xclip": "xclip",
        "xxd": "xxd",
        "yt-dlp": "yt-dlp",
        "zbarimg": "zbar",
    }

    known_builtins = {
        "comfy-boot", "ollama-ps", "ollama-drop", "model-symlink", "stream-yt",
        "stream-video", "stream-radio", "rip-audio", "trim-video", "make-gif",
        "pw-devices", "pw-volume", "fkill", "snap-fzf", "my-ip", "port-audit",
        "serve-dir", "docker-fzf", "calc", "timer", "stopwatch", "notes", "todo",
        "sys-info", "irq-top", "oom-score", "ram-breakdown", "hugepages-toggle",
        "socket-summary", "kmod-fzf", "vk-layers", "regex-test", "semver-bump",
        "mtu-bench", "pw-link-fzf", "port-forward", "doctor", "sens-watch",
        "gpu-clock", "cpu-turboboost", "mon-res", "mon-preset", "game-mode", "builder",
        "url-short"
    }

    for cid, spec in cfg.commands.items():
        if cid == "doctor":
            ready_count += 1
            continue

        cmd_str = spec.command.strip()
        cmd_missing_deps = []

        # 1. Check declared dependencies
        for dep in spec.deps:
            if not shutil.which(dep):
                cmd_missing_deps.append(dep)
                missing_deps_map.setdefault(dep, []).append(cid)

        # 2. Check bash syntax for shell commands or built-in registry
        if not cmd_str.startswith("cx __builtin"):
            res = subprocess.run(["bash", "-n", "-c", cmd_str], capture_output=True, text=True)
            if res.returncode != 0:
                syntax_errs.append((cid, res.stderr.strip()))
        else:
            b_name = cmd_str.replace("cx __builtin ", "").strip().split()[0]
            if b_name not in known_builtins:
                syntax_errs.append((cid, f"Built-in '{b_name}' not implemented in dispatcher"))

        if not cmd_missing_deps:
            ready_count += 1

    pct = (ready_count / total_commands * 100) if total_commands else 0
    print(f" {Style.BOLD}Total Actions In Matrix:{Style.RESET}   {total_commands}")
    print(f" {Style.BOLD}Actions 100% Operational:{Style.RESET} {Style.GREEN}{Style.BOLD}{ready_count}{Style.RESET} / {total_commands} ({pct:.1f}%)")

    if syntax_errs:
        print(f" {Style.BOLD}Shell Syntax Errors:{Style.RESET}      {Style.RED}{len(syntax_errs)} detected{Style.RESET}")
        for cid, err in syntax_errs:
