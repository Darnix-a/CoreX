def builtin_url_short(target_url: Optional[str] = None):
    """Shortens URL via multiple resilient APIs with automatic clipboard integration."""
    import urllib.parse
    import urllib.request

    url = (target_url or "").strip()
    if not url:
        clip = ""
        if shutil.which("wl-paste"):
            try:
                res = subprocess.run(["wl-paste"], capture_output=True, text=True, timeout=1.0)
                clip = res.stdout.strip()
            except Exception:
                pass
        if not clip and shutil.which("xclip"):
            try:
                res = subprocess.run(["xclip", "-o", "-selection", "clipboard"], capture_output=True, text=True, timeout=1.0)
                clip = res.stdout.strip()
            except Exception:
                pass

        if clip.startswith("http://") or clip.startswith("https://"):
            print(f" {Style.GRAY}Clipboard URL detected:{Style.RESET} {clip}")
            try:
                ans = input(f" {Style.BOLD}Use clipboard URL? [Y/n]: {Style.RESET}").strip().lower()
                if ans in ("", "y", "yes"):
                    url = clip
            except (KeyboardInterrupt, EOFError):
                print()
                return

    if not url:
        try:
            url = input(f" {Style.BOLD}Enter URL to shorten: {Style.RESET}").strip()
        except (KeyboardInterrupt, EOFError):
            print()
            return

    if not url:
        log_warn("No URL provided.")
        return

    if not url.startswith("http://") and not url.startswith("https://"):
        url = "https://" + url

    log_info(f"Shortening URL: {url} ...")
    short_url = None

    # Endpoint 1: TinyURL
    try:
        enc = urllib.parse.quote(url, safe="")
        req = urllib.request.Request(f"https://tinyurl.com/api-create.php?url={enc}", headers={"User-Agent": "CoreX/3.0"})
        with urllib.request.urlopen(req, timeout=5.0) as resp:
            out = resp.read().decode("utf-8").strip()
            if out.startswith("http://") or out.startswith("https://"):
                short_url = out
    except Exception:
        pass

    # Endpoint 2: clck.ru (Fallback)
    if not short_url:
        try:
            enc = urllib.parse.quote(url, safe="")
            req = urllib.request.Request(f"https://clck.ru/--?url={enc}", headers={"User-Agent": "CoreX/3.0"})
            with urllib.request.urlopen(req, timeout=5.0) as resp:
                out = resp.read().decode("utf-8").strip()
                if out.startswith("http://") or out.startswith("https://"):
                    short_url = out
        except Exception:
            pass

    # Endpoint 3: is.gd (Fallback)
    if not short_url:
        try:
            enc = urllib.parse.quote(url, safe="")
            req = urllib.request.Request(f"https://is.gd/create.php?format=simple&url={enc}", headers={"User-Agent": "CoreX/3.0"})
            with urllib.request.urlopen(req, timeout=5.0) as resp:
                out = resp.read().decode("utf-8").strip()
                if out.startswith("http://") or out.startswith("https://"):
                    short_url = out
        except Exception:
            pass

    if not short_url:
        log_error("Failed to shorten URL. All shortening endpoints (TinyURL, Clck.ru, is.gd) were unreachable.")
        return

    # Auto-copy to system clipboard
    copied = False
    if shutil.which("wl-copy"):
        try:
            subprocess.run(["wl-copy"], input=short_url.encode("utf-8"), check=True)
            copied = True
        except Exception:
            pass
    if not copied and shutil.which("xclip"):
        try:
            subprocess.run(["xclip", "-selection", "clipboard"], input=short_url.encode("utf-8"), check=True)
            copied = True
        except Exception:
            pass

    print(f"\n{box_header('URL SHORTENER RESULT', color=Style.GREEN)}")
    print(f" {Style.BOLD}Original:{Style.RESET}   {Style.GRAY}{url}{Style.RESET}")
    print(f" {Style.BOLD}Shortened:{Style.RESET}  {Style.BOLD}{Style.CYAN}{short_url}{Style.RESET}")
    if copied:
        print(f" {Style.GREEN}✔ Copied to system clipboard!{Style.RESET}")
    print(box_footer(color=Style.GREEN))


