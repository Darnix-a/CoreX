def save_command_override(cid: str, override_dict: Dict[str, Any], config_path: Optional[Path] = None):
    """Saves or updates overridden fields for a built-in command in user's config.toml."""
    path = config_path or CONFIG_FILE
    if not path.exists():
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text("[general]\n\n[commands]\n", encoding="utf-8")

    text = path.read_text(encoding="utf-8")
    pattern = rf"(?ms)^\[commands\.{re.escape(cid)}\].*?(?=(?:^\[|\Z))"

    def escape_toml(val: str) -> str:
        return val.replace('\\', '\\\\').replace('"', '\\"').replace('\n', '\\n')

    lines = [f"[commands.{cid}]"]
    for k, v in override_dict.items():
        if isinstance(v, bool):
            lines.append(f'{k} = {"true" if v else "false"}')
        elif isinstance(v, list):
            fmtd = ", ".join([f'"{escape_toml(str(x))}"' for x in v])
            lines.append(f'{k} = [{fmtd}]')
        elif isinstance(v, (int, float)):
            lines.append(f'{k} = {v}')
        else:
            lines.append(f'{k} = "{escape_toml(str(v))}"')

    block = "\n".join(lines) + "\n\n"
    if re.search(pattern, text):
        new_text = re.sub(pattern, block, text)
    else:
        new_text = text.rstrip() + "\n\n" + block

    path.write_text(new_text, encoding="utf-8")
    invalidate_config_cache()


def builtin_export(cfg: CoreXConfig, target_path: Optional[str] = None, full: bool = False):
    out_path = Path(target_path).expanduser() if target_path else Path.home() / ".local" / "share" / "corex" / f"corex-profile-{int(time.time())}.json"
    out_path.parent.mkdir(parents=True, exist_ok=True)

    state = load_user_state()
    default_path = get_default_config_path()
    default_cmds = {}
    if default_path and default_path.exists():
        try:
            import tomllib
            with open(default_path, "rb") as df:
                d_data = tomllib.load(df)
                default_cmds = d_data.get("commands", {})
        except Exception:
            pass

    user_data = {}
    if CONFIG_FILE.exists():
        try:
            import tomllib
            with open(CONFIG_FILE, "rb") as uf:
                user_data = tomllib.load(uf)
        except Exception:
            pass

    u_cmds = user_data.get("commands", {})
    custom_cmds = {}
    overrides = {}
    disabled_cmds = []

    for cid, cdef in u_cmds.items():
        if cdef.get("disabled") is True or str(cdef.get("disabled")).lower() in ("true", "1", "yes"):
            disabled_cmds.append(cid)
        elif cid not in default_cmds:
            custom_cmds[cid] = cdef
        else:
            diff = {}
            d_spec = default_cmds[cid]
            for fld in ("category", "description", "command", "preview_cmd", "requires_sudo", "confirm", "deps"):
                if fld in cdef and cdef[fld] != d_spec.get(fld):
                    diff[fld] = cdef[fld]
            if diff:
                overrides[cid] = diff

    for cid, spec in cfg.commands.items():
        if cid not in default_cmds and cid not in custom_cmds:
            custom_cmds[cid] = {
                "category": spec.category,
                "description": spec.description,
                "command": spec.command,
                "preview_cmd": spec.preview_cmd,
                "requires_sudo": spec.requires_sudo,
                "confirm": spec.confirm,
                "deps": spec.deps,
            }

    export_data = {
        "format": "corex-profile",
        "version": VERSION,
        "type": "full-catalog" if full else "user-overrides",
        "exported_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "hostname": socket.gethostname(),
        "theme": cfg.theme,
        "editor": cfg.editor,
        "pinned": state.get("pinned", []),
    }

    if full:
        export_data["commands"] = {
            cid: {
                "category": spec.category,
                "description": spec.description,
                "command": spec.command,
                "preview_cmd": spec.preview_cmd,
                "requires_sudo": spec.requires_sudo,
                "confirm": spec.confirm,
                "deps": spec.deps,
            }
            for cid, spec in cfg.commands.items()
        }
        export_data["total_catalog_count"] = len(cfg.commands)
    else:
        export_data["custom_commands"] = custom_cmds
        export_data["overrides"] = overrides
        export_data["disabled_commands"] = disabled_cmds
        export_data["total_catalog_count"] = len(cfg.commands)

    with open(out_path, "w") as f:
        json.dump(export_data, f, indent=2)

    c_green = "\033[38;2;166;227;161m"
    print(f"\n {c_green}{Style.BOLD}✔ CoreX Profile Successfully Exported!{Style.RESET}")
    print(f"   • Destination: {Style.CYAN}{out_path}{Style.RESET}")
    print(f"   • Export Type: {Style.BOLD}{'Full Catalog (--full)' if full else 'User Overrides & Custom Actions'}{Style.RESET}")
    print(f"   • Theme:       {Style.BOLD}{cfg.theme}{Style.RESET}")
    print(f"   • Pinned:      {len(export_data['pinned'])} favorites")
    if full:
        print(f"   • Commands:    {len(cfg.commands)} catalog actions")
    else:
        print(f"   • Custom Cmds: {len(custom_cmds)} custom actions")
        if overrides:
            print(f"   • Overrides:   {len(overrides)} built-in modifications")
        if disabled_cmds:
            print(f"   • Disabled:    {len(disabled_cmds)} hidden built-ins")
    print(f"\n   To restore on another machine: {Style.CYAN}cx import {out_path}{Style.RESET}\n")


def builtin_import(cfg: CoreXConfig, source_path: Optional[str] = None):
    if not source_path:
        log_error("Usage: cx import <path-to-profile.json>")
        return

    in_path = Path(source_path).expanduser()
    if not in_path.is_file():
        log_error(f"Import file not found: {in_path}")
        return

    try:
        with open(in_path, "r") as f:
            data = json.load(f)
    except Exception as e:
        log_error(f"Failed to parse profile JSON: {e}")
        return

    if data.get("format") != "corex-profile":
        log_error("Invalid profile format. File must be generated by 'cx export'.")
        return

    bak_path = CONFIG_FILE.parent / f"config.toml.bak.{int(time.time())}"
    if CONFIG_FILE.exists():
        shutil.copy(CONFIG_FILE, bak_path)

    imp_theme = data.get("theme")
    if imp_theme and imp_theme in THEMES:
        set_config_theme(imp_theme)
        apply_theme(imp_theme)

    imp_pinned = data.get("pinned", [])
    if isinstance(imp_pinned, list):
        state = load_user_state()
        state["pinned"] = imp_pinned
        save_user_state(state)

    restored_custom = 0
    restored_overrides = 0
    restored_disabled = 0

    imp_custom = data.get("custom_commands", {})
    if isinstance(imp_custom, dict):
        for cid, cdef in imp_custom.items():
            save_command_to_config(
                cid=cid,
                category=cdef.get("category", "Custom Actions"),
                description=cdef.get("description", ""),
                command=cdef.get("command", ""),
                preview_cmd=cdef.get("preview_cmd", ""),
                requires_sudo=bool(cdef.get("requires_sudo", False)),
                confirm=bool(cdef.get("confirm", False)),
                deps=list(cdef.get("deps", [])),
            )
            restored_custom += 1

    imp_overrides = data.get("overrides", {})
    if isinstance(imp_overrides, dict):
        for cid, diff in imp_overrides.items():
            save_command_override(cid, diff)
            restored_overrides += 1

    imp_disabled = data.get("disabled_commands", [])
    if isinstance(imp_disabled, list):
        for cid in imp_disabled:
            remove_command_from_config(cid)
            restored_disabled += 1

    # Also handle legacy / full catalog profiles
    imp_all_cmds = data.get("commands", {})
    if isinstance(imp_all_cmds, dict) and not imp_custom and not imp_overrides:
        default_path = get_default_config_path()
        default_cmds = {}
        if default_path and default_path.exists():
            try:
                import tomllib
                with open(default_path, "rb") as df:
                    default_cmds = tomllib.load(df).get("commands", {})
            except Exception:
                pass
        for cid, cdef in imp_all_cmds.items():
            if cid not in default_cmds:
                save_command_to_config(
                    cid=cid,
                    category=cdef.get("category", "Custom Actions"),
                    description=cdef.get("description", ""),
                    command=cdef.get("command", ""),
                    preview_cmd=cdef.get("preview_cmd", ""),
                    requires_sudo=bool(cdef.get("requires_sudo", False)),
                    confirm=bool(cdef.get("confirm", False)),
                    deps=list(cdef.get("deps", [])),
                )
                restored_custom += 1

    invalidate_config_cache()

    c_green = "\033[38;2;166;227;161m"
    print(f"\n {c_green}{Style.BOLD}✔ CoreX Profile Successfully Imported!{Style.RESET}")
    print(f"   • Backup created:    {Style.GRAY}{bak_path}{Style.RESET}")
    print(f"   • Theme applied:     {Style.BOLD}{imp_theme or 'unchanged'}{Style.RESET}")
    print(f"   • Pinned favorites:  {len(imp_pinned)} restored")
    print(f"   • Custom actions:    {restored_custom} restored")
    if restored_overrides:
        print(f"   • Overrides applied: {restored_overrides} restored")
    if restored_disabled:
        print(f"   • Disabled actions:  {restored_disabled} restored")
    print(f"\n   Run {Style.CYAN}cx{Style.RESET} to open your updated menu.\n")


