def render_preview(cmd_id: str, cfg: CoreXConfig):
    spec = cfg.commands.get(cmd_id)
    if not spec:
        return

    tag = CATEGORY_TAGS.get(spec.category, "@action")
    t_color = get_tag_color(tag)
    preview_cols = int(os.environ.get("FZF_PREVIEW_COLUMNS", 40))
    div_len = max(16, min(preview_cols - 4, 48))
    div = f"  {Style.DARK_GRAY}" + "─" * div_len + f"{Style.RESET}"

    print(f"\n  {t_color}⚡ {Style.BOLD}{Style.WHITE}{spec.id}{Style.RESET}")
    print(f"  {Style.GRAY}{spec.description}{Style.RESET}")
    print(f"  {Style.DARK_GRAY}• Press [?] to close details{Style.RESET}\n")
    print(div)

    # Metadata & User State
    state = load_user_state()
    is_pinned = spec.id in set(state.get("pinned", []))
    usage_count = state.get("frequency", {}).get(spec.id, 0)
    pin_badge = f"{Style.YELLOW}★ Pinned to Favorites{Style.RESET}" if is_pinned else f"{Style.DARK_GRAY}• Unpinned [Tab]{Style.RESET}"
    freq_str = f"{Style.CYAN}{usage_count} run{'s' if usage_count != 1 else ''}{Style.RESET}"
    print(f"  {Style.BOLD}Status:{Style.RESET}       {pin_badge}  {Style.DARK_GRAY}•{Style.RESET}  {freq_str}")
    print(f"  {Style.BOLD}Category:{Style.RESET}     {t_color}{tag}{Style.RESET} {Style.DARK_GRAY}•{Style.RESET} {Style.GRAY}{spec.category}{Style.RESET}")

    if spec.requires_sudo:
        priv_badge = f"{Style.YELLOW}⚡ ROOT (Sudo Required){Style.RESET}"
    else:
        priv_badge = f"{Style.GREEN}🛡️  USER (Safe){Style.RESET}"

    if spec.confirm:
        conf_badge = f"{Style.YELLOW}⚠️  Confirmation Prompt{Style.RESET}"
    else:
        conf_badge = f"{Style.GRAY}⚡ Instant Execution{Style.RESET}"

    print(f"  {Style.BOLD}Privilege:{Style.RESET}    {priv_badge}  {Style.DARK_GRAY}•{Style.RESET}  {conf_badge}")

    # Dependency check
    if spec.deps:
        dep_statuses = []
        for d in spec.deps:
            if shutil.which(d):
                dep_statuses.append(f"{Style.GREEN}✔ {d}{Style.RESET}")
            else:
                dep_statuses.append(f"{Style.RED}▲ {d} missing{Style.RESET}")
        print(f"  {Style.BOLD}Dependencies:{Style.RESET} {' '.join(dep_statuses)}")
    else:
        print(f"  {Style.BOLD}Dependencies:{Style.RESET} {Style.GRAY}✔ Native shell / none{Style.RESET}")

    if spec.id == "comfy-boot":
        print(f"  {Style.BOLD}Target Root:{Style.RESET}  {cfg.comfyui_path} (venv: {cfg.comfyui_venv})")
        tot, free = get_nvidia_vram()
        if free is not None:
            flag = "--highvram" if free >= cfg.vram_high_threshold_mb else ("--lowvram" if free < cfg.vram_low_threshold_mb else "--normalvram")
            print(f"  {Style.BOLD}Calculated:{Style.RESET}   {Style.GREEN}{flag}{Style.RESET} ({free} MiB free VRAM / {tot} MiB total)")

    print(f"\n{div}")
    print(f"  {Style.BOLD}{Style.CYAN}SHELL COMMAND{Style.RESET}")
    cmd_lines = spec.command.strip().splitlines()
    for line in cmd_lines[:8]:
        print(f"   {Style.DARK_GRAY}❯{Style.RESET} {Style.WHITE}{line}{Style.RESET}")
    if len(cmd_lines) > 8:
        print(f"   {Style.GRAY}... ({len(cmd_lines) - 8} more lines){Style.RESET}")

    pcmd = spec.preview_cmd.strip() if spec.preview_cmd else ""
    if pcmd:
        # If preview_cmd is just an echo string, treat it as a clean Usage / Note
        if (pcmd.startswith("echo '") and pcmd.endswith("'")) or (pcmd.startswith('echo "') and pcmd.endswith('"')):
            echo_msg = pcmd[6:-1].strip()
            if echo_msg and echo_msg.lower() != spec.description.lower():
                print(f"\n{div}")
                print(f"  {Style.BOLD}USAGE & NOTES{Style.RESET}")
                print(f"  {Style.GRAY}{echo_msg}{Style.RESET}")
        elif not pcmd.startswith("cx __preview"):
            print(f"\n{div}")
            print(f"  {Style.BOLD}{Style.PURPLE}LIVE SYSTEM TELEMETRY{Style.RESET}")
            try:
                res = subprocess.run(pcmd, shell=True, timeout=2.5, capture_output=True, text=True)
                out_lines = [l for l in res.stdout.splitlines() if l.strip()]
                if out_lines:
                    for l in out_lines[:10]:
                        print(f"   {Style.DARK_GRAY}│{Style.RESET} {l}")
                    if len(out_lines) > 10:
                        print(f"   {Style.GRAY}... ({len(out_lines) - 10} more lines){Style.RESET}")
                elif res.stderr:
                    print(f"   {Style.GRAY}{res.stderr.strip()}{Style.RESET}")
            except subprocess.TimeoutExpired:
                print(f"   {Style.GRAY}[Telemetry probe timed out]{Style.RESET}")
            except Exception as e:
                print(f"   {Style.GRAY}[Telemetry error: {e}]{Style.RESET}")


