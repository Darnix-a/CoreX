def builtin_todo(cfg: CoreXConfig):
    import datetime
    import json
    cfg.todo_file.parent.mkdir(parents=True, exist_ok=True)
    tasks: List[Dict[str, Any]] = []
    if cfg.todo_file.exists():
        try:
            tasks = json.loads(cfg.todo_file.read_text())
