def main():
    signal.signal(signal.SIGINT, lambda sig, frame: sys.exit(130))
    if hasattr(signal, "SIGPIPE"):
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)

    parsed, unknown = parse_cli_args(sys.argv[1:])

    if parsed.version:
        print(f"CoreX (cx) v{VERSION} - 150+ Action Workstation Engine")
        sys.exit(0)

    cfg = load_config(parsed.config)

    if parsed.list:
        for cid, spec in sorted(cfg.commands.items()):
            tag = CATEGORY_TAGS.get(spec.category, "@misc")
            print(f"{cid}\t{tag}\t{spec.category}\t{spec.description}")
        sys.exit(0)

    # Internal helper: return formatted lines for FZF reload
    if parsed.command == "__fzf_items":
        print("\n".join(format_cockpit_items(cfg)))
        sys.exit(0)

    # Internal helper: direct dispatch for cx __builtin <name>
    if parsed.command == "__builtin":
        b_name = (parsed.args[0] if parsed.args else "") or (unknown[0] if unknown else "")
        b_args = (parsed.args[1:] if len(parsed.args) > 1 else []) + unknown[1:]
        dispatch_builtin(b_name, cfg, dry_run=parsed.dry_run, extra_args=b_args)
        sys.exit(0)

    # Internal preview callback for fzf
    if parsed.command == "__preview":
        target = (parsed.args[0] if parsed.args else "") or (unknown[0] if unknown else "")
        render_preview(target, cfg)
        sys.exit(0)

    # Internal helper: get raw command string for Ctrl+Y clipboard
    if parsed.command == "__get_cmd":
        target = (parsed.args[0] if parsed.args else "") or (unknown[0] if unknown else "")
        spec = cfg.commands.get(target)
        if spec:
            print(spec.command, end="")
        sys.exit(0)

    # Internal helper: edit and run for Ctrl+E hotkey
    if parsed.command == "__edit_run":
        import tempfile
        target = (parsed.args[0] if parsed.args else "") or (unknown[0] if unknown else "")
        spec = cfg.commands.get(target)
        if spec:
            ed = get_default_editor(cfg)
            with tempfile.NamedTemporaryFile("w+", suffix=".sh", delete=False) as tf:
                tf.write(f"#!/usr/bin/env bash\n# Editing action: {spec.id}\n{spec.command}\n")
                tmp_path = tf.name
            subprocess.run([ed, tmp_path])
            try:
                mod_cmd = Path(tmp_path).read_text().splitlines()
                exec_lines = [l for l in mod_cmd if l.strip() and not l.startswith("#")]
                if exec_lines:
                    log_info(f"Executing edited script for {spec.id}...")
                    subprocess.run("\n".join(exec_lines), shell=True)
            finally:
                Path(tmp_path).unlink(missing_ok=True)
        sys.exit(0)

    # Completions generation
    if parsed.command == "completions":
        target_shell = (parsed.args[0] if parsed.args else "fish").lower()
        if target_shell == "fish":
            print(generate_fish_completions(cfg))
        elif target_shell == "zsh":
            print(generate_zsh_completions(cfg))
        else:
            print(generate_bash_completions(cfg))
        sys.exit(0)

    if parsed.help:
        print_banner(parsed.dry_run, parsed.bg)
        print(f"""
USAGE:
  cx                              Launch 150+ action interactive Mission Control TUI
  cx <command> [args...]          Execute command directly with zero latency
  cx new [name]                   Launch In-App Command Builder wizard
  cx builder                      Open Command Builder & Action Studio menu
  cx edit <command>               Edit an existing action
  cx delete <command>             Delete an action from configuration
  cx --dry-run <command> [args]   Preview command safely
  cx --bg <command> [args...]     Detach command into background systemd user scope
  cx --list                       Print all {len(cfg.commands)} registered commands and category tags

TUI HOTKEYS:
  • ENTER:   Execute action immediately
  • CTRL-N:  Open In-App Command Builder (Create & register new action)
  • CTRL-R:  Reload command catalog in-place
  • CTRL-D:  Preview with --dry-run without leaving TUI
  • CTRL-Y:  Copy underlying shell command to clipboard
  • CTRL-E:  Open command in $EDITOR before running
  • ?:       Toggle action preview pane

CATEGORIES & FILTER TAGS:
  • @kernel   Kernel Tracing, Interrupts & eBPF            (11 actions)
  • @vulkan   Vulkan, 3D & Graphics Telemetry              (11 actions)
  • @mem      Memory, HugePages & Storage Forensics        (11 actions)
  • @netflow  Network Traffic Analysis & Socket Forensics  (11 actions)
  • @dsp      Audio Synthesis, Signal Routing & Metrology  (10 actions)
  • @docker   Container, Pod & Service Micro-Orchestration (10 actions)
  • @code     Local Development & Code Diagnostics         (14 actions)
  • @ai       AI, CUDA & Deep Learning                     (12 actions)
  • @audio    Media, Audio & PipeWire Power-Tools          (13 actions)
  • @gpu      Gaming, Hardware & Display Orchestration     (8 actions)
  • @sys      System Architecture & BTRFS Snapshotting     (9 actions)
  • @net      Network, VPN & Remote Infrastructure         (9 actions)
  • @dev      Git, Dev & Code Utilities                    (10 actions)
  • @daily    Daily Driver Quality-of-Life & Crypto/Files  (15 actions)

FLAGS:
  --dry-run                       Preview command execution without running
  --bg                            Detach command in background (systemd-run / nohup)
  -y, --yes                       Bypass confirmation prompts
  --list                          List all commands for scripting / completion
  --config <path>                 Custom TOML config file
  -h, --help                      Show help
  -v, --version                   Show version
""")
        sys.exit(0)

    # Naked execution: launch interactive mission-control cockpit
    if not parsed.command:
        run_interactive_cockpit(cfg, dry_run=parsed.dry_run)
        sys.exit(0)

    # Direct subshell execution
    extra = (parsed.args or []) + unknown
    if parsed.yes and "-y" not in extra:
        extra.append("-y")
    execute_command(parsed.command, cfg, dry_run=parsed.dry_run, bg_run=parsed.bg, extra_args=extra)


if __name__ == "__main__":
    main()
