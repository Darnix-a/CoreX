        v_bitrate_str = f"{float(v_bitrate) / 1000000.0:.2f} Mbps" if v_bitrate else ""

        stream_lbl = f"VIDEO STREAM #{vs.get('index', idx)}" if len(video_streams) > 1 else "VIDEO STREAM"
        print(f"\n  {Style.BOLD}{Style.PURPLE}{stream_lbl}:{Style.RESET}")
        print(f"   {Style.DARK_GRAY}•{Style.RESET} Codec:           {Style.WHITE}{c_long}{Style.RESET}" + (f" ({profile})" if profile and profile != "unknown" else ""))
        print(f"   {Style.DARK_GRAY}•{Style.RESET} Dimensions:      {Style.CYAN}{width}x{height}{Style.RESET} " + (f"({aspect})" if aspect else ""))
        if fps_disp:
