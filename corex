def builtin_find(cfg: CoreXConfig, query: str = "", extra_args: Optional[List[str]] = None):
    all_terms = ([query] if query else []) + (extra_args or [])
    clean_query = " ".join(all_terms).strip().lower()

    c_blue = "\033[38;2;137;180;250m"
    c_mauve = "\033[38;2;203;166;247m"
    rst = Style.RESET
    bld = Style.BOLD
    dim = Style.DIM

    if not clean_query:
        print(f"\n {Style.YELLOW}Usage:{rst} cx find <term> [e.g. cx find audio, cx find gpu, cx find docker]\n")
        return

    matches = []
    for cid, spec in cfg.commands.items():
        tag = CATEGORY_TAGS.get(spec.category, "@misc")
        haystack = f"{cid} {tag} {spec.category} {spec.description} {spec.command}".lower()
        if clean_query in haystack:
            score = 0
            if cid == clean_query:
                score = 100
            elif cid.startswith(clean_query):
                score = 80
            elif clean_query in cid:
                score = 60
            elif clean_query in tag.lower():
                score = 50
            elif clean_query in spec.description.lower():
                score = 40
            else:
                score = 20
            matches.append((score, cid, spec, tag))

    for alias, target in COMMAND_ALIASES.items():
        if clean_query in alias.lower() and target in cfg.commands:
            spec = cfg.commands[target]
            tag = CATEGORY_TAGS.get(spec.category, "@misc")
            matches.append((70, alias, spec, tag))

    seen = {}
    for score, cid, spec, tag in matches:
        if cid not in seen or score > seen[cid][0]:
            seen[cid] = (score, cid, spec, tag)

    ranked = sorted(seen.values(), key=lambda x: x[0], reverse=True)

    print(f"\n {c_blue}{bld}╭─ COREX ACTION FINDER ───────────────────────────────────────────────╮{rst}")
    print(f" {c_blue}│{rst} Results for query: {c_mauve}{bld}'{clean_query}'{rst} ({len(ranked)} actions found){' ' * max(0, 36 - len(clean_query) - len(str(len(ranked))))}{c_blue}│{rst}")
    print(f" {c_blue}╰─────────────────────────────────────────────────────────────────────╯{rst}\n")

    if not ranked:
        print(f"   {dim}No actions matched '{clean_query}'.{rst}")
        print(f"   {dim}Run 'cx --list' to browse all {len(cfg.commands)} available commands.{rst}\n")
        return

    for _, cid, spec, tag in ranked[:25]:
        t_col = get_tag_color(tag)
        is_alias = cid in COMMAND_ALIASES
        target_info = f" {dim}(alias for {COMMAND_ALIASES[cid]}){rst}" if is_alias else ""
        print(f"   • {bld}{cid:<18}{rst}{target_info} {t_col}{tag:<8}{rst} {dim}{spec.description}{rst}")
        cmd_snippet = spec.command.strip().replace("\n", " ")
        if len(cmd_snippet) > 70:
            cmd_snippet = cmd_snippet[:67] + "..."
        print(f"     {dim}Command:{rst} {Style.GRAY}{cmd_snippet}{rst}")

    if len(ranked) > 25:
        print(f"\n   {dim}... and {len(ranked) - 25} more actions. Run 'cx' for full interactive fuzzy menu.{rst}")

    print(f"\n   {dim}Tip: Run any action directly with 'cx <action>' or preview with 'cx --dry-run <action>'{rst}\n")


