def builtin_custom(cfg: CoreXConfig, extra_args: Optional[List[str]] = None):
    """List, inspect, and manage user-defined custom actions and overrides."""
    args = extra_args or []

    default_path = get_default_config_path()
    default_cmds = {}
    if default_path and default_path.exists():
        try:
            import tomllib
            with open(default_path, "rb") as df:
                d_data = tomllib.load(df)
            default_cmds = d_data.get("commands", {})
        except Exception:
            pass

    user_cmds = {}
    disabled_cmds = []
    overrides = {}
    if CONFIG_FILE.exists():
        try:
            import tomllib
            with open(CONFIG_FILE, "rb") as uf:
                u_data = tomllib.load(uf)
            for ucid, ucdef in u_data.get("commands", {}).items():
                if ucdef.get("disabled") is True or str(ucdef.get("disabled")).lower() in ("true", "1", "yes"):
                    disabled_cmds.append(ucid)
                elif ucid not in default_cmds:
                    user_cmds[ucid] = ucdef
                else:
                    diff = {}
                    d_spec = default_cmds.get(ucid, {})
                    for fld in ("category", "description", "command", "preview_cmd", "requires_sudo", "confirm", "deps"):
                        if fld in ucdef and ucdef[fld] != d_spec.get(fld):
                            diff[fld] = ucdef[fld]
                    if diff:
                        overrides[ucid] = diff
        except Exception:
            pass

    # Also check cfg.commands for any custom actions not in default_cmds
    for cid, spec in cfg.commands.items():
        if cid not in default_cmds and cid not in user_cmds:
            user_cmds[cid] = {
                "category": spec.category,
                "description": spec.description,
                "command": spec.command,
                "preview_cmd": spec.preview_cmd,
                "requires_sudo": spec.requires_sudo,
                "confirm": spec.confirm,
                "deps": spec.deps,
            }

    # CLI subcommands: --list / --raw for scripting
    if args and args[0] in ("--list", "-l", "--raw"):
        for cid in sorted(user_cmds.keys()):
            spec = cfg.commands.get(cid)
            desc = spec.description if spec else user_cmds[cid].get("description", "")
            cat = spec.category if spec else user_cmds[cid].get("category", "Custom")
            print(f"{cid}\t{cat}\t{desc}")
        return

    # Help
    if args and args[0] in ("-h", "--help", "help"):
        print(box_header("USER CUSTOM ACTIONS & OVERRIDES"))
        print(f"""
 {Style.BOLD}USAGE:{Style.RESET}
   cx custom                       Interactive custom action browser & launcher
   cx custom --list, -l            Print tab-delimited list of custom actions
   cx new [name]                   Create a new custom action via interactive wizard
   cx builder                      Launch Action Studio to create, edit, or delete actions
""")
        print(box_footer())
        return

    print(box_header("USER CUSTOM ACTIONS & OVERRIDES"))
    if not user_cmds and not disabled_cmds and not overrides:
        print(f"  {Style.GRAY}No custom actions or overrides found in {CONFIG_FILE}.{Style.RESET}\n")
        print(f"  {Style.DARK_GRAY}To create a new custom action:{Style.RESET}")
        print(f"    ❯ {Style.WHITE}cx new [action-name]{Style.RESET}     (Interactive Wizard)")
        print(f"    ❯ {Style.WHITE}cx builder{Style.RESET}               (Command Studio Menu)\n")
        print(f"  {Style.DARK_GRAY}To add an action manually, edit {CONFIG_FILE}:{Style.RESET}")
        print(f"    {Style.WHITE}[commands.my-task]{Style.RESET}")
        print(f"    category = \"Daily Driver Quality-of-Life & Crypto/Files\"")
        print(f"    description = \"My custom routine\"")
        print(f"    command = \"echo 'Hello CoreX'\"\n")
        print(box_footer())
        return

    if user_cmds:
        print(f"  {Style.BOLD}{Style.WHITE}REGISTERED CUSTOM ACTIONS ({len(user_cmds)}):{Style.RESET}")
        print(f"  {'ID':<20} {'CATEGORY':<28} {'DESCRIPTION'}")
        print(f"  {Style.DARK_GRAY}{'─' * 76}{Style.RESET}")
        for cid in sorted(user_cmds.keys()):
            spec = cfg.commands.get(cid)
            cat = (spec.category if spec else user_cmds[cid].get("category", "Custom Actions"))
            desc = (spec.description if spec else user_cmds[cid].get("description", ""))
            tag = CATEGORY_TAGS.get(cat, "@custom")
            t_col = get_tag_color(tag)
            print(f"  {Style.BOLD}{cid:<20}{Style.RESET} {t_col}{tag:<10}{Style.RESET} {Style.GRAY}{cat[:16]:<17}{Style.RESET} {desc}")

    if overrides:
        print(f"\n  {Style.BOLD}{Style.YELLOW}BUILT-IN OVERRIDES ({len(overrides)}):{Style.RESET}")
        for oid in sorted(overrides.keys()):
            print(f"  • {Style.BOLD}{oid}{Style.RESET}: {Style.CYAN}{list(overrides[oid].keys())}{Style.RESET}")

    if disabled_cmds:
        print(f"\n  {Style.BOLD}{Style.RED}DISABLED BUILT-IN ACTIONS ({len(disabled_cmds)}):{Style.RESET}")
        for did in sorted(disabled_cmds):
            print(f"  • {Style.DARK_GRAY}{did} (hidden from catalog){Style.RESET}")

    print(box_footer())

    # If running interactively with custom commands, offer fzf execution
    if user_cmds and shutil.which("fzf") and sys.stdin.isatty() and not args:
