def builtin_rip_audio(fmt: str = "flac", dry_run: bool = False):
    vids = list(Path.cwd().glob("*.mp4")) + list(Path.cwd().glob("*.mkv")) + list(Path.cwd().glob("*.webm"))
    if not vids:
        log_warn("No video files (.mp4, .mkv, .webm) found in current directory.")
        return

    selected = run_fzf([v.name for v in vids], prompt=f"Select video(s) for {fmt.upper()} rip [TAB multi] > ", multi=True)
    if not selected:
        return

    for fname in selected:
        src = Path(fname)
        out = src.with_suffix(f".{fmt}")
        if fmt == "flac":
            cmd = ["ffmpeg", "-y", "-i", str(src), "-vn", "-c:a", "flac", "-sample_fmt", "s32", "-threads", "0", str(out)]
        else:
            cmd = ["ffmpeg", "-y", "-i", str(src), "-vn", "-c:a", "libopus", "-b:a", "160k", "-threads", "0", str(out)]

        log_step("Extracting", f"{src.name} -> {out.name}")
        if dry_run:
            print(f"{Style.YELLOW}[DRY-RUN]{Style.RESET} {' '.join(cmd)}")
        else:
            subprocess.run(cmd, check=False)
            log_success(f"Exported: {out.name}")


def builtin_trim_video():
    vids = [f.name for f in Path.cwd().iterdir() if f.suffix.lower() in [".mp4", ".mkv", ".webm", ".mov"]]
    if not vids:
        log_warn("No video files in current directory.")
        return

    sel = run_fzf(vids, prompt="Select video to trim > ")
    if not sel:
        return
    vid = sel[0]

    print(f"{Style.CYAN}Start timestamp (e.g. 00:01:30):{Style.RESET} ", end="", flush=True)
    start = input().strip()
    print(f"{Style.CYAN}End timestamp (e.g. 00:02:45):{Style.RESET} ", end="", flush=True)
