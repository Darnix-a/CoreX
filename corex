def builtin_docker_fzf():
    engine = "docker" if shutil.which("docker") else ("podman" if shutil.which("podman") else None)
    if not engine:
        log_error("Neither Docker nor Podman installed.")
        return
    res = subprocess.run([engine, "ps", "-a", "--format", "{{.ID}}\t{{.Names}}\t{{.Status}}\t{{.Image}}"], capture_output=True, text=True)
    if res.returncode != 0 or not res.stdout.strip():
        log_info("No containers found.")
        return

    items = []
    for l in res.stdout.strip().splitlines():
        p = l.split("\t")
        cid, name, stat = p[0], p[1], p[2]
        icon = f"{Style.GREEN}●{Style.RESET}" if "Up" in stat else f"{Style.RED}○{Style.RESET}"
        items.append(f"{cid}\t{icon} {name:<20}\t{stat}")

    extra = [
        "--delimiter=\t",
        "--with-nth=2,3",
        "--header=ENTER: Tail Logs | CTRL-R: Restart | CTRL-K: Stop | CTRL-E: Shell",
        f"--bind=ctrl-r:execute({engine} restart {{1}})+reload({engine} ps -a --format '{{{{.ID}}}}\t{{{{.Names}}}}\t{{{{.Status}}}}')",
        f"--bind=ctrl-k:execute({engine} stop {{1}})+reload({engine} ps -a --format '{{{{.ID}}}}\t{{{{.Names}}}}\t{{{{.Status}}}}')",
        f"--bind=ctrl-e:execute({engine} exec -it {{1}} sh -c 'bash || sh')",
    ]
    sel = run_fzf(items, prompt="docker > ", preview_cmd=f"{engine} logs --tail 40 {{1}}", extra_args=extra)
    if not sel:
        return
    cid = sel[0].split("\t")[0]
    subprocess.run([engine, "logs", "-f", "--tail", "100", cid])


def builtin_calc(expr: Optional[str] = None):
    import math
    exp = expr
    if not exp:
        print(f"{Style.CYAN}Expression (supports sqrt, sin, cos, pi, log, etc.):{Style.RESET} ", end="", flush=True)
        try:
            exp = input().strip()
        except (KeyboardInterrupt, EOFError):
            return
    if not exp:
        return

    safe_dict = {k: getattr(math, k) for k in dir(math) if not k.startswith("_")}
    safe_dict.update({"abs": abs, "round": round, "max": max, "min": min, "pow": pow})
    try:
        res = eval(exp, {"__builtins__": None}, safe_dict)
        print(f"{Style.CYAN}{Style.BOLD}Result:{Style.RESET} {Style.GREEN}{Style.BOLD}{res}{Style.RESET}")
    except Exception as e:
        log_error(f"Evaluation error: {e}")


def builtin_timer(duration_str: Optional[str] = None):
    dur_str = duration_str
    if not dur_str:
        print(f"{Style.CYAN}Timer duration (e.g. 5m, 30s, 1h):{Style.RESET} ", end="", flush=True)
        dur_str = input().strip()
    if not dur_str:
        return

    sec = 0
    m = re.match(r"^(\d+)([smh]?)$", dur_str)
    if m:
        val, unit = int(m.group(1)), m.group(2)
        if unit == "h":
            sec = val * 3600
        elif unit == "m":
            sec = val * 60
        else:
            sec = val
    else:
        log_error("Invalid duration format. Use 30s, 5m, 1h, etc.")
        return

    total = sec
    log_info(f"Countdown timer started for {dur_str}...")
    try:
        while sec > 0:
            pct = ((total - sec) / total) * 100
            bar = "█" * int((pct / 100) * 30)
            bar_pad = "░" * (30 - len(bar))
            mins, s = divmod(sec, 60)
            hrs, mins = divmod(mins, 60)
            t_disp = f"{hrs:02d}:{mins:02d}:{s:02d}" if hrs > 0 else f"{mins:02d}:{s:02d}"
            print(f"\r {Style.CYAN}⏳ [{Style.GREEN}{bar}{Style.DARK_GRAY}{bar_pad}{Style.CYAN}] {t_disp} remaining ({pct:.0f}%){Style.RESET}", end="", flush=True)
            time.sleep(1)
            sec -= 1
        print(f"\n\a{Style.GREEN}{Style.BOLD}✔ Timer completed! Time is up.{Style.RESET}")
        if shutil.which("notify-send"):
            subprocess.run(["notify-send", "CoreX Timer", f"Timer for {dur_str} completed!"])
    except KeyboardInterrupt:
        print(f"\n{Style.YELLOW}Timer canceled.{Style.RESET}")


def builtin_stopwatch():
    print(box_header("PRECISION STOPWATCH"))
    print(" [CTRL+C]: Stop")
    print(box_footer())
    start = time.time()
    try:
        while True:
            elapsed = time.time() - start
            m, s = divmod(elapsed, 60)
            ms = int((elapsed - int(elapsed)) * 1000)
            print(f"\r {Style.CYAN}{Style.BOLD}⏱  {int(m):02d}:{int(s):02d}.{ms:03d}{Style.RESET}", end="", flush=True)
            time.sleep(0.04)
    except KeyboardInterrupt:
        elapsed = time.time() - start
        m, s = divmod(elapsed, 60)
        ms = int((elapsed - int(elapsed)) * 1000)
        print(f"\n{Style.GREEN}✔ Final Time: {int(m):02d}:{int(s):02d}.{ms:03d}{Style.RESET}")


def builtin_notes(cfg: CoreXConfig, title: Optional[str] = None):
    import datetime
    cfg.notes_dir.mkdir(parents=True, exist_ok=True)
    ed = get_default_editor(cfg)
    ts = datetime.datetime.now().strftime("%Y-%m-%d_%H%M%S")
    if title:
        sanitized = re.sub(r"[^\w\-]", "_", title.strip())
        note = cfg.notes_dir / f"{ts}_{sanitized}.md"
        note.write_text(f"# {title}\nDate: {datetime.datetime.now()}\n\n")
        subprocess.run([ed, str(note)])
        return

    notes = sorted(list(cfg.notes_dir.glob("*.md")), key=lambda p: p.stat().st_mtime, reverse=True)
    if not notes:
        note = cfg.notes_dir / f"{ts}_scratch.md"
        note.write_text(f"# Scratchpad\nDate: {datetime.datetime.now()}\n\n")
        subprocess.run([ed, str(note)])
        return

    items = [f"{p.name}\t{datetime.datetime.fromtimestamp(p.stat().st_mtime).strftime('%Y-%m-%d %H:%M')}" for p in notes]
    extra = [
        "--delimiter=\t",
        "--header=ENTER: Open | CTRL-D: Delete",
        f"--bind=ctrl-d:execute(rm -f '{cfg.notes_dir}/'{{1}})+reload(ls -1t '{cfg.notes_dir}' | awk '{{print $1}}')",
    ]
    sel = run_fzf(items, prompt="notes > ", preview_cmd=f"cat '{cfg.notes_dir}/'{{1}}", extra_args=extra)
    if sel:
        chosen = cfg.notes_dir / sel[0].split("\t")[0]
        subprocess.run([ed, str(chosen)])


def builtin_todo(cfg: CoreXConfig):
    import datetime
    import json
    cfg.todo_file.parent.mkdir(parents=True, exist_ok=True)
    tasks: List[Dict[str, Any]] = []
    if cfg.todo_file.exists():
        try:
            tasks = json.loads(cfg.todo_file.read_text())
        except Exception:
            tasks = []

    items = []
    for idx, t in enumerate(tasks):
        done = t.get("done", False)
        box = f"{Style.GREEN}[✔]{Style.RESET}" if done else f"{Style.YELLOW}[ ]{Style.RESET}"
        items.append(f"{idx}\t{box} {t.get('task')}")

    items.append("+ [Add new task...]")
    extra = [
        "--delimiter=\t",
        "--with-nth=2",
        "--header=ENTER: Toggle Done / Add | CTRL-D: Delete Task",
    ]
    sel = run_fzf(items, prompt="todo > ", extra_args=extra)
    if not sel:
        return

    choice = sel[0]
    if "+ [Add new task" in choice:
        print(f"{Style.CYAN}Enter new task description:{Style.RESET} ", end="", flush=True)
        txt = input().strip()
        if txt:
            tasks.append({"task": txt, "done": False, "created": datetime.datetime.now().isoformat()})
            cfg.todo_file.write_text(json.dumps(tasks, indent=2))
            log_success(f"Added task: {txt}")
    else:
        idx = int(choice.split("\t")[0])
        tasks[idx]["done"] = not tasks[idx]["done"]
        cfg.todo_file.write_text(json.dumps(tasks, indent=2))
        st = "completed" if tasks[idx]["done"] else "uncompleted"
        log_success(f"Task marked as {st}.")


def builtin_sys_info():
    uname = os.uname()
    uptime_sec = 0
    try:
        with open("/proc/uptime") as f:
            uptime_sec = float(f.readline().split()[0])
    except Exception:
        pass

    hrs, rem = divmod(int(uptime_sec), 3600)
    mins, _ = divmod(rem, 60)
    days, hrs = divmod(hrs, 24)
    up_str = f"{days}d {hrs}h {mins}m" if days > 0 else f"{hrs}h {mins}m"

    distro_name = "Linux"
    try:
        if Path("/etc/os-release").exists():
            for line in Path("/etc/os-release").read_text().splitlines():
                if line.startswith("PRETTY_NAME="):
                    distro_name = line.split("=", 1)[1].strip().strip('"')
                    break
    except Exception:
        pass

    print(box_header("SYSTEM HARDWARE & KERNEL"))
    print(f" {Style.BOLD}OS / Distro:{Style.RESET}    {distro_name}")
    print(f" {Style.BOLD}Kernel:{Style.RESET}         {uname.release} ({uname.machine})")
    print(f" {Style.BOLD}Hostname:{Style.RESET}       {uname.nodename}")
    print(f" {Style.BOLD}Uptime:{Style.RESET}         {up_str}")

    tot_v, free_v = get_nvidia_vram()
    if tot_v:
        print(f" {Style.BOLD}GPU VRAM:{Style.RESET}       {tot_v - free_v} MiB / {tot_v} MiB used ({free_v} MiB free)")

    try:
        with open("/proc/meminfo") as f:
            mem = f.read()
            m_tot = int(re.search(r"MemTotal:\s+(\d+)", mem).group(1)) // 1024
            m_avail = int(re.search(r"MemAvailable:\s+(\d+)", mem).group(1)) // 1024
            print(f" {Style.BOLD}RAM Usage:{Style.RESET}      {m_tot - m_avail} MiB / {m_tot} MiB used ({m_avail} MiB available)")
    except Exception:
        pass
    print(box_footer())


def builtin_sys_update(cfg: CoreXConfig, extra_args: Optional[List[str]] = None):
    args = extra_args or []
    is_preview = "--preview" in args

    pm, inst_prefix, update_cmd, distro = detect_package_manager()

    if is_preview:
        print(box_header("SYSTEM UPDATE & REPOSITORY TELEMETRY"))
        print(f" {Style.BOLD}Detected Distro:{Style.RESET}  {distro} ({pm})")
        running_kernel = os.uname().release
        print(f" {Style.BOLD}Running Kernel:{Style.RESET}   {running_kernel}")

        official_updates: List[str] = []
        aur_updates: List[str] = []
        flatpak_updates: List[str] = []

        def check_pm_updates():
            nonlocal official_updates
            if shutil.which("checkupdates"):
                try:
                    res = subprocess.run(["checkupdates"], capture_output=True, text=True, timeout=3)
                    official_updates = [l for l in res.stdout.splitlines() if l.strip()]
                except Exception:
                    pass
            elif pm == "pacman":
                try:
                    res = subprocess.run(["pacman", "-Qu"], capture_output=True, text=True, timeout=2)
                    official_updates = [l for l in res.stdout.splitlines() if l.strip()]
                except Exception:
                    pass
            elif pm == "apt":
                try:
                    res = subprocess.run("apt list --upgradable 2>/dev/null | grep -v 'Listing...'", shell=True, capture_output=True, text=True, timeout=3)
                    official_updates = [l for l in res.stdout.splitlines() if l.strip()]
                except Exception:
                    pass
            elif pm == "dnf":
                try:
                    res = subprocess.run(["dnf", "check-update", "-q"], capture_output=True, text=True, timeout=3)
                    official_updates = [l for l in res.stdout.splitlines() if l.strip() and not l.startswith("Last metadata")]
                except Exception:
                    pass
            elif pm == "zypper":
                try:
                    res = subprocess.run(["zypper", "list-updates"], capture_output=True, text=True, timeout=3)
                    official_updates = [l for l in res.stdout.splitlines() if l.strip() and not l.startswith("Loading")]
                except Exception:
                    pass

        def check_aur_updates():
            nonlocal aur_updates
            aur_tool = shutil.which("paru") or shutil.which("yay")
            if aur_tool:
                try:
                    res = subprocess.run([aur_tool, "-Qua"], capture_output=True, text=True, timeout=3)
                    aur_updates = [l for l in res.stdout.splitlines() if l.strip()]
                except Exception:
                    pass

        def check_flatpak_updates():
            nonlocal flatpak_updates
            if shutil.which("flatpak"):
                try:
                    res = subprocess.run(["flatpak", "remote-ls", "--updates"], capture_output=True, text=True, timeout=3)
                    lines = [l for l in res.stdout.splitlines() if l.strip()]
                    if len(lines) > 1:
                        flatpak_updates = lines[1:]
                except Exception:
                    pass

        with ThreadPoolExecutor(max_workers=3) as ex:
            f1 = ex.submit(check_pm_updates)
            f2 = ex.submit(check_aur_updates)
            f3 = ex.submit(check_flatpak_updates)
            f1.result()
            f2.result()
            f3.result()

        total_pending = len(official_updates) + len(aur_updates) + len(flatpak_updates)
        if total_pending == 0:
            print(f"\n {Style.GREEN}{Style.BOLD}✔ System is completely up to date!{Style.RESET}")
        else:
            print(f"\n {Style.BOLD}Pending Updates:{Style.RESET}   {Style.YELLOW}{Style.BOLD}{total_pending}{Style.RESET} package(s) available")
            if official_updates:
                print(f"   • {Style.CYAN}Native Repos ({pm}):{Style.RESET} {len(official_updates)}")
            if aur_updates:
                print(f"   • {Style.MAGENTA}AUR Packages:{Style.RESET}       {len(aur_updates)}")
            if flatpak_updates:
                print(f"   • {Style.BLUE}Flatpak Apps/Runtimes:{Style.RESET} {len(flatpak_updates)}")

            print(f"\n {Style.BOLD}Pending Items Preview:{Style.RESET}")
            for it in official_updates[:8]:
                print(f"   {Style.GRAY}• {it}{Style.RESET}")
            if len(official_updates) > 8:
                print(f"   {Style.DARK_GRAY}... and {len(official_updates) - 8} more repo package(s){Style.RESET}")

            if aur_updates:
                print(f"   {Style.MAGENTA}AUR:{Style.RESET}")
                for it in aur_updates[:5]:
                    print(f"   {Style.GRAY}• {it}{Style.RESET}")
                if len(aur_updates) > 5:
                    print(f"   {Style.DARK_GRAY}... and {len(aur_updates) - 5} more AUR package(s){Style.RESET}")

            if flatpak_updates:
                print(f"   {Style.BLUE}Flatpaks:{Style.RESET}")
                for it in flatpak_updates[:4]:
                    app = it.split()[0] if it.split() else it
                    print(f"   {Style.GRAY}• {app}{Style.RESET}")
                if len(flatpak_updates) > 4:
                    print(f"   {Style.DARK_GRAY}... and {len(flatpak_updates) - 4} more Flatpak(s){Style.RESET}")

        print(f"\n {Style.BOLD}System Maintenance Telemetry:{Style.RESET}")
        installed_kernels = []
        if Path("/usr/lib/modules").exists():
            installed_kernels = [p.name for p in Path("/usr/lib/modules").iterdir() if p.is_dir()]
        if running_kernel not in installed_kernels and installed_kernels:
            print(f"   {Style.YELLOW}⚠️  Kernel mismatch: Running {running_kernel}, installed: {', '.join(installed_kernels)}{Style.RESET}")
        else:
            print(f"   {Style.GREEN}✔ Kernel modules match running kernel ({running_kernel}){Style.RESET}")

        if pm in ("pacman", "paru", "yay") or distro == "arch":
            try:
                res = subprocess.run("find /etc -maxdepth 3 -name '*.pacnew' 2>/dev/null", shell=True, capture_output=True, text=True, timeout=1)
                pacnews = [l for l in res.stdout.splitlines() if l.strip()]
                if pacnews:
                    print(f"   {Style.YELLOW}⚠️  {len(pacnews)} .pacnew file(s) pending merge (run 'sudo pacdiff'){Style.RESET}")
                else:
                    print(f"   {Style.GREEN}✔ No pending .pacnew files{Style.RESET}")
            except Exception:
                pass

            try:
                res = subprocess.run("pacman -Qtdq 2>/dev/null", shell=True, capture_output=True, text=True, timeout=1)
                orphans = [l for l in res.stdout.splitlines() if l.strip()]
                if orphans:
                    print(f"   {Style.CYAN}ℹ  {len(orphans)} orphan package(s) detected (run 'cx pkg-orphans'){Style.RESET}")
            except Exception:
                pass

        print(box_footer())
        return

    # Normal execution mode
    print(box_header("COREX WORKSTATION SYSTEM UPDATER"))
    print(f" {Style.BOLD}Target Distro:{Style.RESET}    {distro}")
    print(f" {Style.BOLD}Package Manager:{Style.RESET}  {pm}")
    print(box_footer())
    print()

    cachy_update_bin = shutil.which("cachy-update")
    if cachy_update_bin:
        log_info("Launching CachyOS update engine (cachy-update)...")
        forward_args = [a for a in args if a not in ("-y", "--yes", "--preview")]
        res = subprocess.run([cachy_update_bin] + forward_args)
        if res.returncode != 0:
            log_warn(f"cachy-update exited with code {res.returncode}")
        else:
            log_success("System upgrade completed successfully via cachy-update!")
        return

    aur_bin = shutil.which("paru") or shutil.which("yay")
    if pm == "pacman":
        if aur_bin:
            log_info(f"Running full system & AUR update via {os.path.basename(aur_bin)}...")
            cmd = [aur_bin, "-Syu"]
        else:
            log_info("Running pacman system update...")
            cmd = ["sudo", "pacman", "-Syu"]
    elif pm == "apt":
        log_info("Running apt update & upgrade...")
        cmd = ["sudo", "apt", "update", "&&", "sudo", "apt", "upgrade"]
    elif pm == "dnf":
        log_info("Running dnf upgrade...")
        cmd = ["sudo", "dnf", "upgrade"]
    elif pm == "zypper":
        log_info("Running zypper update...")
        cmd = ["sudo", "zypper", "update"]
    elif pm == "apk":
        log_info("Running apk update & upgrade...")
        cmd = ["sudo", "apk", "update", "&&", "sudo", "apk", "upgrade"]
    elif pm == "xbps":
        log_info("Running xbps-install -Su...")
        cmd = ["sudo", "xbps-install", "-Su"]
    else:
        log_error(f"Unsupported package manager: {pm}")
        return

    if isinstance(cmd, list) and "&&" in cmd:
        res = subprocess.run(" ".join(cmd), shell=True)
    else:
        res = subprocess.run(cmd)

    if res.returncode != 0:
        log_warn(f"System update returned exit code {res.returncode}")
    else:
        log_success("Core system packages upgraded successfully.")

    flatpak_bin = shutil.which("flatpak")
    if flatpak_bin:
