        else:
            print(f"\n{Style.CYAN}Stream URL:{Style.RESET} {st_url}\n")
        return

    _play_radio_stream(st_obj)


def get_now_playing() -> Optional[Dict[str, Any]]:
    """Detects currently playing track from CoreX Radio IPC, MPRIS (playerctl), or MPV sockets."""
    # 1. Check CoreX Radio mpv socket
    sock_path = "/tmp/corex-radio.sock"
    if os.path.exists(sock_path):
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(1.5)
            s.connect(sock_path)
            sf = s.makefile("r", encoding="utf-8")

            s.sendall(json.dumps({"command": ["get_property", "metadata"], "request_id": 1}).encode("utf-8") + b"\n")
            meta = {}
            while True:
                line = sf.readline()
                if not line:
                    break
                obj = json.loads(line)
                if obj.get("request_id") == 1:
                    meta = obj.get("data", {}) or {}
                    break

            s.sendall(json.dumps({"command": ["get_property", "media-title"], "request_id": 2}).encode("utf-8") + b"\n")
            media_title = ""
            while True:
                line = sf.readline()
                if not line:
                    break
                obj = json.loads(line)
                if obj.get("request_id") == 2:
                    media_title = str(obj.get("data", "") or "")
                    break

            s.sendall(json.dumps({"command": ["get_property", "pause"], "request_id": 3}).encode("utf-8") + b"\n")
            paused = False
            while True:
                line = sf.readline()
                if not line:
                    break
                obj = json.loads(line)
                if obj.get("request_id") == 3:
                    paused = bool(obj.get("data", False))
                    break
            s.close()

            icy_title = meta.get("icy-title") or meta.get("title") or media_title
            station_name = meta.get("icy-name", "CoreX Radio")
            if not icy_title or icy_title.lower() in ("mp3", "aac", "ogg", "stream", "live", "groovesalad-128-mp3", "dronezone-128-mp3", "defcon-128-mp3"):
                icy_title = station_name

            artist, title = "", icy_title
            if " - " in icy_title:
                parts = icy_title.split(" - ", 1)
                artist = parts[0].strip()
                title = parts[1].strip()

            return {
                "source": "CoreX Radio Stream",
                "player": "mpv",
                "artist": artist,
                "title": title,
                "album": station_name,
                "genre": meta.get("icy-genre", ""),
                "bitrate": f"{meta.get('icy-br')} kbps" if meta.get("icy-br") else "",
                "status": "Paused" if paused else "Playing",
                "raw": icy_title,
            }
        except Exception:
            pass

    # 2. Check playerctl (MPRIS: Spotify, Firefox, VLC, Amberol, etc.)
    if shutil.which("playerctl"):
        try:
            res = subprocess.run(
                ["playerctl", "-a", "metadata", "--format", "{{status}}|{{playerName}}|{{artist}}|{{title}}|{{album}}"],
                capture_output=True,
                text=True,
                timeout=1.2,
            )
            lines = [l.strip() for l in res.stdout.strip().splitlines() if l.strip()]
            if lines:
                playing = [l for l in lines if l.startswith("Playing")]
                chosen = playing[0] if playing else lines[0]
                parts = chosen.split("|")
                status = parts[0] if len(parts) > 0 else "Playing"
                player = parts[1] if len(parts) > 1 else "Player"
                artist = parts[2] if len(parts) > 2 else ""
                title = parts[3] if len(parts) > 3 else ""
                album = parts[4] if len(parts) > 4 else ""
                raw = f"{artist} - {title}" if (artist and title) else (title or artist)
                if raw:
                    return {
                        "source": f"MPRIS ({player.capitalize()})",
                        "player": player,
                        "artist": artist,
                        "title": title,
                        "album": album,
                        "genre": "",
                        "bitrate": "",
                        "status": status,
                        "raw": raw,
                    }
        except Exception:
            pass

    return None


def builtin_now_playing(extra_args: Optional[List[str]] = None):
    """Inspects currently playing song from CoreX Radio stream, Spotify, browser or playerctl."""
    args = extra_args or []
    short_mode = "--short" in args or "-s" in args
    notify_mode = "--notify" in args or "-n" in args
    follow_mode = "--follow" in args or "-f" in args
    no_copy = "--no-copy" in args

    if follow_mode:
        print(f"{Style.CYAN}📡 Monitoring track changes live (Press Ctrl+C to quit)...{Style.RESET}\n")
        last_track = None
        try:
            while True:
                info = get_now_playing()
                if info:
                    cur = info["raw"]
                    if cur != last_track:
                        last_track = cur
                        status_sym = f"{Style.GREEN}▶{Style.RESET}" if info["status"] == "Playing" else f"{Style.YELLOW}⏸{Style.RESET}"
                        print(f" {status_sym} {Style.BOLD}{cur}{Style.RESET} {Style.DARK_GRAY}[{info['source']}]{Style.RESET}")
                        if notify_mode and shutil.which("notify-send"):
                            subprocess.run(["notify-send", "-a", "CoreX", "-i", "audio-headphones", "Now Playing", cur])
                time.sleep(2.0)
        except KeyboardInterrupt:
            print("\nExited track monitor.")
            return

    info = get_now_playing()
    if not info:
        if short_mode:
            print("No media playing")
        else:
            log_warn("No active media streams detected (checked CoreX Radio, Spotify, Firefox, MPV, playerctl).")
            print(f"  {Style.GRAY}Tip: Run {Style.BOLD}cx stream-radio{Style.RESET}{Style.GRAY} to tune into 48+ commercial-free streams!{Style.RESET}\n")
        return

    track_str = info["raw"]

    if short_mode:
        print(f"🎵 {track_str}")
        return

    status_color = Style.GREEN if info["status"] == "Playing" else Style.YELLOW
    status_sym = "● Playing" if info["status"] == "Playing" else "⏸ Paused"

    print(f"\n{box_header('CURRENTLY PLAYING SONG', color=Style.CYAN)}")
    if info["title"]:
        print(f"  • {Style.BOLD}Track Title:{Style.RESET}    {Style.BOLD}{info['title']}{Style.RESET}")
    if info["artist"]:
        print(f"  • {Style.BOLD}Artist:{Style.RESET}         {info['artist']}")
    if info["album"]:
        label = "Station:" if "Radio" in info["source"] else "Album:"
        print(f"  • {Style.BOLD}{label:<14}{Style.RESET} {info['album']}")
    if info["genre"]:
        print(f"  • {Style.BOLD}Genre:{Style.RESET}          {info['genre']}")
    if info["bitrate"]:
        print(f"  • {Style.BOLD}Bitrate:{Style.RESET}        {info['bitrate']}")
    print(f"  • {Style.BOLD}Playback:{Style.RESET}       {status_color}{status_sym}{Style.RESET} via {info['source']}")
    print(box_footer(color=Style.CYAN))

    if not no_copy:
        copied = copy_to_clipboard(track_str)
        if copied:
            log_success(f"Track copied to clipboard: '{track_str}'")

    if notify_mode and shutil.which("notify-send"):
        subprocess.run(["notify-send", "-a", "CoreX", "-i", "audio-headphones", "Now Playing", track_str])


def builtin_rip_audio(fmt: str = "flac", dry_run: bool = False):
    vids = list(Path.cwd().glob("*.mp4")) + list(Path.cwd().glob("*.mkv")) + list(Path.cwd().glob("*.webm"))
    if not vids:
        log_warn("No video files (.mp4, .mkv, .webm) found in current directory.")
        return

    selected = run_fzf([v.name for v in vids], prompt=f"Select video(s) for {fmt.upper()} rip [TAB multi] > ", multi=True)
    if not selected:
        return

    for fname in selected:
        src = Path(fname)
        out = src.with_suffix(f".{fmt}")
        if fmt == "flac":
            cmd = ["ffmpeg", "-y", "-i", str(src), "-vn", "-c:a", "flac", "-sample_fmt", "s32", "-threads", "0", str(out)]
        else:
            cmd = ["ffmpeg", "-y", "-i", str(src), "-vn", "-c:a", "libopus", "-b:a", "160k", "-threads", "0", str(out)]

        log_step("Extracting", f"{src.name} -> {out.name}")
        if dry_run:
            print(f"{Style.YELLOW}[DRY-RUN]{Style.RESET} {' '.join(cmd)}")
        else:
            subprocess.run(cmd, check=False)
            log_success(f"Exported: {out.name}")


def builtin_trim_video():
    vids = [f.name for f in Path.cwd().iterdir() if f.suffix.lower() in [".mp4", ".mkv", ".webm", ".mov"]]
    if not vids:
        log_warn("No video files in current directory.")
        return

    sel = run_fzf(vids, prompt="Select video to trim > ")
    if not sel:
        return
    vid = sel[0]

    print(f"{Style.CYAN}Start timestamp (e.g. 00:01:30):{Style.RESET} ", end="", flush=True)
    start = input().strip()
    print(f"{Style.CYAN}End timestamp (e.g. 00:02:45):{Style.RESET} ", end="", flush=True)
    end = input().strip()

    if not start or not end:
        return
    out = f"trimmed_{vid}"
    cmd = ["ffmpeg", "-y", "-ss", start, "-to", end, "-i", vid, "-c", "copy", out]
    log_info(f"Trimming lossless stream: {vid} -> {out}...")
    subprocess.run(cmd)
    log_success(f"Saved: {out}")


