        print(box_footer(color=Style.CYAN))
        return

    catalog_names = set(m["name"] for m in MODEL_CATALOG)
    all_models = list(MODEL_CATALOG)

    for name, m in installed_models.items():
        if name not in catalog_names:
            sz_gb = m.get("size", 0) / (1024**3)
            all_models.insert(0, {
                "name": name,
                "params": "Local",
                "disk_gb": round(sz_gb, 1),
                "vram_mb": int(sz_gb * 1200),
                "category": "Custom Installed",
                "desc": "Custom user-downloaded Ollama model.",
            })

    def sort_key(item):
        name = item["name"]
        is_inst = is_model_installed(name, installed_models)
        is_act = (name == cfg.ollama_model)
        if is_act:
            return (0, name)
        elif is_inst:
            return (1, name)
        else:
            return (2, name)

    all_models.sort(key=sort_key)

    items = []
    for m in all_models:
        name = m["name"]
        rating = rate_model_compatibility(m["vram_mb"], hw)
        is_inst = is_model_installed(name, installed_models)
        tag = "[INSTALLED]" if is_inst else "[AVAILABLE]"
        act_star = "★ ACTIVE" if name == cfg.ollama_model else "        "
        line = f"{name:<24} {rating['badge']:<15} {tag:<12} {act_star} {m['disk_gb']:>4.1f} GB  {m['category']:<16} {m['desc']}"
        items.append(line)

    self_exe = os.path.abspath(sys.argv[0])
    preview_cmd = f"python3 '{self_exe}' __preview_model {{1}}"

    header = (
        f"GPU: {hw['gpu_name']} ({hw['vram_total_mb']/1024:.1f} GB VRAM) | RAM: {hw['ram_total_mb']/1024:.1f} GB | Active: {cfg.ollama_model}\n"
