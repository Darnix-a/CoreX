def builtin_notes(cfg: CoreXConfig, title: Optional[str] = None):
    import datetime
    cfg.notes_dir.mkdir(parents=True, exist_ok=True)
    ed = get_default_editor(cfg)
    ts = datetime.datetime.now().strftime("%Y-%m-%d_%H%M%S")
    if title:
        sanitized = re.sub(r"[^\w\-]", "_", title.strip())
        note = cfg.notes_dir / f"{ts}_{sanitized}.md"
