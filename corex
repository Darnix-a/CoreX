    if cfg.todo_file.exists():
        try:
            tasks = json.loads(cfg.todo_file.read_text())
        except Exception:
            tasks = []

    items = []
    for idx, t in enumerate(tasks):
        done = t.get("done", False)
        box = f"{Style.GREEN}[✔]{Style.RESET}" if done else f"{Style.YELLOW}[ ]{Style.RESET}"
        items.append(f"{idx}\t{box} {t.get('task')}")

    items.append("+ [Add new task...]")
    extra = [
        "--delimiter=\t",
        "--with-nth=2",
        "--header=ENTER: Toggle Done / Add | CTRL-D: Delete Task",
    ]
    sel = run_fzf(items, prompt="todo > ", extra_args=extra)
    if not sel:
        return

    choice = sel[0]
    if "+ [Add new task" in choice:
        print(f"{Style.CYAN}Enter new task description:{Style.RESET} ", end="", flush=True)
