def box_header(title: str, width: int = 70, color: str = Style.CYAN) -> str:
    title_str = f" {title} " if title else ""
    line = "─" * max(0, width - len(title_str) - 3)
    return f"{color}╭─{Style.BOLD}{Style.WHITE}{title_str}{Style.RESET}{color}{line}╮{Style.RESET}"


def box_footer(width: int = 70, color: str = Style.CYAN) -> str:
    return f"{color}╰{'─' * max(0, width - 2)}╯{Style.RESET}"


