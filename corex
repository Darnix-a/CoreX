def builtin_upgrade(dry_run: bool = False):
    c_blue = "\033[38;2;137;180;250m"
    c_green = "\033[38;2;166;227;161m"
    c_yellow = "\033[38;2;249;226;175m"
    rst = Style.RESET
    bld = Style.BOLD
    dim = Style.DIM

    print(f"\n {c_blue}{bld}╭─ COREX AUTOMATED UPDATER & RELEASE SYNC ───────────────────────────╮{rst}")
    print(f" {c_blue}│{rst} {dim}Synchronizing source repository, shell completions, and catalog{rst}      {c_blue}│{rst}")
    print(f" {c_blue}╰─────────────────────────────────────────────────────────────────────╯{rst}\n")

    repo_dir = Path(__file__).resolve().parent
    is_git = (repo_dir / ".git").is_dir()

    if not is_git:
        print(f"  {c_yellow}{bld}▲ Notice:{rst} CoreX is installed from package distribution.")
        print(f"  To update, run your package manager:")
        print(f"    • Arch / CachyOS: {Style.CYAN}paru -S corex-git{rst} or {Style.CYAN}yay -S corex-git{rst}\n")
        return

    try:
        cur_commit = subprocess.run(["git", "rev-parse", "--short", "HEAD"], cwd=repo_dir, capture_output=True, text=True, check=True).stdout.strip()
        branch = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=repo_dir, capture_output=True, text=True, check=True).stdout.strip()
    except Exception as e:
        log_error(f"Git status check failed: {e}")
        return

    print(f"  • Current Version:  {c_blue}{bld}v{VERSION}{rst} ({cur_commit} on {branch})")
    print(f"  • Checking remote:  {dim}git fetch origin {branch}...{rst}")

    if dry_run:
        print(f"\n  {c_yellow}{bld}[DRY-RUN]{rst} Would fetch and fast-forward pull from origin/{branch},")
        print(f"            rebuild configuration cache, update shell completions, and verify system doctor.\n")
        return

    try:
        subprocess.run(["git", "fetch", "origin", branch], cwd=repo_dir, check=True, capture_output=True, timeout=15)
        behind_count = int(subprocess.run(["git", "rev-list", f"HEAD..origin/{branch}", "--count"], cwd=repo_dir, capture_output=True, text=True, check=True).stdout.strip())

        if behind_count == 0:
            print(f"\n  {c_green}{bld}✔ CoreX is already on the latest commit!{rst} ({cur_commit})\n")
            invalidate_config_cache()
            return

        print(f"  • Updates found:    {c_yellow}{bld}{behind_count} new commit(s) available.{rst}")
        print(f"  • Pulling changes:  {dim}git pull --ff-only origin {branch}...{rst}")
        subprocess.run(["git", "pull", "--ff-only", "origin", branch], cwd=repo_dir, capture_output=True, text=True, check=True)
        new_commit = subprocess.run(["git", "rev-parse", "--short", "HEAD"], cwd=repo_dir, capture_output=True, text=True, check=True).stdout.strip()

        invalidate_config_cache()

        if (repo_dir / "install.sh").exists():
            print(f"  • Re-indexing:      {dim}Refreshing shell completions & symlinks...{rst}")
            try:
                subprocess.run([str(repo_dir / "install.sh")], capture_output=True, timeout=10)
            except Exception:
                pass

        print(f"\n  {c_green}{bld}✔ CoreX successfully updated to commit {new_commit}!{rst}")
        print(f"  • Doctor check:     {dim}Running verification...{rst}")
        doc_res = subprocess.run([str(repo_dir / "corex"), "doctor", "--dry-run"], capture_output=True, text=True)
        if "173 / 173" in doc_res.stdout or "100.0%" in doc_res.stdout:
            print(f"  • Catalog Status:   {c_green}✔ 100% Operational{rst}\n")
        else:
            print(f"  • Catalog Status:   {c_yellow}Review 'cx doctor' for details{rst}\n")

    except subprocess.CalledProcessError as e:
        log_error(f"Update failed during git command: {e.stderr or e}")
    except Exception as e:
        log_error(f"Unexpected error during upgrade: {e}")


