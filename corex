def builtin_ram_breakdown():
    print(box_header("PHYSICAL RAM FORENSIC BREAKDOWN"))
    try:
        mem = Path("/proc/meminfo").read_text()
        def get_kb(key: str) -> int:
            m = re.search(rf"^{key}:\s+(\d+)", mem, re.M)
            return int(m.group(1)) if m else 0

        tot = get_kb("MemTotal") // 1024
        free = get_kb("MemFree") // 1024
        avail = get_kb("MemAvailable") // 1024
        active = get_kb("Active") // 1024
        inactive = get_kb("Inactive") // 1024
        dirty = get_kb("Dirty") // 1024
        wb = get_kb("Writeback") // 1024
        anon = get_kb("AnonPages") // 1024
        slab = get_kb("Slab") // 1024
        s_rec = get_kb("SReclaimable") // 1024
        s_unrec = get_kb("SUnreclaim") // 1024
        zram_kb = get_kb("Zram")

        print(f" {Style.BOLD}Total Physical RAM:{Style.RESET}  {tot} MiB")
        print(f" {Style.BOLD}Available Memory:{Style.RESET}    {Style.GREEN}{avail} MiB{Style.RESET} ({avail/tot*100:.1f}%)")
        print(f" {Style.BOLD}Active Working Set:{Style.RESET}  {active} MiB | {Style.BOLD}Inactive:{Style.RESET} {inactive} MiB")
        print(f" {Style.BOLD}Anonymous Pages:{Style.RESET}     {anon} MiB")
        print(f" {Style.BOLD}Dirty / Writeback:{Style.RESET}   {dirty} MiB / {wb} MiB")
        print(f" {Style.BOLD}Kernel Slab Cache:{Style.RESET}   {slab} MiB (Reclaimable: {s_rec} MiB | Unreclaim: {s_unrec} MiB)")
        if zram_kb:
            print(f" {Style.BOLD}ZRAM In-Memory:{Style.RESET}      {zram_kb // 1024} MiB")
    except Exception as e:
        log_error(f"RAM breakdown failed: {e}")
    print(box_footer())


