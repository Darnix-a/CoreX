def main():
    signal.signal(signal.SIGINT, lambda sig, frame: sys.exit(130))
    if hasattr(signal, "SIGPIPE"):
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)

    parser = argparse.ArgumentParser(prog="cx", add_help=False)
    parser.add_argument("command", nargs="?", help="Command to execute")
    parser.add_argument("args", nargs=argparse.REMAINDER, help="Subcommand arguments")
    parser.add_argument("-h", "--help", action="store_true")
    parser.add_argument("-v", "--version", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("-y", "--yes", action="store_true")
    parser.add_argument("--list", action="store_true")
    parser.add_argument("--no-color", action="store_true")
    parser.add_argument("--config", type=Path, default=None)

    parsed, unknown = parser.parse_known_args()
    cfg = load_config(parsed.config)

    if parsed.version:
        print(f"CoreX (cx) v{VERSION} - 75+ Command Mission-Control Cockpit")
        sys.exit(0)

    if parsed.list:
        for cid, spec in sorted(cfg.commands.items()):
            print(f"{cid}\t{spec.category}\t{spec.description}")
        sys.exit(0)

    # Internal preview callback for fzf
    if parsed.command == "__preview":
        target = (parsed.args[0] if parsed.args else "") or (unknown[0] if unknown else "")
        render_preview(target, cfg)
        sys.exit(0)

    # Completions generation
    if parsed.command == "completions":
        target_shell = (parsed.args[0] if parsed.args else "fish").lower()
        if target_shell == "fish":
            print(generate_fish_completions(cfg))
        elif target_shell == "zsh":
            print(generate_zsh_completions(cfg))
        else:
            print(generate_bash_completions(cfg))
        sys.exit(0)

    if parsed.help:
        print_banner(parsed.dry_run)
        print("""
USAGE:
  cx                              Launch two-tier mission-control TUI
  cx <command> [args...]          Execute command directly with zero latency
  cx --dry-run <command> [args]   Preview command safely
  cx --list                       Print all 75+ registered commands

CATEGORIES:
  • [AI, CUDA & Deep Learning]              12 commands (comfy-*, ollama-*, vram-watch, etc.)
  • [Media, Audio & PipeWire Power-Tools]     13 commands (stream-*, rip-*, pw-*, trim-video, etc.)
  • [Gaming, Hardware & Display Orchestration] 8 commands (gpu-clock, cpu-gov, mon-*, sens-watch, etc.)
  • [System Architecture & BTRFS Snapshotting] 9 commands (snap-*, fkill, disk-space, etc.)
  • [Network, VPN & Remote Infrastructure]    9 commands (my-ip, vpn-*, port-audit, serve-dir, etc.)
  • [Git, Dev & Code Utilities]               9 commands (git-*, docker-*, venv-init, cheat, etc.)
  • [Daily Driver Quality-of-Life & Crypto] 15 commands (calc, timer, notes, todo, sys-info, etc.)

FLAGS:
  --dry-run                       Preview command execution without running
  -y, --yes                       Bypass confirmation prompts
  --list                          List all commands for scripting
  --config <path>                 Custom TOML config file
  -h, --help                      Show help
  -v, --version                   Show version
""")
        sys.exit(0)

    # Naked execution: launch two-tier interactive navigation
    if not parsed.command:
        run_two_tier_menu(cfg, dry_run=parsed.dry_run)
        sys.exit(0)

    # Direct subshell execution
    extra = (parsed.args or []) + unknown
    execute_command(parsed.command, cfg, dry_run=parsed.dry_run, extra_args=extra)


if __name__ == "__main__":
    main()
