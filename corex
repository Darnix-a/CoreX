    for dep, affected_cmds in sorted(missing_deps_map.items()):
        if dep in SPECIAL_INSTALL:
            standalone_tools.append((dep, SPECIAL_INSTALL[dep], affected_cmds))
        else:
            pkg = PKG_MAP.get(dep, dep)
            missing_system_pkgs.add(pkg)
            sample_cmds = ", ".join(affected_cmds[:3])
            if len(affected_cmds) > 3:
                sample_cmds += f" (+{len(affected_cmds) - 3} more)"
            print(f"  • {Style.RED}{dep:<14}{Style.RESET} -> package: {Style.CYAN}{pkg:<16}{Style.RESET} (needed by: {Style.GRAY}{sample_cmds}{Style.RESET})")

    if standalone_tools:
        print(f"\n{Style.YELLOW}{Style.BOLD}Python / Standalone Tools (Install via pipx or uv):{Style.RESET}")
        for dep, hint, affected_cmds in standalone_tools:
            sample_cmds = ", ".join(affected_cmds[:3])
            if len(affected_cmds) > 3:
                sample_cmds += f" (+{len(affected_cmds) - 3} more)"
            print(f"  • {Style.RED}{dep:<14}{Style.RESET} -> {Style.CYAN}{hint}{Style.RESET} (needed by: {Style.GRAY}{sample_cmds}{Style.RESET})")

    sorted_pkgs = sorted(missing_system_pkgs)

    if not sorted_pkgs:
        if standalone_tools:
            log_info("All missing dependencies are standalone / pipx tools. Install them using the commands above.")
        return

    # Detect package manager
    pm = None
    if shutil.which("paru"):
        pm = "paru"
    elif shutil.which("yay"):
        pm = "yay"
    elif shutil.which("pacman"):
        pm = "sudo pacman"

    if not pm:
        log_warn("No supported Arch package manager (paru, yay, pacman) found. Please install packages manually:")
        print(f"  Packages: {' '.join(sorted_pkgs)}")
        return

    # Use -Sy on Arch/CachyOS to refresh mirror databases and avoid 404 errors on rolling release mirrors
    sync_flag = "-Sy" if pm in ("paru", "yay", "sudo pacman") else "-S"
    install_cmd = f"{pm} {sync_flag} --needed {' '.join(sorted_pkgs)}"
    print(f"\n{Style.BOLD}Proposed Install Command:{Style.RESET}")
    print(f"  {Style.CYAN}{install_cmd}{Style.RESET}")

    if dry_run:
        print(f"\n{Style.YELLOW}[DRY-RUN]{Style.RESET} Skipped package installation.")
        return

    do_install = auto_install
    if not do_install:
        try:
            print(f"\n{Style.BOLD}Would you like to install {len(sorted_pkgs)} missing packages now? [Y/n]: {Style.RESET}", end="", flush=True)
            ans = input().strip().lower()
            if ans in ("", "y", "yes"):
                do_install = True
        except (KeyboardInterrupt, EOFError):
            print()
            return

    if do_install:
        log_info(f"Executing: {install_cmd}")
        cmd_list = pm.split() + [sync_flag, "--needed"] + sorted_pkgs
        ret = subprocess.run(cmd_list)
        if ret.returncode == 0:
            log_success("Package installation completed successfully! Re-verifying...")
            resolved = [d for d in missing_deps_map if shutil.which(d)]
            still_missing = [d for d in missing_deps_map if not shutil.which(d)]
            if resolved:
                print(f"  {Style.GREEN}✔ Installed tools now active: {', '.join(resolved)}{Style.RESET}")
            if still_missing:
                print(f"  {Style.YELLOW}▲ Still missing (may need manual setup or reboot): {', '.join(still_missing)}{Style.RESET}")
            else:
                log_success("All workstation dependencies are now 100% installed and operational!")
        else:
            log_error(f"Package installation returned exit code {ret.returncode}.")
            log_warn("If mirrors returned 404 errors, your local databases or mirrors may need a full system sync:")
            print(f"  {Style.BOLD}sudo pacman -Syu{Style.RESET}  or  {Style.BOLD}paru -Syu{Style.RESET}")


