        if not pinned_list:
            print(f"{Style.GRAY}No actions currently pinned to favorites. Use 'cx pin <action>' or press [Tab] in menu.{Style.RESET}")
        else:
            print(f"{Style.BOLD}{Style.YELLOW}★ PINNED FAVORITES ({len(pinned_list)}){Style.RESET}")
            for pid in pinned_list:
                spec = cfg.commands.get(pid)
                desc = spec.description if spec else "Custom action"
                tag = CATEGORY_TAGS.get(spec.category, "@misc") if spec else "@custom"
                t_color = get_tag_color(tag)
                print(f"  {Style.YELLOW}★{Style.RESET} {Style.BOLD}{pid:<18}{Style.RESET} {t_color}{tag:<8}{Style.RESET} {Style.GRAY}{desc}{Style.RESET}")
