def format_cockpit_items(cfg: CoreXConfig) -> List[str]:
    """Formats 150+ catalog items with clean columns, colors, and minimal badges."""
    items = []
    for c in cfg.commands.values():
        tag = CATEGORY_TAGS.get(c.category, "@misc")
        t_color = get_tag_color(tag)
        has_missing = any(not shutil.which(d) for d in c.deps)

        badges = []
        if has_missing:
            badges.append(f"{Style.RED}{Style.BOLD}▲ MISSING{Style.RESET}")
        if c.requires_sudo:
            badges.append(f"{Style.YELLOW}⚡SUDO{Style.RESET}")

        badge_str = " ".join(badges) if badges else f"{Style.DARK_GRAY}•{Style.RESET}"

        # Delimiter: tab
        # 1: id (hidden from display via --with-nth)
        # 2: colored tag
        # 3: command id
        # 4: subtle vertical separator
        # 5: description
        # 6: badges
        items.append(
            f"{c.id}\t{t_color}{tag:<9}{Style.RESET}\t{Style.BOLD}{Style.WHITE}{c.id:<22}{Style.RESET}\t{Style.DARK_GRAY}│{Style.RESET}\t{Style.GRAY}{c.description:<48}{Style.RESET}\t{badge_str}"
        )
    return items


def run_interactive_cockpit(cfg: CoreXConfig, dry_run: bool = False):
    """
    Unified, lightning-fast cockpit with @category fuzzy filtering,
    in-app command builder (Ctrl+N), and hotkey bindings.
    """
    self_exe = os.path.abspath(sys.argv[0])
    items = format_cockpit_items(cfg)

    preview_call = f"python3 '{self_exe}' __preview {{1}}"
    header = (
        f"  CoreX Cockpit • {len(cfg.commands)} Actions Ready  │  Type '@<tag>' to filter categories (e.g. @sys, @ai, @gpu)\n"
        f"  [Enter] Run  │  [^N] Builder  │  [^Y] Copy  │  [^D] Dry-Run  │  [^E] Edit & Run  │  [^R] Reload  │  [ESC] Quit"
    )

    extra = [
        "--delimiter=\t",
        "--with-nth=2,3,4,5,6",
        "--header-first",
        f"--header={header}",
        "--border=rounded",
        "--border-label= ⚡ COREX WORKSTATION COCKPIT ",
        "--border-label-pos=3",
        "--preview-window=right:52%:border-rounded:wrap",
        "--preview-label= ACTION DETAILS ",
        "--preview-label-pos=3",
        "--prompt=  ◈ cx ❯ ",
        "--pointer=▶ ",
        "--marker=◈ ",
        "--scrollbar=│",
        "--info=inline-right",
        f"--bind=ctrl-n:execute(python3 '{self_exe}' builder)+reload(python3 '{self_exe}' __fzf_items)",
        f"--bind=ctrl-r:reload(python3 '{self_exe}' __fzf_items)",
        f"--bind=ctrl-y:execute-silent(python3 '{self_exe}' __get_cmd {{1}} | wl-copy 2>/dev/null || python3 '{self_exe}' __get_cmd {{1}} | xclip -selection clipboard 2>/dev/null)",
        f"--bind=ctrl-d:execute(python3 '{self_exe}' --dry-run {{1}}; echo; read -n 1 -s -r -p 'Press any key to return...'; echo)",
        f"--bind=ctrl-e:execute(python3 '{self_exe}' __edit_run {{1}})",
