def run_master_menu(cfg: CoreXConfig, dry_run: bool = False, config_path: Optional[Path] = None):
    """Launches the global interactive fzf launcher menu."""
    items = [
        # AI & Workflows
        f"comfyui\t{Style.PURPLE}[AI & Workflows]{Style.RESET}\tComfyUI One-Click Launcher (Smart VRAM)",
        f"ollama\t{Style.PURPLE}[AI & Workflows]{Style.RESET}\tOllama / vLLM Model Manager & Daemon Control",
        f"docker\t{Style.PURPLE}[AI & Workflows]{Style.RESET}\tContainer Manager (Logs, Restart, Kill)",

        # Media & Streams
        f"stream\t{Style.RED}[Media & Streams]{Style.RESET}\tSearch & Stream YouTube/SoundCloud via mpv",
        f"rip-audio\t{Style.RED}[Media & Streams]{Style.RESET}\tExtract 24-bit FLAC / Opus Audio from Videos",
        f"local-player\t{Style.RED}[Media & Streams]{Style.RESET}\tLocal Music Library Fuzzy Player & Tag Preview",

        # System & GPU
        f"fkill\t{Style.BLUE}[System & GPU]{Style.RESET}\tInteractive Process Manager & Multi-Kill",
        f"vram\t{Style.BLUE}[System & GPU]{Style.RESET}\tNvidia VRAM Inspector & Zombie GPU Killer",
        f"snapshot\t{Style.BLUE}[System & GPU]{Style.RESET}\tBTRFS / Snapper System Snapshot Helper",

        # Quick Tools
        f"scratch\t{Style.GREEN}[Quick Tools]{Style.RESET}\tTimestamped Markdown Scratchpad in $EDITOR",
    ]

    # Inject custom commands from config
    for cid, cdata in cfg.custom_commands.items():
        cat = cdata.get("category", "Custom")
        desc = cdata.get("description", cdata.get("name", cid))
        items.append(f"{cid}\t{Style.ORANGE}[{cat}]{Style.RESET}\t{desc}")

    self_exe = os.path.abspath(sys.argv[0])
    cfg_arg = f" --config '{config_path}'" if config_path else ""
    preview_cmd = f"python3 '{self_exe}'{cfg_arg} __preview {{1}}"

    extra = [
        "--delimiter=\t",
        "--with-nth=2,3",
        "--header=COREX MULTITOOL | Select an action or type to filter | ESC to exit",
    ]

    selected = run_fzf(
        items,
        prompt="cx ⚡ > ",
        preview_cmd=preview_cmd,
        extra_args=extra,
    )
    if not selected:
        return

    chosen_id = selected[0].split("\t")[0].strip()
    dispatch_action(chosen_id, cfg, dry_run=dry_run)


def dispatch_action(action_id: str, cfg: CoreXConfig, dry_run: bool = False, extra_args: Optional[List[str]] = None):
    """Route action to appropriate handler."""
    extra = extra_args or []
    if action_id in ["comfy", "comfyui"]:
        cmd_comfyui(cfg, dry_run=dry_run, extra_args=extra)
    elif action_id in ["ai", "ollama", "vllm"]:
        cmd_ai_models(cfg, dry_run=dry_run)
    elif action_id in ["docker", "compose", "podman"]:
        cmd_docker(dry_run=dry_run)
    elif action_id in ["stream", "yt"]:
        q = " ".join(extra) if extra else None
        cmd_stream(cfg, query=q, dry_run=dry_run)
    elif action_id in ["rip", "rip-audio"]:
        target = extra[0] if extra else None
        cmd_rip_audio(cfg, target_dir=target, dry_run=dry_run)
    elif action_id in ["play", "local-player", "music"]:
        mpath = extra[0] if extra else None
        cmd_local_player(cfg, music_path=mpath, dry_run=dry_run)
    elif action_id in ["kill", "fkill"]:
        filter_term = extra[0] if extra else None
        cmd_fkill(filter_term=filter_term, dry_run=dry_run)
    elif action_id in ["vram", "gpu"]:
        cmd_vram(dry_run=dry_run)
    elif action_id in ["snap", "snapshot"]:
        lbl = extra[0] if extra else None
        cmd_snapshot(cfg, label=lbl, dry_run=dry_run)
    elif action_id in ["scratch", "note", "notes"]:
        title = " ".join(extra) if extra else None
        cmd_scratch(cfg, title=title, dry_run=dry_run)
    elif action_id in cfg.custom_commands:
        custom = cfg.custom_commands[action_id]
        cmd_str = custom.get("command", "")
        log_info(f"Running custom action: {custom.get('name', action_id)}")
        run_cmd(cmd_str, shell=True, dry_run=dry_run)
    else:
        log_error(f"Unknown sub-command '{action_id}'. Run 'cx --help' for usage.")
        sys.exit(1)


# ---------------------------------------------------------------------------
# CLI PARSER & ENTRYPOINT
# ---------------------------------------------------------------------------
def main():
    signal.signal(signal.SIGINT, lambda sig, frame: sys.exit(130))
    if hasattr(signal, "SIGPIPE"):
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)


    # Shell completion requests
    if len(sys.argv) >= 2 and sys.argv[1] == "completions":
        target_shell = sys.argv[2] if len(sys.argv) > 2 else "fish"
        if target_shell == "fish":
            print(generate_fish_completions())
        else:
            print(generate_bash_completions())
        sys.exit(0)

    parser = argparse.ArgumentParser(
        prog="cx",
        description="CoreX (cx) - Elite Linux Systems Multitool & Interactive Launcher CLI",
        add_help=False,
    )
    parser.add_argument("command", nargs="?", help="Subcommand to execute directly (bypasses fzf menu)")
    parser.add_argument("args", nargs=argparse.REMAINDER, help="Arguments for the subcommand")
    parser.add_argument("-h", "--help", action="store_true", help="Show this help message")
    parser.add_argument("-v", "--version", action="store_true", help="Show CoreX version")
    parser.add_argument("--dry-run", action="store_true", help="Preview shell commands without executing them")
    parser.add_argument("--no-color", action="store_true", help="Disable ANSI colors")
    parser.add_argument("--config", type=Path, default=None, help="Custom path to config.toml")

    parsed, unknown = parser.parse_known_args()

    if parsed.version:
        print(f"CoreX (cx) v{VERSION}")
        sys.exit(0)

    if parsed.help:
        print_banner(parsed.dry_run)
        print("""
USAGE:
  cx                               Open interactive master fzf menu
  cx <command> [args...]           Directly execute subcommand with zero latency
  cx --dry-run <command> [args...] Preview command execution safely

SUBCOMMANDS:
  comfy, comfyui                   One-click launcher for ComfyUI (smart VRAM detection)
  ai, ollama                       Inspect & unload local LLMs, manage Ollama daemon
  docker                           Interactive container manager (logs, restart, kill)
  stream [query]                   Search & stream YouTube/SoundCloud in mpv
  rip [path]                       Extract 24-bit FLAC / Opus audio from videos
  play [path]                      Instant fuzzy local music player with tag preview
  kill, fkill [filter]             Interactive process manager & multi-process killer
  vram                             Nvidia VRAM usage breakdown & zombie killer
  snap, snapshot [label]           BTRFS / Snapper snapshot assistant
  scratch [title]                  Instant markdown scratchpad opened in $EDITOR
  completions [fish|bash|zsh]      Output native shell completion code

FLAGS:
  --dry-run                        Preview shell commands before execution
  --config <path>                  Use custom TOML configuration file
  --no-color                       Disable terminal ANSI colors
  -h, --help                       Show this help message
  -v, --version                    Display CoreX version
""")
        sys.exit(0)

    cfg = load_config(parsed.config)

    # Internal preview callback for fzf
    if parsed.command == "__preview":
        target = (parsed.args[0] if parsed.args else "") or (unknown[0] if unknown else "")
        handle_preview(target, cfg)
        sys.exit(0)

    # Master interactive mode if no command specified
    if not parsed.command:
        run_master_menu(cfg, dry_run=parsed.dry_run, config_path=parsed.config)
        sys.exit(0)

    # Execute targeted subcommand directly
    extra = (parsed.args or []) + unknown
    dispatch_action(parsed.command, cfg, dry_run=parsed.dry_run, extra_args=extra)


if __name__ == "__main__":
    main()
