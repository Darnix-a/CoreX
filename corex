def _kiro_library() -> Path:
    override = os.environ.get("CX_KIRO_LIBRARY")
    if override:
        path = Path(override).expanduser().resolve()
    else:
        filename = "libkiro.dylib" if sys.platform == "darwin" else "libkiro.so"
        path = Path.home() / ".local" / "lib" / "kiro" / filename
    if not path.is_file():
        raise OSError(f"Kiro shared library missing at {path}; run Kiro's install.sh --embed")
    return path


def run_kiro_script(arguments: List[str], cfg: CoreXConfig, *,
                    command: Optional[str] = None, background: bool = False,
                    dry_run: bool = False) -> int:
    """Run a Kiro script through the shared interpreter, with optional background dispatch."""
    import shlex

    if not arguments or arguments[0] in ("-h", "--help"):
        print("Usage: cx kiro <file.kr> [args...]")
        print("       cx bg run <file.kr> [args...]")
        return 0 if arguments else 2

    script = Path(arguments[0]).expanduser().resolve()
    args = arguments[1:]
    command = command or script.stem
    if dry_run:
        mode = "[DRY-RUN BG]" if background else "[DRY-RUN]"
        print(f"{mode} {shlex.join(['cx', 'kiro', str(script), *args])}")
        return 0

    try:
        if not script.is_file():
            raise OSError(f"script does not exist: {script}")
        library_path = _kiro_library()
        if background:
            argv = ["env", f"CX_KIRO_LIBRARY={library_path}", sys.executable,
                    str(Path(__file__).resolve()), "--config", str(cfg.config_path),
                    "__kiro_run", command, str(script), *args]
            shell = f"cd {shlex.quote(os.getcwd())} && exec {shlex.join(argv)}"
            detach_background(command, shell)
            return 0

        # Load only when a Kiro action runs, so ordinary CoreX startup stays unchanged.
        import ctypes
        library = ctypes.CDLL(str(library_path))
        library.kiro_embed_api_version.argtypes = []
        library.kiro_embed_api_version.restype = ctypes.c_uint32
        if library.kiro_embed_api_version() != 1:
            raise OSError(f"unsupported Kiro embedding API in {library_path}")
        library.kiro_run_corex_file.argtypes = [ctypes.c_char_p, ctypes.c_char_p]
        library.kiro_run_corex_file.restype = ctypes.c_void_p
        library.kiro_free_string.argtypes = [ctypes.c_void_p]
        library.kiro_free_string.restype = None
        context = json.dumps({"args": args, "command": command, "commands": sorted(cfg.commands),
                              "version": VERSION}).encode("utf-8")
        response = library.kiro_run_corex_file(str(script).encode("utf-8"), context)
        if not response:
            raise OSError("Kiro returned an empty embedding response")
        try:
            result = json.loads(ctypes.string_at(response))
        finally:
            library.kiro_free_string(response)
        if "error" in result:
            print(result["error"], file=sys.stderr)
        elif result.get("value") is not None:
            print(json.dumps(result["value"], ensure_ascii=False))
        return result["code"]
    except (OSError, AttributeError, ValueError) as error:
        print(f"cx kiro: {error}", file=sys.stderr)
        return 1


# ---------------------------------------------------------------------------
# COMMAND DISPATCHER & SUBSHELL EXECUTION
# ---------------------------------------------------------------------------
def execute_command(
    cmd_id: str,
    cfg: CoreXConfig,
    dry_run: bool = False,
    bg_run: bool = False,
    extra_args: Optional[List[str]] = None,
):
    actual_id = COMMAND_ALIASES.get(cmd_id, cmd_id)
    spec = cfg.commands.get(actual_id)

    if not spec:
        import difflib
        candidates = list(cfg.commands.keys()) + list(COMMAND_ALIASES.keys())
        matches = difflib.get_close_matches(cmd_id, candidates, n=4, cutoff=0.45)
        sub_matches = [c for c in candidates if cmd_id in c and c not in matches]
        all_matches = (matches + sub_matches)[:4]

        log_error(f"Unknown action '{cmd_id}'.")
        if all_matches:
            print(f"\n {Style.BOLD}{Style.YELLOW}💡 Did you mean one of these?{Style.RESET}")
            for m in all_matches:
                resolved = COMMAND_ALIASES.get(m, m)
                mspec = cfg.commands.get(resolved)
                desc = mspec.description if mspec else ""
                tag = CATEGORY_TAGS.get(mspec.category, "@misc") if mspec else "@custom"
                t_col = get_tag_color(tag)
                alias_note = f" {Style.DIM}(alias for {resolved}){Style.RESET}" if m != resolved else ""
                print(f"    • {Style.BOLD}{Style.CYAN}cx {m}{Style.RESET}{alias_note}  {t_col}{tag:<8}{Style.RESET}  {Style.GRAY}{desc}{Style.RESET}")
            print()
        else:
            print(f"   {Style.DIM}Run 'cx --list' or 'cx find <query>' to browse available actions.{Style.RESET}\n")
        sys.exit(1)

    if not dry_run:
        record_action_usage(actual_id)

    # Dependency check
    for d in spec.deps:
        if not shutil.which(d):
            log_warn(f"Required binary '{d}' is missing! Command may fail. ({get_install_hint(d)})")

    # Confirmation check
    if spec.confirm and not dry_run:
        print(f"{Style.YELLOW}{Style.BOLD}⚠️  Action '{actual_id}' requires confirmation. Proceed? [y/N]:{Style.RESET} ", end="", flush=True)
        try:
            ans = input().strip().lower()
            if ans not in ["y", "yes"]:
                log_info("Operation canceled.")
                return
        except (KeyboardInterrupt, EOFError):
            print()
            return

    # Configured Kiro actions reuse confirmation, aliases and background management.
    if spec.command.split(None, 2)[:2] == ["cx", "kiro"]:
        import shlex
        try:
            args = shlex.split(spec.command)[2:] + (extra_args or [])
        except ValueError as error:
            print(f"cx {actual_id}: {error}", file=sys.stderr)
            sys.exit(2)
        if spec.requires_sudo and os.geteuid() != 0:
            print(f"cx {actual_id}: launch CoreX with the intended user for a Kiro action",
                  file=sys.stderr)
            sys.exit(1)
        sys.exit(run_kiro_script(args, cfg, command=actual_id,
                                 background=bg_run, dry_run=dry_run))

    # Check built-in dispatch
    if spec.command.startswith("cx __builtin "):
        builtin_name = spec.command.replace("cx __builtin ", "").strip()
        args = extra_args or []
        if actual_id == "builder" and cmd_id in ("new", "add", "create", "edit", "modify", "delete", "remove", "rm", "test", "validate", "check"):
            args = [cmd_id] + args
        if bg_run:
            # Wrap built-in in detached subshell
            self_exe = os.path.abspath(sys.argv[0])
            quoted_args = " ".join([f"'{a}'" if " " in a else a for a in args])
            bg_cmd = f"python3 '{self_exe}' {actual_id} {quoted_args}"
            detach_background(actual_id, bg_cmd, dry_run=dry_run)
            return
        dispatch_builtin(builtin_name, cfg, dry_run=dry_run, extra_args=args)
        return

    # Shell execution
    final_cmd = spec.command
    if extra_args:
        quoted_args = " ".join([f"'{a}'" if " " in a else a for a in extra_args])
        final_cmd = f"{final_cmd} {quoted_args}"

    if spec.requires_sudo and os.geteuid() != 0 and not final_cmd.strip().startswith("sudo"):
        final_cmd = f"sudo {final_cmd}"

    if dry_run:
        prefix = "[DRY-RUN BG]" if bg_run else "[DRY-RUN]"
        print(f"{Style.YELLOW}{prefix}{Style.RESET} {Style.BOLD}{final_cmd}{Style.RESET}")
        return

    if bg_run:
        detach_background(actual_id, final_cmd, dry_run=dry_run)
        return

    try:
        ret = subprocess.run(final_cmd, shell=True)
        sys.exit(ret.returncode)
    except KeyboardInterrupt:
        sys.exit(130)


def detach_background(cmd_id: str, shell_cmd: str, dry_run: bool = False):
    """Detaches command into a deterministic systemd-run user service or background nohup subshell."""
    slug = re.sub(r'[^a-zA-Z0-9_-]', '-', cmd_id).strip('-').lower() or "cmd"
    unit_name = f"corex-{slug}"
    service_name = f"{unit_name}.service"
    has_systemd_run = shutil.which("systemd-run") is not None

    if has_systemd_run:
        # Idempotency / Duplicate Guard: check if unit is already active
        is_active = subprocess.run(
            ["systemctl", "--user", "is-active", "--quiet", service_name]
        ).returncode == 0

        if is_active:
            # Query unit details
            show_res = subprocess.run(
                ["systemctl", "--user", "show", service_name, "--property=MainPID,ActiveEnterTimestamp,ActiveState,SubState"],
                capture_output=True, text=True
            )
            props = dict(line.split("=", 1) for line in show_res.stdout.splitlines() if "=" in line)
            pid = props.get("MainPID", "unknown")
            started = props.get("ActiveEnterTimestamp", "")
            sub_st = props.get("SubState", "running")

            print(box_header("BACKGROUND SERVICE ALREADY RUNNING"))
            print(f"  • {Style.BOLD}Unit Name:{Style.RESET}    {Style.CYAN}{service_name}{Style.RESET}")
            print(f"  • {Style.BOLD}Process ID:{Style.RESET}   {Style.GREEN}{pid}{Style.RESET}")
            print(f"  • {Style.BOLD}Unit Status:{Style.RESET}  {Style.GREEN}{Style.BOLD}active ({sub_st}){Style.RESET}")
            if started:
                print(f"  • {Style.BOLD}Active Since:{Style.RESET} {Style.YELLOW}{started}{Style.RESET}")
            print(f"\n  {Style.GRAY}To monitor, restart, inspect, or stop this unit:{Style.RESET}")
            print(f"    ❯ {Style.WHITE}cx bg{Style.RESET}                     (Interactive Unit Cockpit)")
            print(f"    ❯ {Style.WHITE}cx bg logs {slug}{Style.RESET}            (Tail live journal logs)")
            print(f"    ❯ {Style.WHITE}cx bg restart {slug}{Style.RESET}         (Restart background unit)")
            print(f"    ❯ {Style.WHITE}cx bg stop {slug}{Style.RESET}            (Stop background unit)")
            print(box_footer())
            return

        # Prepare systemd-run command with deterministic name and automatic cleanup on exit
        full_cmd = [
            "systemd-run",
            "--user",
            f"--unit={unit_name}",
            "--collect",
            "--property=CollectMode=inactive-or-failed",
            "sh", "-c", shell_cmd
        ]
    else:
        full_cmd = ["nohup", "sh", "-c", shell_cmd]

    if dry_run:
        print(f"{Style.YELLOW}[DRY-RUN BG]{Style.RESET} {' '.join(full_cmd)}")
        return

    log_info(f"Detaching '{cmd_id}' into background scope ({service_name})...")
    if has_systemd_run:
        # Clean any stale residual failed state before starting
        subprocess.run(["systemctl", "--user", "reset-failed", service_name], capture_output=True)
        res = subprocess.run(full_cmd, capture_output=True, text=True)
        if res.returncode == 0:
            log_success(f"Command '{cmd_id}' running in background as {service_name}")
            print(f"  {Style.GRAY}• Monitor logs:  {Style.CYAN}cx bg logs {slug}{Style.RESET} (or journalctl --user -u {service_name} -f)")
            print(f"  {Style.GRAY}• Manage unit:   {Style.CYAN}cx bg{Style.RESET} (or cx bg stop {slug})")
        else:
            log_warn(f"systemd-run failed ({res.stderr.strip()}), falling back to nohup...")
            subprocess.Popen(["nohup", "sh", "-c", shell_cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, preexec_fn=os.setpgrp)
            log_success(f"Command '{cmd_id}' detached via background subshell.")
    else:
        subprocess.Popen(full_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, preexec_fn=os.setpgrp)
        log_success(f"Command '{cmd_id}' detached via background nohup.")


def dispatch_builtin(name: str, cfg: CoreXConfig, dry_run: bool = False, extra_args: Optional[List[str]] = None):
    args = extra_args or []

    if name in ("doctor", "test-all", "health-check"):
        auto_install = ("-y" in args or "--yes" in args)
        builtin_doctor(cfg, dry_run=dry_run, auto_install=auto_install)
        return

    if name == "builder":
        builtin_builder(cfg, extra_args=args)
        return

    if dry_run:
        print(f"{Style.YELLOW}[DRY-RUN]{Style.RESET} Built-in action: cx __builtin {name} {' '.join(args)}".strip())
        return

    if name in ("ask", "ai", "ai-copilot", "copilot"):
        q = " ".join(args) if args else None
        builtin_ai_ask(q, cfg)
    elif name in ("models", "model", "ai-models"):
        builtin_model_chooser(cfg, extra_args=args)
    elif name == "comfy-boot":
        builtin_comfy_boot(cfg, dry_run=dry_run, extra_args=args)
    elif name == "ollama-ps":
        builtin_ollama_ps(cfg)
