def builtin_rip_audio(fmt: str = "flac", dry_run: bool = False):
    vids = list(Path.cwd().glob("*.mp4")) + list(Path.cwd().glob("*.mkv")) + list(Path.cwd().glob("*.webm"))
    if not vids:
        log_warn("No video files (.mp4, .mkv, .webm) found in current directory.")
        return

    selected = run_fzf([v.name for v in vids], prompt=f"Select video(s) for {fmt.upper()} rip [TAB multi] > ", multi=True)
    if not selected:
        return

    for fname in selected:
        src = Path(fname)
        out = src.with_suffix(f".{fmt}")
        if fmt == "flac":
            cmd = ["ffmpeg", "-y", "-i", str(src), "-vn", "-c:a", "flac", "-sample_fmt", "s32", "-threads", "0", str(out)]
        else:
            cmd = ["ffmpeg", "-y", "-i", str(src), "-vn", "-c:a", "libopus", "-b:a", "160k", "-threads", "0", str(out)]

        log_step("Extracting", f"{src.name} -> {out.name}")
        if dry_run:
            print(f"{Style.YELLOW}[DRY-RUN]{Style.RESET} {' '.join(cmd)}")
        else:
            subprocess.run(cmd, check=False)
            log_success(f"Exported: {out.name}")


def builtin_trim_video():
    vids = [f.name for f in Path.cwd().iterdir() if f.suffix.lower() in [".mp4", ".mkv", ".webm", ".mov"]]
    if not vids:
        log_warn("No video files in current directory.")
        return

    sel = run_fzf(vids, prompt="Select video to trim > ")
    if not sel:
        return
    vid = sel[0]

    print(f"{Style.CYAN}Start timestamp (e.g. 00:01:30):{Style.RESET} ", end="", flush=True)
    start = input().strip()
    print(f"{Style.CYAN}End timestamp (e.g. 00:02:45):{Style.RESET} ", end="", flush=True)
    end = input().strip()

    if not start or not end:
        return
    out = f"trimmed_{vid}"
    cmd = ["ffmpeg", "-y", "-ss", start, "-to", end, "-i", vid, "-c", "copy", out]
    log_info(f"Trimming lossless stream: {vid} -> {out}...")
    subprocess.run(cmd)
    log_success(f"Saved: {out}")


def builtin_make_gif():
    vids = [f.name for f in Path.cwd().iterdir() if f.suffix.lower() in [".mp4", ".mkv", ".webm", ".mov"]]
    if not vids:
        log_warn("No video files in current directory.")
        return

    sel = run_fzf(vids, prompt="Select video for GIF > ")
    if not sel:
        return
    vid = sel[0]
    out = f"{Path(vid).stem}.gif"

    cmd = [
        "ffmpeg", "-y", "-i", vid,
        "-vf", "fps=15,scale=640:-1:flags=lanczos,split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse",
        "-loop", "0", out,
    ]
    log_info(f"Generating palette-optimized GIF: {out}...")
    subprocess.run(cmd)
    log_success(f"Generated: {out}")


def builtin_pw_devices():
    res = subprocess.run(["wpctl", "status"], capture_output=True, text=True)
    if res.returncode != 0:
        log_error("WirePlumber not running.")
        return

    lines = res.stdout.splitlines()
    sinks = []
    in_sinks = False
    for line in lines:
        if "Sinks:" in line:
            in_sinks = True
            continue
        if in_sinks:
            if "Sources:" in line or "Filters:" in line or not line.strip():
                break
            match = re.search(r"(\*?)\s*(\d+)\.\s+(.*)", line)
            if match:
                is_curr, node_id, desc = match.groups()
                cur_tag = f"{Style.GREEN}[ACTIVE]{Style.RESET} " if is_curr else "         "
                sinks.append(f"{node_id}\t{cur_tag}{desc.strip()}")

    if not sinks:
        log_warn("No audio sinks detected.")
        return

    sel = run_fzf(sinks, prompt="Switch Default Audio Output > ", extra_args=["--delimiter=\t", "--with-nth=2"])
    if not sel:
        return
    chosen_id = sel[0].split("\t")[0]
    subprocess.run(["wpctl", "set-default", chosen_id], check=False)
    log_success(f"Default audio sink set to node {chosen_id}")


