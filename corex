                branch_cells.append((iy, ix, ch, c_bark))

    seen_foliage = set()
    for px, py, rx, ry in pads:
        for dy in range(-ry, ry + 1):
            for dx in range(-rx, rx + 1):
                if (dx / float(rx))**2 + (dy / float(ry))**2 <= 1.0:
                    if random.random() < 0.62:
                        gy, gx = int(round(py + dy)), int(round(px + dx))
                        if 0 <= gy < pot_y - 1 and 0 <= gx < width and (gy, gx) not in seen_foliage:
                            seen_foliage.add((gy, gx))
                            c = random.choice(v_info["leaf_colors"])
                            glyph = random.choice(v_info["leaf_glyphs"])
                            foliage_cells.append((gy, gx, glyph, c))
    random.shuffle(foliage_cells)

    for _ in range(12):
        fx = random.randint(int(split_x - 20), int(split_x + 20))
        fy = random.randint(int(split_y + 1), pot_y)
        if 0 <= fy < pot_y and 0 <= fx < width:
            c = random.choice(v_info["leaf_colors"])
            glyph = random.choice(v_info["falling_glyphs"])
            petal_cells.append((fy, fx, glyph, c))

    total_foliage = len(foliage_cells)

    # Static Mode (Direct print without clearing or cursor loop)
    if selected_dur <= 0.0 or not sys.stdout.isatty():
        for line in header_lines:
            sys.stdout.write(line)
        grid = [[" " for _ in range(width)] for _ in range(height)]
        cols = [["" for _ in range(width)] for _ in range(height)]
        for group in (ground_cells, pot_cells, trunk_cells, branch_cells, foliage_cells, petal_cells):
            for iy, ix, ch, col in group:
                if 0 <= iy < height and 0 <= ix < width:
                    grid[iy][ix] = ch
                    cols[iy][ix] = col
        for r in range(height):
            row = "".join(cols[r][c] + grid[r][c] for c in range(width))
            print("  " + row + rst)
        bar = f"{accent_col}{'█' * 26}{rst}"
        print(f"\n   {v_info['icon']} {bld}{v_info['name']}:{rst} [{bar}] 100% • {accent_col}✔ Bloom Complete!{rst} ({total_foliage} nodes in full splendor)\n")
        return

    # Live Ambient Growth Mode
    sys.stdout.write("\033[2J\033[H\033[?25l")  # Clear screen and hide cursor
    sys.stdout.flush()

    if selected_dur <= 10.0:
        refresh_delay = 0.1
    elif selected_dur <= 60.0:
        refresh_delay = 0.25
    else:
        refresh_delay = 0.5

    t_start = time.time()
    paused = False
    pause_start = 0.0
    total_paused_time = 0.0
    ambient_mode = False
    last_breeze_time = 0.0
    active_petals = list(petal_cells)

    try:
        while True:
            key = _read_char_nb(0.08)
            if key:
                if key in ("q", "Q"):
                    if not ambient_mode:
                        ambient_mode = True
                    else:
                        break
                elif key in ("\x1b",):
                    break
                elif key in (" ", "p", "P"):
                    if not ambient_mode:
                        paused = not paused
                        if paused:
                            pause_start = time.time()
                        else:
                            total_paused_time += (time.time() - pause_start)

            if paused:
                time.sleep(0.15)
                continue

            now = time.time()
            elapsed = (now - t_start) - total_paused_time
            if not ambient_mode and elapsed >= selected_dur:
                ambient_mode = True

            progress = 1.0 if ambient_mode else min(1.0, elapsed / max(0.001, selected_dur))
            pct = int(progress * 100)

            # Build grid for current frame
            grid = [[" " for _ in range(width)] for _ in range(height)]
            cols = [["" for _ in range(width)] for _ in range(height)]

            # 1. Ground & Pot (0% - 15%)
            g_slice = int(len(ground_cells) * min(1.0, progress / 0.10))
            for y, x, ch, col in ground_cells[:g_slice]:
                grid[y][x], cols[y][x] = ch, col
            p_slice = int(len(pot_cells) * min(1.0, progress / 0.15))
            for y, x, ch, col in pot_cells[:p_slice]:
                grid[y][x], cols[y][x] = ch, col

            # 2. Trunk & Roots (12% - 40%)
            t_prog = max(0.0, min(1.0, (progress - 0.12) / 0.28))
            t_slice = int(len(trunk_cells) * t_prog)
            for y, x, ch, col in trunk_cells[:t_slice]:
                grid[y][x], cols[y][x] = ch, col

            # 3. Branches (30% - 65%)
            b_prog = max(0.0, min(1.0, (progress - 0.30) / 0.35))
            b_slice = int(len(branch_cells) * b_prog)
            for y, x, ch, col in branch_cells[:b_slice]:
                grid[y][x], cols[y][x] = ch, col

            # 4. Foliage Bloom (55% - 92%)
            f_prog = max(0.0, min(1.0, (progress - 0.55) / 0.37))
            f_slice = int(len(foliage_cells) * f_prog)
            for i, (y, x, glyph, col) in enumerate(foliage_cells[:f_slice]):
                if f_prog < 0.85 and i > f_slice * 0.7:
                    grid[y][x], cols[y][x] = "·", col
                else:
                    grid[y][x], cols[y][x] = glyph, col

            # 5. Petals
            if ambient_mode:
                if now - last_breeze_time > 3.0:
                    last_breeze_time = now
                    active_petals = []
                    for _ in range(random.randint(6, 12)):
                        fx = random.randint(max(1, int(split_x - 20)), min(width - 2, int(split_x + 20)))
                        fy = random.randint(max(1, int(split_y + 1)), pot_y)
                        if grid[fy][fx] == " ":
                            active_petals.append((fy, fx, random.choice(v_info["falling_glyphs"]), random.choice(v_info["leaf_colors"])))
                for y, x, ch, col in active_petals:
                    if 0 <= y < height and 0 <= x < width and grid[y][x] == " ":
                        grid[y][x], cols[y][x] = ch, col
            else:
                pt_prog = max(0.0, min(1.0, (progress - 0.80) / 0.20))
                pt_slice = int(len(petal_cells) * pt_prog)
                for y, x, ch, col in petal_cells[:pt_slice]:
                    if 0 <= y < height and 0 <= x < width and grid[y][x] == " ":
                        grid[y][x], cols[y][x] = ch, col

            # Frame buffer rendering via Cursor Home \033[H
            frame_buffer = ["\033[H"]
            frame_buffer.extend(header_lines)
            for r in range(height):
                row_str = "".join(cols[r][c] + grid[r][c] for c in range(width))
                frame_buffer.append("  " + row_str + f"{rst}\033[K\n")

            bar_len = 24
            filled = int(progress * bar_len)
            bar_str = f"{accent_col}{'█' * filled}{dim}{'░' * (bar_len - filled)}{rst}"

            rem_sec = max(0.0, selected_dur - elapsed)
            if selected_dur >= 3600.0:
                rh = int(rem_sec) // 3600
                rm = (int(rem_sec) % 3600) // 60
                rs = int(rem_sec) % 60
                t_str = f"{rh:02d}:{rm:02d}:{rs:02d}"
            elif selected_dur >= 60.0:
                rm = int(rem_sec) // 60
                rs = int(rem_sec) % 60
                t_str = f"{rm:02d}:{rs:02d}"
            else:
                t_str = f"{rem_sec:4.1f}s"

            if not ambient_mode:
                status_str = f"   {v_info['icon']} {bld}Living Ambient:{rst} [{bar_str}] {pct:>3}% • {accent_col}{t_str} remaining{rst} • {f_slice} buds • {dim}[Q] Finish  [Space] Pause{rst}\033[K"
            else:
                status_str = f"   {v_info['icon']} {bld}{v_info['title']}:{rst} [{accent_col}{'█' * bar_len}{rst}] 100% • {accent_col}✔ Full Bloom • Ambient Mode{rst} • {dim}[Q/Esc] Exit{rst}\033[K"

            frame_buffer.append(status_str + "\n\033[J")
            sys.stdout.write("".join(frame_buffer))
            sys.stdout.flush()

            time.sleep(refresh_delay)

    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write("\033[?25h\n")
        sys.stdout.flush()
        print(f"   {dim}🌿 Zen Garden resting peacefully.{rst}\n")

def _fmt_bytes(b: float) -> str:
    for unit in ["B", "KiB", "MiB", "GiB", "TiB"]:
        if abs(b) < 1024.0:
            return f"{b:3.1f} {unit}"
        b /= 1024.0
    return f"{b:.1f} PiB"


def builtin_share(target: Optional[str] = None, extra_args: Optional[List[str]] = None):
    args = extra_args or []
    all_args = ([target] if target else []) + args

    file_to_upload = None
    text_content = None

    if not sys.stdin.isatty():
        try:
            text_content = sys.stdin.read()
        except Exception:
            pass

    if not text_content and all_args:
        cand = all_args[0]
        p = Path(cand)
        if p.is_file():
            file_to_upload = p
        else:
            text_content = " ".join(all_args)

    if not file_to_upload and not text_content:
        print(f"{Style.RED}✖ Error: No file or text provided to share.{Style.RESET}")
        print(f"  Usage: cx share <file> | cx share \"text snippet\" | cat file | cx share")
        return

    print(box_header("COREX EPHEMERAL SECURE SHARE"))

    url = None
    service_name = None
    tmp_file = None

    try:
        if file_to_upload:
            upload_path = file_to_upload
            size_str = _fmt_bytes(upload_path.stat().st_size) if hasattr(upload_path.stat(), "st_size") else "N/A"
            filename = upload_path.name
        else:
            tmp_dir = Path("/tmp/corex_share")
            tmp_dir.mkdir(parents=True, exist_ok=True)
            tmp_file = tmp_dir / f"snippet_{int(time.time())}.txt"
            tmp_file.write_text(text_content, encoding="utf-8")
            upload_path = tmp_file
            size_str = _fmt_bytes(len(text_content.encode("utf-8")))
            filename = tmp_file.name

        print(f" {Style.BOLD}Target:{Style.RESET}   {filename} ({size_str})")
        print(f" {Style.BOLD}Status:{Style.RESET}   Uploading...", end="", flush=True)

        try:
            res = subprocess.run(
                ["curl", "-s", "-F", f"file=@{upload_path}", "https://temp.sh/upload"],
                capture_output=True, text=True, timeout=20
            )
            if res.returncode == 0 and res.stdout.strip().startswith("http"):
                url = res.stdout.strip()
                service_name = "temp.sh"
        except Exception:
            pass

        if not url:
            try:
                res = subprocess.run(
                    ["curl", "-s", "-F", "reqtype=fileupload", "-F", f"fileToUpload=@{upload_path}", "https://catbox.moe/user/api.php"],
                    capture_output=True, text=True, timeout=20
                )
                if res.returncode == 0 and res.stdout.strip().startswith("http"):
                    url = res.stdout.strip()
                    service_name = "catbox.moe"
            except Exception:
                pass

        if not url:
            print(f"\r {Style.BOLD}Status:{Style.RESET}   {Style.RED}✖ Failed to upload to sharing services.{Style.RESET}")
            print(box_footer())
            return

        print(f"\r {Style.BOLD}Status:{Style.RESET}   {Style.GREEN}✔ Upload Successful!{Style.RESET}  (Host: {service_name})")
        print(f" {Style.BOLD}Link:{Style.RESET}     {Style.CYAN}{Style.BOLD}{url}{Style.RESET}")

        copied = False
        if shutil.which("wl-copy"):
            subprocess.run(["wl-copy"], input=url.encode(), check=False)
            copied = True
        elif shutil.which("xclip"):
            subprocess.run(["xclip", "-selection", "clipboard"], input=url.encode(), check=False)
            copied = True
        elif shutil.which("xsel"):
            subprocess.run(["xsel", "-b"], input=url.encode(), check=False)
            copied = True

        if copied:
            print(f" {Style.BOLD}Buffer:{Style.RESET}   {Style.GREEN}✔ Copied link to system clipboard!{Style.RESET}")
        else:
            print(f" {Style.BOLD}Buffer:{Style.RESET}   {Style.DIM}(Clipboard tool not found: install wl-copy or xclip){Style.RESET}")

    finally:
        if tmp_file and tmp_file.exists():
            try:
                tmp_file.unlink()
            except Exception:
                pass

    print(box_footer())


def builtin_disks(extra_args: Optional[List[str]] = None):
    print(box_header("STORAGE & PARTITION TELEMETRY"))

    mounts = []
    seen_dev_mnts = set()

    try:
        res = subprocess.run(["df", "-h", "-T", "-P"], capture_output=True, text=True, timeout=3)
        lines = res.stdout.strip().splitlines()
        if len(lines) > 1:
            for line in lines[1:]:
                parts = line.split()
                if len(parts) >= 7:
                    dev, fstype, size, used, avail, use_pct, mnt = parts[0], parts[1], parts[2], parts[3], parts[4], parts[5], parts[6]
                    if fstype in ("tmpfs", "devtmpfs", "squashfs", "overlay", "efivarfs", "cgroup"):
                        continue
                    if not dev.startswith("/dev/"):
                        continue
                    # Keep /, /home, /boot, and avoid duplicate subvolumes like /srv, /var/log for the same dev
                    if dev in seen_dev_mnts and mnt not in ("/", "/home", "/boot") and not mnt.startswith(("/mnt", "/media", "/run/media")):
                        continue
                    seen_dev_mnts.add(dev)
                    mounts.append({
                        "dev": dev,
                        "fs": fstype,
                        "size": size,
                        "used": used,
                        "avail": avail,
                        "pct": int(use_pct.rstrip("%")),
                        "mnt": mnt
                    })
    except Exception as e:
        log_error(f"Failed to query filesystem stats: {e}")
        return

    def _mnt_key(m):
        if m["mnt"] == "/": return 0
        if m["mnt"] == "/home": return 1
        if m["mnt"].startswith("/boot"): return 2
        return 10
    mounts.sort(key=_mnt_key)

    bar_len = 18
    print(f" {Style.BOLD}{'MOUNT':<14} {'DEVICE':<16} {'FS':<7} {'SIZE':<8} {'USED':<8} {'AVAIL':<8} {'CAPACITY'}{Style.RESET}")
    print(f" {Style.DARK_GRAY}{'─' * 76}{Style.RESET}")

    for m in mounts:
        pct = m["pct"]
        filled = int((pct / 100.0) * bar_len)
        empty = bar_len - filled

        if pct >= 85:
            bar_col = Style.RED
        elif pct >= 70:
            bar_col = Style.YELLOW
        else:
            bar_col = Style.GREEN

        bar_str = f"{bar_col}{'█' * filled}{Style.DARK_GRAY}{'░' * empty}{Style.RESET}"
        print(f" {Style.CYAN}{m['mnt']:<14}{Style.RESET} {m['dev']:<16} {m['fs']:<7} {m['size']:<8} {m['used']:<8} {m['avail']:<8} [{bar_str}] {bar_col}{pct:>3}%{Style.RESET}")

    cwd = Path.cwd()
    print(f"\n {Style.BOLD}Working Directory:{Style.RESET} {Style.CYAN}{cwd}{Style.RESET}")
    try:
        cwd_usage = shutil.disk_usage(cwd)
        cwd_pct = int((cwd_usage.used / cwd_usage.total) * 100)
        print(f"  {Style.DIM}Partition Capacity: {_fmt_bytes(cwd_usage.used)} used / {_fmt_bytes(cwd_usage.total)} total ({cwd_pct}%){Style.RESET}")
    except Exception:
        pass

    try:
        top_items = []
        for item in cwd.iterdir():
            try:
                if item.is_file() and not item.name.startswith("."):
                    top_items.append((item.stat().st_size, item.name))
            except Exception:
                pass
        top_items.sort(reverse=True)
        if top_items:
            print(f"\n {Style.BOLD}Largest Files In Current Directory:{Style.RESET}")
            for sz, name in top_items[:5]:
                print(f"  • {_fmt_bytes(sz):<10} {name}")
    except Exception:
        pass

    print(box_footer())


def builtin_audio_test(extra_args: Optional[List[str]] = None):
    import wave, struct, math
    print(box_header("COREX SPATIAL STEREO AUDIO VERIFICATION"))

    player = None
    for p in ("pw-play", "paplay", "aplay"):
        if shutil.which(p):
            player = p
            break

    if not player:
        print(f" {Style.RED}✖ Error: No audio player found (pw-play, paplay, or aplay required).{Style.RESET}")
        print(box_footer())
        return

    server = "PipeWire" if shutil.which("pw-cli") else ("PulseAudio" if shutil.which("pactl") else "ALSA")
    print(f" {Style.BOLD}Audio Subsystem:{Style.RESET} {Style.GREEN}{server}{Style.RESET}  (Engine: {player})")

    sink_info = "Default Stereo Sink"
    try:
        res = subprocess.run(["pactl", "get-default-sink"], capture_output=True, text=True, timeout=1.5)
        if res.returncode == 0 and res.stdout.strip():
            sink_info = res.stdout.strip()
    except Exception:
        pass
    print(f" {Style.BOLD}Output Device:{Style.RESET}   {Style.CYAN}{sink_info}{Style.RESET}")
    print(f" {Style.DARK_GRAY}{'─' * 66}{Style.RESET}\n")

    tmp_dir = Path("/tmp/corex_audiotest")
    tmp_dir.mkdir(parents=True, exist_ok=True)
    f_left = tmp_dir / "left.wav"
    f_right = tmp_dir / "right.wav"
    f_center = tmp_dir / "center.wav"

    def _create_wav(path, freq, dur=0.55, ch="both"):
        sr = 44100
        n_samples = int(sr * dur)
        with wave.open(str(path), "wb") as w:
            w.setnchannels(2)
            w.setsampwidth(2)
            w.setframerate(sr)
            buf = bytearray()
            for i in range(n_samples):
                t = float(i) / sr
                env = 0.5 * (1.0 - math.cos(2.0 * math.pi * i / n_samples))
                val = int(env * 16000.0 * math.sin(2.0 * math.pi * freq * t))
                l = val if ch in ("left", "both") else 0
                r = val if ch in ("right", "both") else 0
                buf.extend(struct.pack("<hh", l, r))
            w.writeframes(buf)

    _create_wav(f_left, 440.0, 0.55, "left")
    _create_wav(f_right, 880.0, 0.55, "right")
    _create_wav(f_center, 587.33, 0.70, "both")

    try:
        print(f"  {Style.CYAN}{Style.BOLD}◄◄ [ LEFT CHANNEL: 440 Hz (A4) ]{Style.RESET}                  ", end="", flush=True)
        subprocess.run([player, str(f_left)], capture_output=True)
        print(f"{Style.GREEN}✔ OK{Style.RESET}")
        time.sleep(0.3)

        print(f"                     {Style.MAGENTA}{Style.BOLD}[ RIGHT CHANNEL: 880 Hz (A5) ] ►►{Style.RESET}  ", end="", flush=True)
        subprocess.run([player, str(f_right)], capture_output=True)
        print(f"{Style.GREEN}✔ OK{Style.RESET}")
        time.sleep(0.3)

        print(f"        {Style.YELLOW}{Style.BOLD}◄◄◄ [ STEREO CENTER HARMONIC ] ►►►{Style.RESET}        ", end="", flush=True)
        subprocess.run([player, str(f_center)], capture_output=True)
        print(f"{Style.GREEN}✔ OK{Style.RESET}")

        print(f"\n {Style.GREEN}✔ Spatial stereo channel test completed successfully.{Style.RESET}")
    except Exception as e:
        print(f"\n {Style.RED}✖ Audio test interrupted: {e}{Style.RESET}")
    finally:
        for f in (f_left, f_right, f_center):
            if f.exists():
                try: f.unlink()
                except Exception: pass

    print(box_footer())


def builtin_sensors(extra_args: Optional[List[str]] = None):
    args = extra_args or []
    watch = any(a in args for a in ("-w", "--watch", "watch"))

    def _render_frame():
        lines = []
        lines.append(box_header("HARDWARE THERMAL & FAN SENSOR TELEMETRY"))

        cpu_items = []
        for p in sorted(Path("/sys/class/hwmon").glob("hwmon*")):
            name = (p / "name").read_text().strip() if (p / "name").exists() else ""
            if name in ("coretemp", "k10temp", "zenpower", "acpitz"):
                for f in sorted(p.glob("temp*_input")):
                    idx = f.name.replace("temp", "").replace("_input", "")
                    lbl_file = p / f"temp{idx}_label"
                    lbl = lbl_file.read_text().strip() if lbl_file.exists() else f"Sensor {idx}"
                    try:
                        val = int(f.read_text().strip()) / 1000.0
                        cpu_items.append((lbl, val))
                    except Exception:
                        pass

        if cpu_items:
            lines.append(f" {Style.BOLD}CPU Thermal Zones:{Style.RESET}")
            for lbl, temp in cpu_items[:10]:
                col = Style.RED if temp >= 80 else (Style.YELLOW if temp >= 60 else Style.GREEN)
                bar = "█" * int(temp / 5)
                lines.append(f"  • {lbl:<16} {col}{temp:>5.1f}°C{Style.RESET}  {col}{bar:<20}{Style.RESET}")

        if shutil.which("nvidia-smi"):
            try:
                res = subprocess.run(
                    ["nvidia-smi", "--query-gpu=name,temperature.gpu,fan.speed,power.draw,utilization.gpu", "--format=csv,noheader,nounits"],
                    capture_output=True, text=True, timeout=1.5
                )
                if res.returncode == 0 and res.stdout.strip():
                    parts = [p.strip() for p in res.stdout.strip().split(",")]
                    if len(parts) >= 5:
                        g_name, g_temp, g_fan, g_pow, g_util = parts[0], float(parts[1]), parts[2], parts[3], parts[4]
                        lines.append(f"\n {Style.BOLD}GPU Telemetry ({g_name}):{Style.RESET}")
                        col = Style.RED if g_temp >= 80 else (Style.YELLOW if g_temp >= 60 else Style.GREEN)
                        fan_str = f"{g_fan}%" if g_fan != "[Not Supported]" and g_fan != "N/A" else "Passive/Auto"
                        lines.append(f"  • Temperature:    {col}{g_temp:.1f}°C{Style.RESET}")
                        lines.append(f"  • Fan Speed:      {Style.CYAN}{fan_str}{Style.RESET}")
                        lines.append(f"  • Power Draw:     {Style.YELLOW}{g_pow} W{Style.RESET}")
                        lines.append(f"  • Core Load:      {Style.CYAN}{g_util}%{Style.RESET}")
            except Exception:
                pass

        nvme_items = []
        for p in sorted(Path("/sys/class/hwmon").glob("hwmon*")):
            name = (p / "name").read_text().strip() if (p / "name").exists() else ""
            if "nvme" in name:
                for f in sorted(p.glob("temp*_input")):
                    idx = f.name.replace("temp", "").replace("_input", "")
                    lbl_file = p / f"temp{idx}_label"
                    lbl = lbl_file.read_text().strip() if lbl_file.exists() else f"Sensor {idx}"
                    try:
                        val = int(f.read_text().strip()) / 1000.0
                        nvme_items.append((lbl, val))
                    except Exception:
                        pass

        if nvme_items:
            lines.append(f"\n {Style.BOLD}NVMe Solid-State Storage:{Style.RESET}")
            for lbl, temp in nvme_items[:4]:
                col = Style.RED if temp >= 70 else (Style.YELLOW if temp >= 50 else Style.GREEN)
                lines.append(f"  • {lbl:<16} {col}{temp:>5.1f}°C{Style.RESET}")

        if watch:
            lines.append(f"\n {Style.DIM}Live polling every 1.5s. Press Ctrl+C to exit.{Style.RESET}")
        lines.append(box_footer())
        return "\n".join(lines)

    if not watch:
        print(_render_frame())
    else:
        try:
            while True:
                print("\033[H\033[J" + _render_frame(), end="", flush=True)
                time.sleep(1.5)
        except KeyboardInterrupt:
            print(f"\n{Style.RESET}")


