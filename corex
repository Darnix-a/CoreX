        print(f" {Style.BOLD}Dirty / Writeback:{Style.RESET}   {dirty} MiB / {wb} MiB")
        print(f" {Style.BOLD}Kernel Slab Cache:{Style.RESET}   {slab} MiB (Reclaimable: {s_rec} MiB | Unreclaim: {s_unrec} MiB)")
