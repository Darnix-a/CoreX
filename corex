def get_nvidia_vram() -> Tuple[Optional[int], Optional[int]]:
    if not shutil.which("nvidia-smi"):
        return None, None
    try:
        res = subprocess.run(
            ["nvidia-smi", "--query-gpu=memory.total,memory.free", "--format=csv,noheader,nounits"],
            capture_output=True,
            text=True,
            check=True,
        )
        line = res.stdout.strip().splitlines()[0]
        tot, free = [int(x.strip()) for x in line.split(",")]
        return tot, free
    except Exception:
        return None, None


def builtin_comfy_boot(cfg: CoreXConfig, dry_run: bool = False, extra_args: Optional[List[str]] = None):
    import socket
    log_info("Inspecting ComfyUI workspace environment...")
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.2)
        try:
            s.connect((cfg.comfyui_host, cfg.comfyui_port))
            url = f"http://{cfg.comfyui_host}:{cfg.comfyui_port}"
            log_success(f"ComfyUI is ALREADY ACTIVE on {url}!")
            if not dry_run and cfg.comfyui_auto_browser:
                subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return
        except (ConnectionRefusedError, TimeoutError, OSError):
            pass

    comfy_dir = cfg.comfyui_path
    if not (comfy_dir / "main.py").exists():
        for c in [Path.home() / "ComfyUI", Path.home() / "comfyui", Path.cwd()]:
            if (c / "main.py").exists():
                comfy_dir = c
                break

    if not (comfy_dir / "main.py").exists():
        log_error(f"Could not locate ComfyUI at '{comfy_dir}'. Check ~/.config/corex/config.toml")
        return

    python_bin = sys.executable
    for v in ["venv", ".venv", "env"]:
        p = comfy_dir / v / "bin" / "python"
        if p.exists() and os.access(p, os.X_OK):
            python_bin = str(p)
            break

    total_vram, free_vram = get_nvidia_vram()
    vram_flag = "--normalvram"
    if free_vram is not None and total_vram is not None:
        log_step("GPU VRAM Free", f"{free_vram} MiB / {total_vram} MiB")
        if free_vram >= cfg.vram_high_threshold_mb:
            vram_flag = "--highvram"
        elif free_vram < cfg.vram_low_threshold_mb:
            vram_flag = "--lowvram"
        log_step("Memory Profile", f"{Style.GREEN}{vram_flag}{Style.RESET}")

    env = os.environ.copy()
    env["PYTORCH_CUDA_ALLOC_CONF"] = "expandable_segments:True"

    cmd = [python_bin, "main.py", "--listen", cfg.comfyui_host, "--port", str(cfg.comfyui_port), vram_flag]
    cmd.extend(cfg.comfyui_extra_flags)
    if extra_args:
        cmd.extend(extra_args)

    log_step("Boot Command", " ".join(cmd))
    if dry_run:
        print(f"{Style.YELLOW}[DRY-RUN]{Style.RESET} {' '.join(cmd)} (cwd: {comfy_dir})")
        return

    url = f"http://{cfg.comfyui_host}:{cfg.comfyui_port}"
    if cfg.comfyui_notify and shutil.which("notify-send"):
        subprocess.run(["notify-send", "CoreX AI Launcher", f"Booting ComfyUI on {url}"], check=False)

    if cfg.comfyui_auto_browser:
        subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    log_success(f"Launching ComfyUI server at {url} (Ctrl+C to stop)...")
    subprocess.run(cmd, cwd=comfy_dir, env=env)


