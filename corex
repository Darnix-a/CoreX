def builtin_builder(cfg: CoreXConfig, extra_args: Optional[List[str]] = None):
    """Entrypoint for the In-App Command Builder & Cockpit Studio."""
    args = extra_args or []
    subaction = args[0].lower() if args else None
    target_id = args[1] if len(args) > 1 else None

    try:
        if subaction in ("new", "add", "create"):
            wizard_create_action(cfg, initial_id=target_id)
            return
        elif subaction in ("edit", "modify"):
            wizard_edit_action(cfg, target_id=target_id)
            return
        elif subaction in ("delete", "remove", "rm"):
            wizard_delete_action(cfg, target_id=target_id)
            return
        elif subaction in ("test", "validate", "check"):
            wizard_test_action(cfg, target_id=target_id)
            return

        while True:
            print(f"\n{box_header('COREX COMMAND BUILDER & ACTION STUDIO', color=Style.CYAN)}")
            print(f"  {Style.BOLD}[1]{Style.RESET} ⚡ Create New Action (Step-by-Step Wizard)")
            print(f"  {Style.BOLD}[2]{Style.RESET} ✎  Edit Existing Action")
            print(f"  {Style.BOLD}[3]{Style.RESET} ✖  Delete Action")
            print(f"  {Style.BOLD}[4]{Style.RESET} ◈  Test & Validate Action Syntax")
            print(f"  {Style.BOLD}[5]{Style.RESET} ⏻  Exit Studio")
            print(box_footer(color=Style.CYAN))

            choice = prompt_user("Select an option [1-5, default: 1]: ", default="1").strip()
            if choice == "1":
                wizard_create_action(cfg)
            elif choice == "2":
                wizard_edit_action(cfg)
            elif choice == "3":
                wizard_delete_action(cfg)
            elif choice == "4":
                wizard_test_action(cfg)
            elif choice in ("5", "q", "quit", "exit"):
                break
            else:
                log_warn("Invalid option.")
    except KeyboardInterrupt:
        print(f"\n{Style.GRAY}Action builder session ended.{Style.RESET}")


