def run_two_tier_menu(cfg: CoreXConfig, dry_run: bool = False):
    categories = [
        "1. [AI, CUDA & Deep Learning]              (12 commands)",
        "2. [Media, Audio & PipeWire Power-Tools]     (13 commands)",
        "3. [Gaming, Hardware & Display Orchestration] (8 commands)",
        "4. [System Architecture & BTRFS Snapshotting] (9 commands)",
        "5. [Network, VPN & Remote Infrastructure]    (9 commands)",
        "6. [Git, Dev & Code Utilities]               (9 commands)",
        "7. [Daily Driver Quality-of-Life & Crypto/Files] (15 commands)",
        "★  [All Commands (Global Search)]            (75 commands)",
    ]

    cat_map = {
        "1": "AI, CUDA & Deep Learning",
        "2": "Media, Audio & PipeWire Power-Tools",
        "3": "Gaming, Hardware & Display Orchestration",
        "4": "System Architecture & BTRFS Snapshotting",
        "5": "Network, VPN & Remote Infrastructure",
        "6": "Git, Dev & Code Utilities",
        "7": "Daily Driver Quality-of-Life & Crypto/Files",
    }

    self_exe = os.path.abspath(sys.argv[0])

    # Tier 1: Category Selection
    tier1_header = "MISSION CONTROL TIER 1: Select Category | ESC to exit"
    tier1_sel = run_fzf(categories, prompt="Category > ", header=tier1_header)
    if not tier1_sel:
        return

    chosen_cat_line = tier1_sel[0]
    matched_cat = None
    for k, v in cat_map.items():
        if chosen_cat_line.startswith(k):
            matched_cat = v
            break

    # Tier 2: Filter commands
    if matched_cat:
        target_cmds = [c for c in cfg.commands.values() if c.category == matched_cat]
        t2_prompt = f"{matched_cat[:18]} > "
    else:
        target_cmds = list(cfg.commands.values())
        t2_prompt = "all-commands > "

    t2_items = []
    for c in target_cmds:
        # Check deps status badge
        has_missing = any(not shutil.which(d) for d in c.deps)
        badge = f"{Style.RED}[DEP MISSING]{Style.RESET}" if has_missing else f"{Style.GREEN}[READY]{Style.RESET}"
        if c.requires_sudo:
            badge += f" {Style.YELLOW}[SUDO]{Style.RESET}"
        t2_items.append(f"{c.id}\t{Style.CYAN}{c.id:<18}{Style.RESET}\t{c.description}\t{badge}")

    preview_call = f"python3 '{self_exe}' __preview {{1}}"
    extra = [
        "--delimiter=\t",
        "--with-nth=2,3,4",
        "--header=TIER 2: Select Action | ENTER to run | ESC to return",
    ]

    t2_sel = run_fzf(t2_items, prompt=t2_prompt, preview_cmd=preview_call, extra_args=extra)
    if not t2_sel:
        # User cancelled Tier 2, return to Tier 1 loop or exit
        return

    chosen_cmd_id = t2_sel[0].split("\t")[0].strip()
    execute_command(chosen_cmd_id, cfg, dry_run=dry_run)


