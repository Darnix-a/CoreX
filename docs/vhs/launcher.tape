# VHS tape for CoreX Interactive Launcher
Output docs/vhs/launcher.gif

Set Shell "bash"
Set FontSize 16
Set Width 1200
Set Height 750
Set Theme "Catppuccin Mocha"
Set Padding 20

Type "cx"
Sleep 500ms
Enter
Sleep 1.5s

# Filter by category
Type "@gpu"
Sleep 1.5s

Backspace 4
Type "@ai"
Sleep 1.5s

Down 2
Sleep 1s
Down 2
Sleep 1.5s

Escape
Sleep 500ms
