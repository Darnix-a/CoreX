        '(-h --help)'{-h,--help}'[Show help]' \
        '(-v --version)'{-v,--version}'[Show version]' \
        '--dry-run[Preview commands]' \
        '--bg[Detach command in background]' \
        '--pinned[List pinned favorites]' \
        '--list[List all commands]' \
        '1: :->command' \
        '*:: :->args'
    case $state in
        command) _describe -t commands 'cx commands' commands ;;
    esac
}
_cx "$@"
