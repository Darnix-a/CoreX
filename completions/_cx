#compdef cx corex
_cx() {
    local -a commands
    commands=(
        'comfy-boot:Detect venv, check port 8188, apply CUDA alloc flags, launch ComfyUI & notify'
        'comfy-nuke:Force kill any zombie ComfyUI server and associated Python/Torch memory holders'
        'comfy-sync:Parallel git-pull across ComfyUI core and all cloned custom_nodes directories'
        'model-symlink:Interactive fzf picker to symlink any .safetensors file into target ComfyUI model folder'
        'ollama-up:Start the Ollama background inference daemon if stopped'
        'ollama-ps:Display currently loaded models in GPU memory with context memory footprint'
        'ollama-drop:Unload all active LLMs from VRAM immediately'
        'ollama-fzf:Interactive fzf selector to run or chat with any locally pulled model'
        'hf-download:Fast model puller from HuggingFace via aria2c multithreaded resume'
        'civit-grab:Download model/LoRA from Civitai API key/URL with SHA256 verification'
        'vram-watch:Loop nvidia-smi showing per-process memory, power draw, and temperature at 1000ms'
        'cuda-purge:Scan specifically for orphaned Python processes holding /dev/nvidia* file handles and terminate them'
        'stream-yt:Interactive YouTube fuzzy search via yt-dlp metadata streaming directly into mpv --no-video'
        'stream-video:Search YouTube and stream hardware-accelerated 1440p/4K video directly into borderless mpv'
        'stream-radio:Background endless ambient/lo-fi/synthwave stream player with minimal CPU footprint'
        'rip-flac:Batch-convert video or audio files in current directory to uncompressed 24-bit FLAC'
        'rip-opus:Fast high-efficiency audio compression to Opus at 160kbps'
        'trim-video:Interactive lossless video cutter via ffmpeg stream copy (start, end timestamps without re-encoding)'
        'make-gif:High-fidelity palettegen GIF converter from any video segment'
        'demucs-stems:Demix any audio track in cwd into 4 isolated stems (vocals, drums, bass, other) via local Demucs CLI'
        'pw-restart:One-key reboot of PipeWire, WirePlumber, and pipewire-pulse daemons'
        'pw-devices:Interactive fzf picker to switch default audio output sink on the fly'
        'pw-volume:Interactive CLI volume fader for master audio channel'
        'tag-editor:Fast CLI audio metadata editor/inspector via ffprobe'
        'cover-extract:Extract embedded album art from FLAC/MP3 files into cover.jpg'
        'gpu-clock:Toggle GPU power limit or persistence mode for maximum sustained clocks'
        'cpu-gov:Interactive picker for CPU governors (performance, powersave, schedutil)'
        'cpu-turboboost:Toggle Intel/AMD Turbo Boost state on/off'
        'mon-res:Toggle primary monitor refresh rates (e.g., 360Hz / 240Hz / 144Hz) via compositor'
        'mon-dual:Set dual-monitor arrangement preset'
        'mon-single:Disable secondary monitor and enforce max refresh rate on primary display'
        'sens-watch:Clean ANSI visual dashboard for NVMe, GPU hotspot, and CPU per-core temperatures'
        'game-mode:Kill non-essential background daemons, switch CPU to performance, and enable GameMode'
        'snap-now:Prompt for a quick snapshot comment and trigger an instant Snapper/BTRFS root snapshot'
        'snap-fzf:Interactive browser of past snapshots with rollback commands and file diff preview'
        'snap-clean:Prune old or orphaned system snapshots'
        'fkill:Interactive multi-select process terminator with live CPU/RAM previews'
        'disk-space:Interactive visual disk usage explorer via ncdu or dust'
        'pkg-orphans:Scan and remove unneeded package dependencies and clean package cache'
        'service-fail:List all failed systemd system and user services (systemctl --failed)'
        'journal-vacuum:Trim systemd logs to under 200MB'
        'boot-analyze:Profile kernel and userspace boot duration via systemd-analyze blame'
        'my-ip:Detailed ANSI card showing Public IP, Local IP, Gateway, ISP, and Geo-coordinates'
        'vpn-up:Interactive fzf selector for WireGuard/OpenVPN/Proton configuration profiles'
        'vpn-down:Clean disconnect and DNS leak prevention restore'
        'port-audit:Interactive open-port inspector (ss -tulpn) showing PID/service and one-key process kill'
        'speed-check:Fast network speed and latency test'
        'lan-scan:ARP scan local subnet to list active devices, IP addresses, and MAC vendors'
        'ssh-fzf:Interactive fuzzy selector pulling hosts from ~/.ssh/config for one-key remote connection'
        'serve-dir:Spin up an instant ad-hoc Python HTTP file server in cwd and show a scannable QR code'
        'dns-flush:Flush local systemd-resolved DNS cache'
        'git-branch-fzf:Interactive fuzzy Git branch switcher with preview of latest commit log'
        'git-squash:Interactive commit squasher combining last N commits into one'
        'git-stash-pop:Fuzzy browse stashes with diff preview and apply'
        'git-clean-branches:Prune local branches already merged into default branch'
        'docker-fzf:Multi-select Docker container manager (start, stop, logs, restart)'
        'docker-prune:Clean all dangling Docker images, volumes, and networks'
        'venv-init:One-key .venv creation, activation, and pip update in cwd'
        'cheat:Interactive programming cheatsheet lookup via cht.sh/<lang>/<query>'
        'hex-view:Quick terminal hex dump inspection of any binary file'
        'clip-hist:Fuzzy search clipboard history and copy selection to active buffer'
        'qr-gen:Generate terminal ANSI QR code from any string or file path'
        'qr-read:Scan QR code from screen capture or image file'
        'tar-pack:Interactive archive creator (tar.gz, tar.zst, zip) with progress'
        'tar-unpack:Extract any compressed archive automatically detecting format'
        'hash-check:Calculate and compare MD5/SHA256 checksums interactively'
        'weather:Minimalist ANSI terminal weather forecast for current location (wttr.in/?0)'
        'calc:Fast mathematical evaluator supporting basic arithmetic, roots, and trigonometry'
        'timer:Countdown timer with terminal progress bar and desktop audio chime on completion'
        'stopwatch:Precision terminal stopwatch with split times'
        'notes:Instant markdown scratchpad opened in $EDITOR saved with timestamp to ~/.local/share/corex/notes/'
        'todo:Minimalist CLI task tracker with fuzzy completion checklist'
        'url-short:Generate a quick shortened URL from clipboard'
        'trash-empty:Display size of trash directory and perform safe wipe'
        'sys-info:Pristine, customized minimalist hardware/OS summary card without bloated screenfetch ASCII'
    )
    _arguments -C \
        '(-h --help)'{-h,--help}'[Show help]' \
        '(-v --version)'{-v,--version}'[Show version]' \
        '--dry-run[Preview commands]' \
        '--list[List all commands]' \
        '1: :->command' \
        '*:: :->args'
    case $state in
        command) _describe -t commands 'cx commands' commands ;;
    esac
}
_cx "$@"
